{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research300-reference-requests.schema.json",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "states": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "state": {
            "type": "integer",
            "minimum": 1
          },
          "model": {
            "type": "string",
            "pattern": "^(?!.*(?:\\\\|:|%|[\\u0000-\\u001f]))(?!/)(?!.*(?:^|/)\\.)[^/]+(?:/[^/]+)*$"
          },
          "quantities": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "selection": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "enum": [
                        "case",
                        "combination"
                      ]
                    },
                    "id": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "kind",
                    "id"
                  ],
                  "additionalProperties": false
                },
                "location": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "const": "node"
                        },
                        "id": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "kind",
                        "id"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "const": "member"
                        },
                        "id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "positionM": {
                          "type": "number",
                          "minimum": 0
                        },
                        "side": {
                          "enum": [
                            "left",
                            "right"
                          ]
                        }
                      },
                      "required": [
                        "kind",
                        "id",
                        "positionM",
                        "side"
                      ],
                      "additionalProperties": false
                    }
                  ]
                },
                "component": {
                  "enum": [
                    "ux",
                    "uy",
                    "uz",
                    "rx",
                    "ry",
                    "rz",
                    "Fx",
                    "Fy",
                    "Fz",
                    "Mx",
                    "My",
                    "Mz",
                    "N",
                    "V2",
                    "V3",
                    "T",
                    "M2",
                    "M3"
                  ]
                },
                "unit": {
                  "enum": [
                    "m",
                    "mm",
                    "rad",
                    "kN",
                    "N",
                    "kN.m",
                    "N.m",
                    "kN*m",
                    "N*m",
                    "kN·m"
                  ]
                },
                "tolerance": {
                  "type": "object",
                  "properties": {
                    "absolute": {
                      "type": "number",
                      "minimum": 0
                    },
                    "relative": {
                      "type": "number",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "absolute",
                    "relative"
                  ],
                  "additionalProperties": false
                },
                "toleranceJustification": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "id",
                "selection",
                "location",
                "component",
                "unit",
                "tolerance"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          },
          "derived": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "operation": {
                  "enum": [
                    "difference",
                    "sum",
                    "max",
                    "min",
                    "max_abs"
                  ]
                },
                "operands": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1,
                  "uniqueItems": true
                },
                "unit": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "tiePolicy": {
                  "description": "Extrema report tie handling: first (default) requires canonical first co-governor; any permits a signed, correctly identified co-governor. Physical comparison tolerances remain frozen.",
                  "enum": [
                    "first",
                    "any"
                  ]
                },
                "tolerance": {
                  "type": "object",
                  "properties": {
                    "absolute": {
                      "type": "number",
                      "minimum": 0
                    },
                    "relative": {
                      "type": "number",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "absolute",
                    "relative"
                  ],
                  "additionalProperties": false
                },
                "toleranceJustification": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "id",
                "operation",
                "operands",
                "unit",
                "description"
              ],
              "additionalProperties": false,
              "anyOf": [
                {
                  "properties": {
                    "operation": {
                      "enum": [
                        "max",
                        "min",
                        "max_abs"
                      ]
                    }
                  }
                },
                {
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "operation": {
                      "enum": [
                        "difference",
                        "sum"
                      ]
                    },
                    "operands": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "minItems": 1,
                      "uniqueItems": true
                    },
                    "unit": {
                      "type": "string",
                      "minLength": 1
                    },
                    "description": {
                      "type": "string",
                      "minLength": 1
                    },
                    "tolerance": {
                      "type": "object",
                      "properties": {
                        "absolute": {
                          "type": "number",
                          "minimum": 0
                        },
                        "relative": {
                          "type": "number",
                          "minimum": 0
                        }
                      },
                      "required": [
                        "absolute",
                        "relative"
                      ],
                      "additionalProperties": false
                    },
                    "toleranceJustification": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": false
                }
              ]
            },
            "minItems": 0
          }
        },
        "required": [
          "state",
          "model",
          "quantities",
          "derived"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schemaVersion",
    "states"
  ],
  "additionalProperties": false
}
