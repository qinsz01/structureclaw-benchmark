{
  "id": "structureclaw-benchmark",
  "name": "StructureClaw Benchmark Tools",
  "description": "Exposes the current shared StructureClaw engineering tool schemas to OpenClaw.",
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": [
      "detect_structure_type",
      "extract_draft_params",
      "build_model",
      "query_model",
      "review_input",
      "edit_model",
      "undo_model",
      "query_results",
      "validate_model",
      "run_analysis",
      "generate_report",
      "ask_user_clarification",
      "set_session_config",
      "analyze_file"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false
  }
}
