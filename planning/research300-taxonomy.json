{
  "schemaVersion": 1,
  "categories": [
    {
      "key": "std_boundary_connectivity",
      "family": "standard_workflow",
      "zh": "边界与连接语义",
      "en": "Boundary and connectivity semantics",
      "description": "主考点为支座自由度、真实共节点、转角连续/释放、交叉是否连接或梁柱/轴力杆的连接语义；几何外形与构件存在性归几何与拓扑。"
    },
    {
      "key": "std_geometry_topology",
      "family": "standard_workflow",
      "zh": "几何与拓扑建模",
      "en": "Geometry and topology modeling",
      "description": "主考点为跨层网格、非规则外形、实际构件存在性、端点表、外伸/退台及真实偏心几何；已明确的连接自由度不在此重复计数。"
    },
    {
      "key": "std_units_coordinates",
      "family": "standard_workflow",
      "zh": "单位与坐标解释",
      "en": "Units and coordinate interpretation",
      "description": "主考点为字段单位换算、源/全局/局部轴、位置原点、截面朝向或按实际长度定义荷载的坐标解释；单纯不同力值或加载区归荷载与组合。"
    },
    {
      "key": "std_materials_sections",
      "family": "standard_workflow",
      "zh": "材料与截面映射",
      "en": "Material and section assignment",
      "description": "主考点为材料实体属性、截面/刚度分段及按楼层、角色、空间位置分组指派；仅改变局部轴解释的任务归单位与坐标。"
    },
    {
      "key": "std_loads_combinations",
      "family": "standard_workflow",
      "zh": "荷载与工况组合",
      "en": "Loads, cases and combinations",
      "description": "主考点为力/力矩分量、加载位置和区间、面载一次折算、独立工况、带符号荷载及明示组合系数；完整建模仍为共同前提。"
    },
    {
      "key": "std_results_reporting",
      "family": "standard_workflow",
      "zh": "结果查询与报告",
      "en": "Result queries and reporting",
      "description": "以结果交付形式或多种表达的一致性为显式区分点；普通题要求输出位移/反力并不因此都归本类。"
    },
    {
      "key": "int_missing_invalid_input",
      "family": "interactive_robustness",
      "zh": "缺项与无效输入处理",
      "en": "Missing and invalid input handling",
      "description": "初始物理模型的必要数值、边界、单元类型或连接字段缺失/不可用，须补齐或纠错；单位/坐标意义不清与相互矛盾记录分别归专类，合法负载及负绝对坐标不属无效值。"
    },
    {
      "key": "int_conflict_clarification",
      "family": "interactive_robustness",
      "zh": "冲突信息澄清",
      "en": "Conflicting information clarification",
      "description": "同一物理字段、映射或分析维度存在不兼容记录，须确认唯一依据；有后续更新仍以先解决源冲突为主类。"
    },
    {
      "key": "int_units_coordinates_clarification",
      "family": "interactive_robustness",
      "zh": "单位、坐标与荷载基准澄清",
      "en": "Unit, coordinate and load-basis clarification",
      "description": "初始输入的单位、全局方向、测距原点、轴变换或线载长度/折算基准未明确；已建立有效模型后的编辑目标消歧随编辑对象分类。"
    },
    {
      "key": "int_targeted_parameter_update",
      "family": "interactive_robustness",
      "zh": "材料截面与成员组定向更新",
      "en": "Targeted property and member-group updates",
      "description": "有效模型上的材料、截面、局部截面轴或成员组属性更新，含版本和目标组确认；混合属性与荷载更新而无几何更新时归本类。"
    },
    {
      "key": "int_geometry_topology_update",
      "family": "interactive_robustness",
      "zh": "几何与拓扑更新",
      "en": "Geometry and topology updates",
      "description": "有效模型上的坐标、长度、分段界面、连接端点或构件存在性更改，并维护连带荷载/观测；混合几何与属性/荷载更新归本类。"
    },
    {
      "key": "int_loads_combinations_update",
      "family": "interactive_robustness",
      "zh": "荷载、工况与组合更新",
      "en": "Load, case and combination updates",
      "description": "有效模型上的荷载替换/追加、分量/位置/区域变更或工况/组合更新，含编辑对象或范围的必要确认；几何及属性更改按各自优先规则归类。"
    },
    {
      "key": "int_undo_recovery",
      "family": "interactive_robustness",
      "zh": "撤销与状态恢复",
      "en": "Undo and state recovery",
      "description": "明确撤回对话中已经执行的一项修改，并验证其他轮修改仍保持；移除初始模型已有轴旋转本身不构成历史撤销。"
    },
    {
      "key": "int_result_query_revision",
      "family": "interactive_robustness",
      "zh": "结果查询与表达修订",
      "en": "Result query and presentation revision",
      "description": "物理模型及荷载有效且不变，只修订观测位置、查询集合/极值定义或输出单位；不将输出语义不明确当作物理模型不可计算。"
    },
    {
      "key": "int_complete_input_execution",
      "family": "interactive_robustness",
      "zh": "完整合法输入直接执行",
      "en": "Direct execution of complete valid input",
      "description": "完整且语义明确的对照任务，不含待确认输入或后续物理修改；保留零荷载区域、合法符号、显式不连接/缺失区域及分组材料。"
    },
    {
      "key": "mm_mechanics_schematic",
      "family": "multimodal_reverse_engineering",
      "zh": "力学简图",
      "en": "Mechanics schematics",
      "description": "沿用原定子类型：从简化力学图识别实际杆系、支座与载荷，属性按随题信息；不再叠加STD技能作为第二主类。"
    },
    {
      "key": "mm_annotated_engineering_drawing",
      "family": "multimodal_reverse_engineering",
      "zh": "工程标注图",
      "en": "Annotated engineering drawings",
      "description": "沿用原定子类型：联合读取工程尺寸、标高、构件标注及力学符号，重建实际模型。"
    },
    {
      "key": "mm_diagram_table_fusion",
      "family": "multimodal_reverse_engineering",
      "zh": "图表联合",
      "en": "Diagram and table fusion",
      "description": "沿用原定子类型：将图形对象与材料、截面、荷载或分组表对应；clean-v3将图表合并为一份附件不改变本子类型。"
    },
    {
      "key": "mm_multiview_reconstruction",
      "family": "multimodal_reverse_engineering",
      "zh": "多视图重建",
      "en": "Multiview reconstruction",
      "description": "沿用原定子类型：综合多个视图/方向或截面朝向重建几何和连接，不将本标签等同于所有题都是三维空间模型。"
    },
    {
      "key": "mm_structural_dxf",
      "family": "multimodal_reverse_engineering",
      "zh": "结构DXF",
      "en": "Structural DXF interpretation",
      "description": "沿用原定子类型：解析结构DXF中的实际线段、节点、分组与标注，区分几何图元和结构连接。"
    },
    {
      "key": "mm_architectural_dxf",
      "family": "multimodal_reverse_engineering",
      "zh": "建筑DXF",
      "en": "Architectural DXF interpretation",
      "description": "沿用原定子类型：从建筑DXF与明确的分析补充信息识别实际承重构件、缺失区域、标高与荷载，不自动补猜物理假设。"
    },
    {
      "key": "mm_missing_quality_clarification",
      "family": "multimodal_reverse_engineering",
      "zh": "缺失/质量澄清",
      "en": "Missing or low-quality visual input clarification",
      "description": "沿用原定子类型：首轮视觉输入确有遮蔽、裁切、模糊、缺尺寸或图表冲突，须先澄清，再使用按轮次释放的补图/确认信息。"
    }
  ],
  "cases": [
    {
      "id": "STD-001",
      "category": "std_boundary_connectivity",
      "rationale": "左铰右滚的约束与跨中共享观测节点是本题的基础建模区分点。"
    },
    {
      "id": "STD-002",
      "category": "std_boundary_connectivity",
      "rationale": "左固右自由及自由端转角释放决定悬臂响应，不能交换端部约束。"
    },
    {
      "id": "STD-003",
      "category": "std_geometry_topology",
      "rationale": "右支座位于梁内，须保留外伸段并区分全长中点与支承跨中。"
    },
    {
      "id": "STD-004",
      "category": "std_loads_combinations",
      "rationale": "非对称点载与全跨均布载独立叠加，力点x=4m与观测点x=6m不能串用。"
    },
    {
      "id": "STD-005",
      "category": "std_boundary_connectivity",
      "rationale": "跨中集中力必须施加在两侧梁段共用的真实节点。"
    },
    {
      "id": "STD-006",
      "category": "std_results_reporting",
      "rationale": "显式要求一页摘要，摘要与结构化结果的符号、单位、位置和工况须一致。"
    },
    {
      "id": "STD-007",
      "category": "std_units_coordinates",
      "rationale": "长度、线载、节点力、截面及弹性模量采用混合单位，须逐字段换算并按指定单位报告。"
    },
    {
      "id": "STD-008",
      "category": "std_loads_combinations",
      "rationale": "只在x=2至7m加载，两端无载段保留，加载区间不能扩展为全跨。"
    },
    {
      "id": "STD-009",
      "category": "std_loads_combinations",
      "rationale": "两处不对称集中力的大小和节点对应关系必须分别保留。"
    },
    {
      "id": "STD-010",
      "category": "std_loads_combinations",
      "rationale": "D全跨与L半跨为独立工况，须分别求解并核对显式D+L叠加。"
    },
    {
      "id": "STD-011",
      "category": "std_boundary_connectivity",
      "rationale": "左固定、右仅竖向约束构成撑杆梁，右端水平和转角自由。"
    },
    {
      "id": "STD-012",
      "category": "std_units_coordinates",
      "rationale": "倾斜杆上的全局竖向力需与局部轴向/横向分量及水平投影位置区分。"
    },
    {
      "id": "STD-013",
      "category": "std_materials_sections",
      "rationale": "B1/B2/B3三段截面分别指派，材料相同且截面分界保持连续。"
    },
    {
      "id": "STD-014",
      "category": "std_materials_sections",
      "rationale": "材料界面与加载边界错开，须按实际区段指派M1/M2并给出分配表。"
    },
    {
      "id": "STD-015",
      "category": "std_boundary_connectivity",
      "rationale": "中支座只限制竖向位移，两跨共享节点和转角而无内铰。"
    },
    {
      "id": "STD-016",
      "category": "std_units_coordinates",
      "rationale": "长跨中点须由该跨局部位置换算为全局x=7.5m，不能使用整梁中点。"
    },
    {
      "id": "STD-017",
      "category": "std_geometry_topology",
      "rationale": "按x=0/4/9/13m建立三跨四支座图，保留每一跨和两个内部支点。"
    },
    {
      "id": "STD-018",
      "category": "std_loads_combinations",
      "rationale": "仅第一跨受外载，第二跨不补载且保留其由连续性产生的响应。"
    },
    {
      "id": "STD-019",
      "category": "std_loads_combinations",
      "rationale": "D、L1、L2独立保存，逐位置比较明示组合并标识带符号控制组合。"
    },
    {
      "id": "STD-020",
      "category": "std_loads_combinations",
      "rationale": "跨长与8/10/12kN/m逐跨荷载按给定序号配对，不能排序重排。"
    },
    {
      "id": "STD-021",
      "category": "std_materials_sections",
      "rationale": "两跨分别采用独立B1/B2刚度，中支座共节点不把属性差异误作端释放。"
    },
    {
      "id": "STD-022",
      "category": "std_geometry_topology",
      "rationale": "两跨连续梁后保留真实2m外伸段，x=10m支座不是梁端。"
    },
    {
      "id": "STD-023",
      "category": "std_loads_combinations",
      "rationale": "中支座30kN与跨内20kN是不同节点荷载，支座力须正确进入反力平衡。"
    },
    {
      "id": "STD-024",
      "category": "std_loads_combinations",
      "rationale": "向下D和中跨向上W为合法独立载荷，按D与D+W保留负反力和符号。"
    },
    {
      "id": "STD-025",
      "category": "std_loads_combinations",
      "rationale": "右端节点力矩与均布力叠加，不能把kN·m当作集中力或额外约束。"
    },
    {
      "id": "STD-026",
      "category": "std_materials_sections",
      "rationale": "中间两跨B2与首末跨B1的截面分组不随第二、四跨的活载分组混用。"
    },
    {
      "id": "STD-027",
      "category": "std_geometry_topology",
      "rationale": "Pratt名称不替代逐杆端点表，须保留给定全部弦杆、竖杆与斜杆。"
    },
    {
      "id": "STD-028",
      "category": "std_geometry_topology",
      "rationale": "双坡梯形变高度与六节间完整连接须按坐标和端点表重建。"
    },
    {
      "id": "STD-029",
      "category": "std_geometry_topology",
      "rationale": "六节点十杆的特殊水平连杆是实际构件，不能用常见三角桁架模板替换。"
    },
    {
      "id": "STD-030",
      "category": "std_geometry_topology",
      "rationale": "完整竖杆与交替斜杆序列定义本题杆系，不能按Warren名称删改。"
    },
    {
      "id": "STD-031",
      "category": "std_geometry_topology",
      "rationale": "规则平行弦屋架仍须保留两端竖杆和全部交替腹杆。"
    },
    {
      "id": "STD-032",
      "category": "std_geometry_topology",
      "rationale": "屋脊x=7.5m独立于3m下弦网格，须保留非整节间顶点及真实腹杆端点。"
    },
    {
      "id": "STD-033",
      "category": "std_geometry_topology",
      "rationale": "三角腹杆描述腹杆布置，实际外轮廓仍为12节点21杆的平行弦桁架。"
    },
    {
      "id": "STD-034",
      "category": "std_geometry_topology",
      "rationale": "Howe类斜杆采用明示反向端点，不能套用Pratt连接模板。"
    },
    {
      "id": "STD-035",
      "category": "std_boundary_connectivity",
      "rationale": "K腹杆与竖杆中点为真实共节点，须分段连接并维护节点平衡。"
    },
    {
      "id": "STD-036",
      "category": "std_boundary_connectivity",
      "rationale": "X腹杆几何相交处没有结构连接，不能擅自分杆或共享自由度。"
    },
    {
      "id": "STD-037",
      "category": "std_geometry_topology",
      "rationale": "不等节间按累计坐标0/2/5/9/12m建模，并保留对应节点标签。"
    },
    {
      "id": "STD-038",
      "category": "std_geometry_topology",
      "rationale": "单坡上弦和非对称腹杆端点按实表构造，不能镜像补成对称模板。"
    },
    {
      "id": "STD-039",
      "category": "std_materials_sections",
      "rationale": "上弦、下弦、腹杆分别采用A1/A2/A3，逐杆属性组和代表杆索引须一致。"
    },
    {
      "id": "STD-040",
      "category": "std_boundary_connectivity",
      "rationale": "A/B/C的逐方向平移约束不同，须消除刚体运动而不额外锁定自由方向。"
    },
    {
      "id": "STD-041",
      "category": "std_geometry_topology",
      "rationale": "方锥顶点偏离底面中心，四斜杆及底边杆须采用实际空间坐标。"
    },
    {
      "id": "STD-042",
      "category": "std_geometry_topology",
      "rationale": "两层三角柱空间桁架按跨层端点表构造，不能漏掉层间杆组。"
    },
    {
      "id": "STD-043",
      "category": "std_geometry_topology",
      "rationale": "平屋面门架必须保持水平屋面，不能根据门架名称自动生成屋脊。"
    },
    {
      "id": "STD-044",
      "category": "std_boundary_connectivity",
      "rationale": "双跨只共用一根中柱和一个中柱顶刚接节点，不能重复建柱或断开屋面。"
    },
    {
      "id": "STD-045",
      "category": "std_loads_combinations",
      "rationale": "屋面60kN设备点载是全跨8kN/m之外的独立荷载，力点剪力跳跃须对应。"
    },
    {
      "id": "STD-046",
      "category": "std_loads_combinations",
      "rationale": "中柱顶49kN竖力与4.9kN水平力共同作用，不能移到外柱或屋面跨中。"
    },
    {
      "id": "STD-047",
      "category": "std_geometry_topology",
      "rationale": "左柱中高真实接入6m悬挑夹层，夹层端不增设支座或虚构落地柱。"
    },
    {
      "id": "STD-048",
      "category": "std_units_coordinates",
      "rationale": "坡梁线载按实际杆长且保持全局竖向，不能当作局部横载或重复投影。"
    },
    {
      "id": "STD-049",
      "category": "std_geometry_topology",
      "rationale": "偏置屋脊使两坡长度和几何不对称，须采用屋脊真实坐标。"
    },
    {
      "id": "STD-050",
      "category": "std_geometry_topology",
      "rationale": "两跨不同屋面标高要求中柱保留z=6m与8m两接入点及其间柱段。"
    },
    {
      "id": "STD-051",
      "category": "std_loads_combinations",
      "rationale": "D全屋面向下、W仅右坡向上，按明示D与D+W分别保留加载范围和符号。"
    },
    {
      "id": "STD-052",
      "category": "std_materials_sections",
      "rationale": "屋面三段采用给定常截面B1/B2/B3，不能擅换成连续变截面单元。"
    },
    {
      "id": "STD-053",
      "category": "std_boundary_connectivity",
      "rationale": "左铰右固柱脚的转动约束不同，不能复制同一套边界。"
    },
    {
      "id": "STD-054",
      "category": "std_materials_sections",
      "rationale": "外柱、中柱和梁三组截面按角色映射，不能因共用工况而全局覆盖属性。"
    },
    {
      "id": "STD-055",
      "category": "std_loads_combinations",
      "rationale": "楼面面载已折为60kN/m，只施加一次梁线载并保留节点各自响应。"
    },
    {
      "id": "STD-056",
      "category": "std_loads_combinations",
      "rationale": "屋面36kN/m已折算，吊车两分量另加于右柱顶，原面载只作来源说明。"
    },
    {
      "id": "STD-057",
      "category": "std_loads_combinations",
      "rationale": "逐层侧力10/15/20kN按楼层排序，与重力分工况并组成D+W。"
    },
    {
      "id": "STD-058",
      "category": "std_boundary_connectivity",
      "rationale": "只有右上节点施加侧力，两柱顶不加题外刚性楼层耦合。"
    },
    {
      "id": "STD-059",
      "category": "std_boundary_connectivity",
      "rationale": "无载中高连系梁仍与两柱真实共节点刚接，两柱须在接入处分段。"
    },
    {
      "id": "STD-060",
      "category": "std_loads_combinations",
      "rationale": "D与L须独立保留，再按1.2D+1.4L组合，不能先相加再统一放大。"
    },
    {
      "id": "STD-061",
      "category": "std_geometry_topology",
      "rationale": "不等层高先累加为标高，不等跨按给定顺序构建实际节点网格。"
    },
    {
      "id": "STD-062",
      "category": "std_geometry_topology",
      "rationale": "上层右跨梁柱明确不存在，不能补成完整两跨网格或给空区加载。"
    },
    {
      "id": "STD-063",
      "category": "std_boundary_connectivity",
      "rationale": "刚接梁柱与轴力斜撑为混合单元，首层交叉支撑两端铰接且交点不相连。"
    },
    {
      "id": "STD-064",
      "category": "std_geometry_topology",
      "rationale": "两层真实右侧外挑段接入楼层节点，自由端保留且区别主跨和悬段。"
    },
    {
      "id": "STD-065",
      "category": "std_loads_combinations",
      "rationale": "三层12/10/6kN/m逐层指派，不能将首层荷载复制到全楼。"
    },
    {
      "id": "STD-066",
      "category": "std_materials_sections",
      "rationale": "边柱/中柱与左梁/右梁四截面组交叉映射，成员表须对应实体属性。"
    },
    {
      "id": "STD-067",
      "category": "std_geometry_topology",
      "rationale": "上层中柱缺失而顶梁仍连续，不能根据下层规则柱线补柱或增设支座。"
    },
    {
      "id": "STD-068",
      "category": "std_units_coordinates",
      "rationale": "柱底负绝对标高合法，须按实际标高保留地面和上部楼层连接。"
    },
    {
      "id": "STD-069",
      "category": "std_boundary_connectivity",
      "rationale": "混凝土框架左柱脚铰、右柱脚固定，材料角色不改变混合边界语义。"
    },
    {
      "id": "STD-070",
      "category": "std_geometry_topology",
      "rationale": "三层混凝土框架按三个实际楼层构造，保留各层独立节点与层间位置。"
    },
    {
      "id": "STD-071",
      "category": "std_materials_sections",
      "rationale": "C30作为完整弹性材料记录参与一次分析，不能只替换等级名称或执行来源题后续更新。"
    },
    {
      "id": "STD-072",
      "category": "std_geometry_topology",
      "rationale": "不等层高累加为3.3/7.3/10.4m，不等跨与实际楼层梁柱逐项连接。"
    },
    {
      "id": "STD-073",
      "category": "std_materials_sections",
      "rationale": "柱C40与梁C30按构件角色分配各自E等实体弹性属性，不全局覆盖。"
    },
    {
      "id": "STD-074",
      "category": "std_units_coordinates",
      "rationale": "左右矩形柱的局部轴朝向决定强弱向刚度，不能仅交换尺寸标签。"
    },
    {
      "id": "STD-075",
      "category": "std_geometry_topology",
      "rationale": "下层三跨、上层左两跨的退台拓扑优先保持，缺失上层区域不补建。"
    },
    {
      "id": "STD-076",
      "category": "std_loads_combinations",
      "rationale": "左右受荷宽度4/6m分别折为40/60kN/m，面载不重复施加。"
    },
    {
      "id": "STD-077",
      "category": "std_materials_sections",
      "rationale": "首层/上层柱与顶层梁采用不同截面组，属性须随楼层和构件角色指派。"
    },
    {
      "id": "STD-078",
      "category": "std_loads_combinations",
      "rationale": "D、W+、W-独立保存并按明示三组合计算，反向侧力不能绝对值化。"
    },
    {
      "id": "STD-079",
      "category": "std_loads_combinations",
      "rationale": "楼面按Y半跨受荷宽度仅传给X梁，Y梁不重复加载且不加刚性楼板。"
    },
    {
      "id": "STD-080",
      "category": "std_geometry_topology",
      "rationale": "空间网格为X两跨、Y一跨，两方向跨数及真实三维梁柱连接须保持。"
    },
    {
      "id": "STD-081",
      "category": "std_geometry_topology",
      "rationale": "三层空间网格为X一跨、Y两跨，须按方向及楼层正确构造实际构件。"
    },
    {
      "id": "STD-082",
      "category": "std_loads_combinations",
      "rationale": "两层不同面载分别按Y边/中轴线宽度传给X梁，不跨层复制或重复分配。"
    },
    {
      "id": "STD-083",
      "category": "std_materials_sections",
      "rationale": "首层柱C40，其余柱和梁C30，材料同时按楼层与构件角色分配。"
    },
    {
      "id": "STD-084",
      "category": "std_loads_combinations",
      "rationale": "一层与二层面载不同，分别只传给该层X梁并保留分层荷载索引。"
    },
    {
      "id": "STD-085",
      "category": "std_geometry_topology",
      "rationale": "X/Y均为不等跨且层高不等，完整梁连接表优先于规则空间模板。"
    },
    {
      "id": "STD-086",
      "category": "std_geometry_topology",
      "rationale": "L形平面缺角区明确不存在，只建实际梁柱且不虚构楼面区域。"
    },
    {
      "id": "STD-087",
      "category": "std_geometry_topology",
      "rationale": "下层2×2跨、上层左1×2跨，逐层柱网与退台连接按实际构件保留。"
    },
    {
      "id": "STD-088",
      "category": "std_loads_combinations",
      "rationale": "双向侧力Wx/Wy与D分别保存，逐组合输出同一位置的方向分量。"
    },
    {
      "id": "STD-089",
      "category": "std_materials_sections",
      "rationale": "角柱/边柱/中柱与X/Y梁五组截面按空间角色指派。"
    },
    {
      "id": "STD-090",
      "category": "std_units_coordinates",
      "rationale": "只旋转指定柱线的局部截面轴，不能误转其他柱或全局荷载向量。"
    },
    {
      "id": "STD-091",
      "category": "std_loads_combinations",
      "rationale": "活载仅作用顶层指定一格的四边梁，保留D并按D+L计算且不重复加载。"
    },
    {
      "id": "STD-092",
      "category": "std_geometry_topology",
      "rationale": "高低屋面形成真实三维斜梁网，端点标高和屋面连接按实际几何构造。"
    },
    {
      "id": "STD-093",
      "category": "std_boundary_connectivity",
      "rationale": "指定立面的轴力斜撑与其余刚接梁柱混用，不能把支撑当抗弯梁或补到其他面。"
    },
    {
      "id": "STD-094",
      "category": "std_units_coordinates",
      "rationale": "源Y向上到全局Z向上的带符号轴变换须同时作用于坐标、约束、荷载与局部轴。"
    },
    {
      "id": "STD-095",
      "category": "std_loads_combinations",
      "rationale": "柱顶只有轴向压力，保持压缩方向和有符号轴力/位移，不引入稳定分析。"
    },
    {
      "id": "STD-096",
      "category": "std_loads_combinations",
      "rationale": "顶点轴压与X向侧力为独立分量，按一阶弹性静力叠加其轴向和弯曲响应。"
    },
    {
      "id": "STD-097",
      "category": "std_loads_combinations",
      "rationale": "中高节点与顶部轴压独立施加，使上下柱段轴力不同，不能并移到柱顶。"
    },
    {
      "id": "STD-098",
      "category": "std_units_coordinates",
      "rationale": "空间柱的两主惯性矩须与明确局部轴对应，再解释全局双向弯曲响应。"
    },
    {
      "id": "STD-099",
      "category": "std_materials_sections",
      "rationale": "C1/C2分段EA/EI分别指派，截面界面连续且无内铰。"
    },
    {
      "id": "STD-100",
      "category": "std_geometry_topology",
      "rationale": "柱顶真实1m偏心短梁具有给定A/I/J，不能用未声明刚臂替代空间几何。"
    },
    {
      "id": "INT-001",
      "category": "int_undo_recovery",
      "rationale": "追加跨中30kN后只撤回该项，原均布载与近支座点力仍保留。"
    },
    {
      "id": "INT-002",
      "category": "int_units_coordinates_clarification",
      "rationale": "初始竖向端力只有数值10而缺单位，确认kN后再分析并保留独立轴力。"
    },
    {
      "id": "INT-003",
      "category": "int_result_query_revision",
      "rationale": "仅把第一个位移观测点移至支承跨中，物理模型和外伸端查询均不变。"
    },
    {
      "id": "INT-004",
      "category": "int_conflict_clarification",
      "rationale": "两端固支与左铰右滚互相冲突，须先确认唯一支承条件。"
    },
    {
      "id": "INT-005",
      "category": "int_loads_combinations_update",
      "rationale": "将跨中25kN替换为40kN，不能累加或改动已有支座力矩。"
    },
    {
      "id": "INT-006",
      "category": "int_geometry_topology_update",
      "rationale": "跨度由8改10m，右支座、截面分界及跨中观测节点同步更新。"
    },
    {
      "id": "INT-007",
      "category": "int_missing_invalid_input",
      "rationale": "初始模型尚无外荷载定义，须补齐整梁加载信息后计算。"
    },
    {
      "id": "INT-008",
      "category": "int_loads_combinations_update",
      "rationale": "仅移动局部均布载区间，强度与结构边界保持，不保留旧加载段。"
    },
    {
      "id": "INT-009",
      "category": "int_undo_recovery",
      "rationale": "先改左力再移右力，最后只撤回右力位置，须保留左力35kN。"
    },
    {
      "id": "INT-010",
      "category": "int_conflict_clarification",
      "rationale": "左半跨6kN/m同时标D和L构成工况归属冲突，确认后保留两独立工况。"
    },
    {
      "id": "INT-011",
      "category": "int_missing_invalid_input",
      "rationale": "右端仅写有支承但约束自由度缺失，须确认仅Uz约束。"
    },
    {
      "id": "INT-012",
      "category": "int_units_coordinates_clarification",
      "rationale": "初始主力方向未明确，先确认全局-Z；后续改幅值仍保留独立+X端力。"
    },
    {
      "id": "INT-013",
      "category": "int_targeted_parameter_update",
      "rationale": "仅将中段B2替换为新增B4实体属性，外段、连接和荷载不变。"
    },
    {
      "id": "INT-014",
      "category": "int_conflict_clarification",
      "rationale": "同一区段同时指派M1/M2，先澄清材料映射再执行后续点力替换。"
    },
    {
      "id": "INT-015",
      "category": "int_missing_invalid_input",
      "rationale": "第二跨长度缺失，须补全后才能确定右支座及第二跨观测点。"
    },
    {
      "id": "INT-016",
      "category": "int_units_coordinates_clarification",
      "rationale": "长跨内3.5m缺少测距原点/方向说明，确认后映射到全局x=7.5m。"
    },
    {
      "id": "INT-017",
      "category": "int_missing_invalid_input",
      "rationale": "第三跨-4m被明确作为长度录入错误修正，不等同于合法负坐标。"
    },
    {
      "id": "INT-018",
      "category": "int_complete_input_execution",
      "rationale": "第二跨零外载但实际存在，初始输入完整，应直接分析其连续梁响应。"
    },
    {
      "id": "INT-019",
      "category": "int_loads_combinations_update",
      "rationale": "分两轮只修改C2的L1与D系数，原始工况和其余组合保持。"
    },
    {
      "id": "INT-020",
      "category": "int_conflict_clarification",
      "rationale": "第三跨荷载文字8与表12不一致，先确认逐跨荷载表的权威依据。"
    },
    {
      "id": "INT-021",
      "category": "int_targeted_parameter_update",
      "rationale": "只替换第二跨B2为B3，第一跨和左端固定边界不随之变化。"
    },
    {
      "id": "INT-022",
      "category": "int_geometry_topology_update",
      "rationale": "外伸长度由2改3m，端力随真实自由端移动，局部均布区同步伸长。"
    },
    {
      "id": "INT-023",
      "category": "int_loads_combinations_update",
      "rationale": "有效模型上的点力替换先确认目标为第二跨中点，支座力与上向区载保持。"
    },
    {
      "id": "INT-024",
      "category": "int_complete_input_execution",
      "rationale": "正负荷载与组合已完整明示，合法上拔方向无需按无效值拒绝。"
    },
    {
      "id": "INT-025",
      "category": "int_units_coordinates_clarification",
      "rationale": "端部力矩20缺单位，须确认kN·m及绕全局+Y的符号定义。"
    },
    {
      "id": "INT-026",
      "category": "int_undo_recovery",
      "rationale": "撤销早一轮的活载调整，同时保留较新一轮中间两跨B3截面更新。"
    },
    {
      "id": "INT-027",
      "category": "int_loads_combinations_update",
      "rationale": "四个内部上弦节点力各由10替换为15kN，端节点不追加荷载。"
    },
    {
      "id": "INT-028",
      "category": "int_units_coordinates_clarification",
      "rationale": "五个下弦力的吨力/kN单位未确认，澄清后保留独立水平分量。"
    },
    {
      "id": "INT-029",
      "category": "int_missing_invalid_input",
      "rationale": "总高0m使三角桁架几何退化，须先修正高度而非按平面直线模型求解。"
    },
    {
      "id": "INT-030",
      "category": "int_conflict_clarification",
      "rationale": "纯Warren无竖杆的文字与含竖杆端点表冲突，须确认保留表中连接。"
    },
    {
      "id": "INT-031",
      "category": "int_loads_combinations_update",
      "rationale": "只把四个指定上弦节点力移到同X下弦，剩余上弦力和分组截面保持。"
    },
    {
      "id": "INT-032",
      "category": "int_missing_invalid_input",
      "rationale": "腹杆DG1终点字段缺失，须补为顶点后才形成完整连接。"
    },
    {
      "id": "INT-033",
      "category": "int_result_query_revision",
      "rationale": "物理输入完整，额外最大轴力的查询集合待确认；明确后用同状态结果取绝对值极值。"
    },
    {
      "id": "INT-034",
      "category": "int_geometry_topology_update",
      "rationale": "按附件B替换指定两格斜杆端点，每格仍只保留一根斜杆。"
    },
    {
      "id": "INT-035",
      "category": "int_missing_invalid_input",
      "rationale": "K腹杆交点是否与竖杆共节点未明确，须补齐连接语义后分析。"
    },
    {
      "id": "INT-036",
      "category": "int_complete_input_execution",
      "rationale": "交叉处明确不相连且端点表完整，合法不连接语义应直接保留。"
    },
    {
      "id": "INT-037",
      "category": "int_missing_invalid_input",
      "rationale": "第二节间长度及其后累计坐标未给出，不能由隐藏总跨反推。"
    },
    {
      "id": "INT-038",
      "category": "int_geometry_topology_update",
      "rationale": "只抬高最高端上弦节点，其他坐标、连接、荷载向量与材料角色保持。"
    },
    {
      "id": "INT-039",
      "category": "int_conflict_clarification",
      "rationale": "上下弦截面组引用冲突先澄清，后续仅改腹杆A4不改变D/W工况。"
    },
    {
      "id": "INT-040",
      "category": "int_missing_invalid_input",
      "rationale": "B节点Y约束字段空缺，须补齐该必要边界后分析空间桁架。"
    },
    {
      "id": "INT-041",
      "category": "int_units_coordinates_clarification",
      "rationale": "初始20kN只称水平而未给X/Y方向，须确认全局+X。"
    },
    {
      "id": "INT-042",
      "category": "int_undo_recovery",
      "rationale": "替换空间顶层两斜杆后撤回该项，恢复原连接表而保留其他状态。"
    },
    {
      "id": "INT-043",
      "category": "int_geometry_topology_update",
      "rationale": "两柱及屋面标高由7改9m，跨度、混合柱脚和线载强度保持。"
    },
    {
      "id": "INT-044",
      "category": "int_conflict_clarification",
      "rationale": "18+18m分跨与总宽30m冲突，先确认以分跨为准。"
    },
    {
      "id": "INT-045",
      "category": "int_units_coordinates_clarification",
      "rationale": "屋面荷载8缺单位和类型，确认已折算kN/m后不能再乘受荷宽。"
    },
    {
      "id": "INT-046",
      "category": "int_loads_combinations_update",
      "rationale": "仅将中柱顶X力+4.9替换为-7kN，竖向分量与屋面荷载保持。"
    },
    {
      "id": "INT-047",
      "category": "int_geometry_topology_update",
      "rationale": "只改变左夹层连接层位，柱段随共节点更新，右短挑和屋面保持。"
    },
    {
      "id": "INT-048",
      "category": "int_units_coordinates_clarification",
      "rationale": "坡屋面6kN/m的长度基准未给出，确认按实际坡长而非再次投影。"
    },
    {
      "id": "INT-049",
      "category": "int_geometry_topology_update",
      "rationale": "先移动真实屋脊并更新两坡长度，再单改右坡线载，几何更新是主变化。"
    },
    {
      "id": "INT-050",
      "category": "int_loads_combinations_update",
      "rationale": "已有效的错高门架追加点力前须确认中柱节点层位与方向，再仅在M6加载。"
    },
    {
      "id": "INT-051",
      "category": "int_complete_input_execution",
      "rationale": "上拔W、重力D和组合系数完整，按合法全局符号直接计算。"
    },
    {
      "id": "INT-052",
      "category": "int_targeted_parameter_update",
      "rationale": "只替换屋面中段B4截面，左右段、分界位置及混合柱脚保持。"
