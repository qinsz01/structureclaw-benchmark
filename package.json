{
  "name": "structureclaw-benchmark",
  "version": "0.1.0",
  "private": true,
  "description": "Public, reproducible benchmark runner and corpus for StructureClaw",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "sharp": "^0.35.1"
  },
  "scripts": {
    "benchmark": "node runner.cjs",
    "benchmark:single": "node runner.cjs --scenario",
    "benchmark:openclaw": "node external/openclaw/runner.cjs",
    "test:openclaw": "node --test external/openclaw/config.test.cjs external/openclaw/tool-contracts.test.cjs",
    "test:evaluation": "node --test lib/physical-model-fidelity.test.cjs lib/analysis-fidelity.test.cjs lib/analysis-evidence.test.cjs lib/cross-engine-ground-truth.test.cjs lib/commercial-stations.test.cjs lib/evaluate-physics.test.cjs lib/solver-evidence.test.cjs lib/capability-coverage.test.cjs lib/requested-quantities.test.cjs lib/representative-pack.test.cjs",
    "validate": "node scripts/validate-research300.cjs",
    "acceptance:representatives": "node scripts/check-representative-pack.mjs",
    "benchmark:research300": "node runner.cjs --corpus research-300",
    "export:research300": "node scripts/export-research300-inputs.cjs",
    "catalogue:research300": "node scripts/export-research300-catalogue.mjs",
    "check:catalogue": "node scripts/export-research300-catalogue.mjs --check",
    "test:catalogue": "node --test lib/research300-catalogue.test.cjs scripts/export-research300-catalogue-workbook.test.cjs scripts/export-research300-catalogue.test.mjs",
    "validate:research300": "node scripts/validate-research300.cjs",
    "manifest:research300": "node scripts/build-research300-manifest.cjs",
    "test:research300": "node --test lib/corpus-provider.test.cjs lib/public-input-edition.test.cjs lib/clean-input-edition.test.cjs lib/clean-report.test.cjs lib/public-task.test.cjs scripts/export-research300-inputs.test.cjs lib/research300-validation.test.cjs lib/research300-manifest.test.cjs lib/research300-evaluation.test.cjs lib/reference-precision.test.cjs lib/reference-precision-binding.test.cjs lib/native-job.test.cjs scripts/run-research300.test.cjs scripts/check-research300-references.test.cjs scripts/install-research300-commercial.test.cjs scripts/check-research300-commercial.test.cjs lib/public-input-review.test.cjs scripts/research300/blind_input_review.test.cjs lib/public-input-review-v2.test.cjs scripts/research300/blind_input_review_v2.test.cjs lib/public-input-review-v2-stress.test.cjs",
    "test:references": "python3 -m unittest discover -s scripts/research300 -p 'test_reference*.py'",
    "test:native-jobs": "python3 -m unittest discover -s scripts/research300 -p 'native_*test.py'",
    "check:references": "node scripts/check-research300-references.cjs",
    "test:native-audit": "python3 -m unittest discover -s scripts/research300 -p 'test_native_audit*.py'",
    "audit:native-evidence": "python3 scripts/research300/audit_native_evidence.py",
    "test:commercial-calibration": "python3 -m unittest discover -s scripts/research300/commercial -p 'test_*.py'",
    "inventory:commercial": "python3 scripts/research300/commercial/inventory.py --cases-root corpora/research-300/cases",
    "check:commercial-diagnostics": "node scripts/check-research300-commercial.cjs",
    "test:visual-inputs": "python3 -m unittest discover -s scripts/research300 -p test_public_input_visual.py",
    "test:clean-inputs": "python3 -m unittest discover -s scripts/research300 -p test_public_input_clean.py",
    "test:section-diversity": "python3 -m unittest discover -s scripts/research300 -p test_section_diversity.py",
    "audit:section-diversity": "python3 scripts/research300/section_diversity.py audit --plan planning/section-diversity-v1-r2.json",
    "build:section-diversity": "python3 scripts/research300/section_diversity.py build --plan planning/section-diversity-v1-r2.json",
    "evaluate": "node scripts/evaluate-results.cjs",
    "prepare:evaluation": "node scripts/evaluate-results.cjs --prepare",
    "test:adapters": "node --test lib/import-codex.test.cjs lib/import-structureclaw.test.cjs lib/structureclaw-payload-binding.test.cjs lib/result-import.test.cjs",
    "review:inputs": "node scripts/research300/blind_input_review_v2.cjs",
    "test:input-review": "node --test lib/public-input-review-v2.test.cjs lib/public-input-review-v2-stress.test.cjs scripts/research300/blind_input_review_v2.test.cjs",
    "test:research300-v32": "node --test scripts/research300_v3/test_evaluate_v32.cjs scripts/research300_v3/test_controlled_evidence_v32.cjs scripts/research300_v3/test_grade_candidate_v32.cjs scripts/research300_v3/test_publish_capture_v32.cjs",
    "test:research300-v32-inputs": "python3 -m unittest scripts.research300_v3.test_prepare_readiness_v32 scripts.research300_v3.test_audit_reviewer_evidence -v",
    "test:research300-v32-codex": "node --test scripts/research300_v3/test_grade_codex_smoke_v32.cjs && python3 -m unittest scripts.research300_v3.test_codex_broker_v32 scripts.research300_v3.test_codex_run_v32 -v"
  },
  "engines": {
    "node": ">=20"
  }
}
