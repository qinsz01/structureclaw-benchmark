{
  "schemaVersion": 1,
  "evaluationProfile": "engineering-v2.3",
  "id": "MM-082",
  "modelId": "M-MM-082",
  "family": "multimodal_reverse_engineering",
  "language": "英文",
  "locale": "en",
  "plannedEngine": "YJK",
  "sourcePlan": {
    "sourceRequirements": {
      "task.inputForm": "新建筑DXF通过明确结构层提供本题几何/连接；围护/设备为干扰层；工程附录明确支座、荷载、属性和坐标映射，不把墙线默认成杆件或支座。所有新附件待制作、盲审与验证。面载仅传给X梁，受荷宽度为实际相邻楼面Y向半跨之和；Y梁不重复加载，无默认刚性楼板。",
      "task.scenario": "几何：X网格0、6、12m，Y网格0、5、10m，两层z=3.6、7.2m；九柱线完整，楼层网格梁齐全但顶层x=6m的两段Y梁均缺失；边界：九柱脚固定；荷载：首层面载10、二层8kN/m²按X梁单向分配；顶层(12,10,7.2)m加Fx=15、Fy=10kN；属性：钢M1、柱C1、X梁B1、Y梁B2，无刚性楼板。（本栏是编题规格，实际用户输入按图/表分工呈现。）",
      "task.modelingFocus": "建筑轴线可能掩盖整条缺梁线，需按结构实体而不是网格建梁。",
      "task.expectedOutput": "加载角点Ux/Uy、顶层中心节点Uy；附与数值一致的模型/结果图。",
      "task.gradingFocus": "模型核对：规则2×2跨框架顶层删去一整条横向梁线并施双向偏心侧力。；数值/表述核对：加载角点Ux/Uy、顶层中心节点Uy，位置、方向、单位须一致。",
      "task.prerequisite": "按本题拟定 YJK 独立重算并核验；本题新增几何/属性与真值均待独立核验；材料截面代号须在本题附录定值。按实际保留矩形楼面逐层分配面载，关闭自重与默认刚性楼板。",
      "model.topologyKey": "X网格0、6、12m，Y网格0、5、10m，两层z=3.6、7.2m；九柱线完整，楼层网格梁齐全但顶层x=6m的两段Y梁均缺失",
      "model.boundaryKey": "九柱脚固定",
      "model.loadKey": "首层面载10、二层8kN/m²按X梁单向分配；顶层(12,10,7.2)m加Fx=15、Fy=10kN",
      "model.propertyKey": "钢M1、柱C1、X梁B1、Y梁B2，无刚性楼板。",
      "engine.analysisContract": "一阶线弹性；自重OFF并保存配置；按附录实际E/A/I/J，不套默认刚度折减；无默认刚性楼板。原生工程须显式关闭自重、自动组合/地震及影响该契约的默认设置，导出配置核对。采用题定右手全局Z向上，核对构件局部轴与结果分量。面载仅传给实际X梁，受荷宽度为相邻实际楼面Y向半跨之和，Y梁不重复加载；等效线/节点载须同时保持合力和力矩。荷载契约：首层面载10、二层8kN/m²按X梁单向分配；顶层(12,10,7.2)m加Fx=15、Fy=10kN；未指定组合时仅算题定基本荷载，指定组合逐组执行，不能用软件默认包络替换。",
      "engine.executionRequirement": "原生项目顶层整条Y梁线缺失，保留两向角点力和X/Y梁分组；适配/回读通过后再执行；执行后按原题完整输出：加载角点Ux/Uy、顶层中心节点Uy；附与数值一致的模型/结果图。本轮仅规划，不运行。",
      "engine.requiredEvidence": "计划保存输入PNG/DXF及图中构件/标签→计算节点/构件ID映射、YJK原生工程及接口导入/回读差异、引擎版本与设置快照、实际运行日志、原始结果表/观测点索引、可视图所用数据。",
      "engine.adapterGap": "现有YJK完整相邻梁网不能删除顶层整条Y梁线；角点Fx/Fy点力及X/Y两类梁截面分别超出当前楼面荷载与单梁截面接口。",
      "engine.truthPlan": "由独立审阅的YJK原生工程形成同版本、同参数的参考结果；核对实际楼层/构件属性、题定荷载合力及力矩平衡，并保存加载角点Ux/Uy、顶层中心节点Uy的原始索引。原生人工参考模型不代表当前自动接口已接通。"
    },
