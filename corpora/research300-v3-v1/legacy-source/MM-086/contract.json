{
  "schemaVersion": 1,
  "evaluationProfile": "engineering-v2.3",
  "id": "MM-086",
  "modelId": "M-MM-086",
  "family": "multimodal_reverse_engineering",
  "language": "英文",
  "locale": "en",
  "plannedEngine": "PKPM",
  "sourcePlan": {
    "sourceRequirements": {
      "task.inputForm": "新建筑DXF通过明确结构层提供本题几何/连接；围护/设备为干扰层；工程附录明确支座、荷载、属性和坐标映射，不把墙线默认成杆件或支座。所有新附件待制作、盲审与验证。",
      "task.scenario": "几何：X网格0、4、8、12m，Y网格0、5、10m，两层各3.6m；平面取六矩形格去掉后排中间一格形成U形，柱仅在保留格顶点，梁仅沿保留格边线，重复边只建一次；边界：所有底柱脚固定；荷载：全部实际梁向下8kN/m，第二层左翼梁另加向下4kN/m；属性：钢M1、柱C1、梁B1，无刚性楼板。（本栏是编题规格，实际用户输入按图/表分工呈现。）",
      "task.modelingFocus": "建筑背景线可能跨过U形开口，必须按保留楼面和结构线定边。",
      "task.expectedOutput": "顶层凹口两端节点Uz、左翼外柱底反力；附与数值一致的模型/结果图。",
      "task.gradingFocus": "模型核对：L形删角平面改为U形中间凹口，改变缺失区域和连接结构。；数值/表述核对：顶层凹口两端节点Uz、左翼外柱底反力，位置、方向、单位须一致。",
      "task.prerequisite": "不规则楼面荷载映射需验证；本题新增几何/属性与真值均待独立核验；材料截面代号须在本题附录定值。",
      "model.topologyKey": "X网格0、4、8、12m，Y网格0、5、10m，两层各3.6m；平面取六矩形格去掉后排中间一格形成U形，柱仅在保留格顶点，梁仅沿保留格边线，重复边只建一次",
      "model.boundaryKey": "所有底柱脚固定",
      "model.loadKey": "全部实际梁向下8kN/m，第二层左翼梁另加向下4kN/m",
      "model.propertyKey": "钢M1、柱C1、梁B1，无刚性楼板。",
      "engine.analysisContract": "一阶线弹性；自重OFF并保存配置；按附录实际E/A/I/J，不套默认刚度折减；无默认刚性楼板。原生工程须显式关闭自重、自动组合/地震及影响该契约的默认设置，导出配置核对。采用题定右手全局Z向上，核对构件局部轴与结果分量。题给线载/点力/力矩按原位映射；如作等效节点加载，须保留原始分布荷载并采用与单元插值一致的等效荷载，核验跨内响应及合力/力矩，不用统一楼面载替代。荷载契约：全部实际梁向下8kN/m，第二层左翼梁另加向下4kN/m；未指定组合时仅算题定基本荷载，指定组合逐组执行，不能用软件默认包络替换。",
      "engine.executionRequirement": "原生项目保留两层U形实际梁图，精确录入各梁线载及左翼附加载荷；必须补全柱底反力读取通道；执行后按原题完整输出：顶层凹口两端节点Uz、左翼外柱底反力；附与数值一致的模型/结果图。本轮仅规划，不运行。",
      "engine.requiredEvidence": "计划保存输入PNG/DXF及图中构件/标签→计算节点/构件ID映射、PKPM原生工程及接口导入/回读差异、引擎版本与设置快照、实际运行日志、原始结果表/观测点索引、可视图所用数据。另保存原始柱底反力及新增读取通道校验记录。",
      "engine.adapterGap": "逐梁8kN/m及仅顶层左翼加4kN/m不等价于现有统一DL/LL楼面输入，需精确梁载接口或经证明的等效输入；当前PKPM结果读取缺节点支反力，本题柱底反力必须补齐，不能删掉。U形实际拓扑仍须回读验证。",
      "engine.truthPlan": "由独立审阅的PKPM原生工程形成同版本、同参数的参考结果；核对实际楼层/构件属性、题定荷载合力及力矩平衡，并保存顶层凹口两端节点Uz、左翼外柱底反力的原始索引。原生人工参考模型不代表当前自动接口已接通。"
    },
