{
  "schemaVersion": 1,
  "evaluationProfile": "engineering-v2.3",
  "id": "MM-080",
  "modelId": "M-MM-080",
  "family": "multimodal_reverse_engineering",
  "language": "英文",
  "locale": "en",
  "plannedEngine": "YJK",
  "sourcePlan": {
    "sourceRequirements": {
      "task.inputForm": "新平面及正交立面/局部截面PNG共同给本题空间几何、连接与朝向；附录给明确约束、荷载向量、完整属性和视图轴约定，不直接给完整节点坐标答案。所有新附件待制作、盲审与验证。面载仅传给X梁，受荷宽度为实际相邻楼面Y向半跨之和；Y梁不重复加载，无默认刚性楼板。",
      "task.scenario": "几何：X网格0、6、12m，Y网格0、5m，两层z=3.6、7.2m；柱线完整，各层网格边梁齐全但顶层x=6m的Y梁缺失；边界：六底柱脚固定；荷载：两层面载8kN/m²按X梁单向分配，顶层(12,5,7.2)m节点Fy=20kN；属性：钢M1、柱C1、X梁B1、Y梁B2，无刚性楼板。（本栏是编题规格，实际用户输入按图/表分工呈现。）",
      "task.modelingFocus": "平面中缺少一根实际横梁，侧载使该缺失影响空间约束。",
      "task.expectedOutput": "受侧力顶点Uy、缺梁两端节点相对Uy；附与数值一致的模型/结果图。",
      "task.gradingFocus": "模型核对：规则2×1跨顶层删除中间横梁，并新增横向侧力检验力路。；数值/表述核对：受侧力顶点Uy、缺梁两端节点相对Uy，位置、方向、单位须一致。",
      "task.prerequisite": "按本题拟定 YJK 独立重算并核验；本题新增几何/属性与真值均待独立核验；材料截面代号须在本题附录定值。按实际保留矩形楼面逐层分配面载，关闭自重与默认刚性楼板。",
      "model.topologyKey": "X网格0、6、12m，Y网格0、5m，两层z=3.6、7.2m；柱线完整，各层网格边梁齐全但顶层x=6m的Y梁缺失",
      "model.boundaryKey": "六底柱脚固定",
      "model.loadKey": "两层面载8kN/m²按X梁单向分配，顶层(12,5,7.2)m节点Fy=20kN",
      "model.propertyKey": "钢M1、柱C1、X梁B1、Y梁B2，无刚性楼板。",
      "engine.analysisContract": "一阶线弹性；自重OFF并保存配置；按附录实际E/A/I/J，不套默认刚度折减；无默认刚性楼板。原生工程须显式关闭自重、自动组合/地震及影响该契约的默认设置，导出配置核对。采用题定右手全局Z向上，核对构件局部轴与结果分量。面载仅传给实际X梁，受荷宽度为相邻实际楼面Y向半跨之和，Y梁不重复加载；等效线/节点载须同时保持合力和力矩。荷载契约：两层面载8kN/m²按X梁单向分配，顶层(12,5,7.2)m节点Fy=20kN；未指定组合时仅算题定基本荷载，指定组合逐组执行，不能用软件默认包络替换。",
      "engine.executionRequirement": "原生项目保留顶层缺横梁和20kN角点Y力，核对该层实际梁图；适配/回读通过后才纳入自动运行；执行后按原题完整输出：受侧力顶点Uy、缺梁两端节点相对Uy；附与数值一致的模型/结果图。本轮仅规划，不运行。",
      "engine.requiredEvidence": "计划保存输入PNG/DXF及图中构件/标签→计算节点/构件ID映射、YJK原生工程及接口导入/回读差异、引擎版本与设置快照、实际运行日志、原始结果表/观测点索引、可视图所用数据。",
      "engine.adapterGap": "当前YJK会按完整相邻梁网补梁，缺顶层Y梁无法保留；角点Fy点力不属于现有DL/LL楼面荷载接口，X/Y两类梁截面也超出现有单梁截面参数。",
      "engine.truthPlan": "由独立审阅的YJK原生工程形成同版本、同参数的参考结果；核对实际楼层/构件属性、题定荷载合力及力矩平衡，并保存受侧力顶点Uy、缺梁两端节点相对Uy的原始索引。原生人工参考模型不代表当前自动接口已接通。"
    },
