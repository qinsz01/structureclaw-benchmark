{
  "schemaVersion": 1,
  "evaluationProfile": "engineering-v2.3",
  "id": "MM-083",
  "modelId": "M-MM-083",
  "family": "multimodal_reverse_engineering",
  "language": "中文",
  "locale": "zh",
  "plannedEngine": "PKPM",
  "sourcePlan": {
    "sourceRequirements": {
      "task.inputForm": "新平面及正交立面/局部截面PNG共同给本题空间几何、连接与朝向；附录给明确约束、荷载向量、完整属性和视图轴约定，不直接给完整节点坐标答案。所有新附件待制作、盲审与验证。面载仅传给X梁，受荷宽度为实际相邻楼面Y向半跨之和；Y梁不重复加载，无默认刚性楼板。",
      "task.scenario": "几何：X网格0、6、12m，Y网格0、5m；首两层z=3.6、7.2m完整2×1跨，第三层z=10.8m仅保留X=0至6m的一跨，右侧两柱止于第二层；实际网格梁齐全；边界：六底柱脚固定；荷载：首两层面载12、顶层6kN/m²按X梁单向分配；属性：C30、柱500×500mm、梁300×600mm，无刚性楼板。（本栏是编题规格，实际用户输入按图/表分工呈现。）",
      "task.modelingFocus": "退台仅影响顶层右半，材料表与三层实际楼面分别关联。",
      "task.expectedOutput": "第三层(6,5,10.8)m节点Uz、右侧底柱轴力；附与数值一致的模型/结果图。",
      "task.gradingFocus": "模型核对：两层规则混凝土空间框架增加局部第三层，形成新的退台拓扑。；数值/表述核对：第三层(6,5,10.8)m节点Uz、右侧底柱轴力，位置、方向、单位须一致。",
      "task.prerequisite": "按本题拟定 PKPM 独立重算并核验；本题新增几何/属性与真值均待独立核验；材料截面代号须在本题附录定值。按实际保留矩形楼面逐层分配面载，关闭自重与默认刚性楼板。",
      "model.topologyKey": "X网格0、6、12m，Y网格0、5m；首两层z=3.6、7.2m完整2×1跨，第三层z=10.8m仅保留X=0至6m的一跨，右侧两柱止于第二层；实际网格梁齐全",
      "model.boundaryKey": "六底柱脚固定",
      "model.loadKey": "首两层面载12、顶层6kN/m²按X梁单向分配",
      "model.propertyKey": "C30、柱500×500mm、梁300×600mm，无刚性楼板。",
      "engine.analysisContract": "一阶线弹性；自重OFF并保存配置；按附录实际E/A/I/J，不套默认刚度折减；无默认刚性楼板。原生工程须显式关闭自重、自动组合/地震及影响该契约的默认设置，导出配置核对。采用题定右手全局Z向上，核对构件局部轴与结果分量。面载仅传给实际X梁，受荷宽度为相邻实际楼面Y向半跨之和，Y梁不重复加载；等效线/节点载须同时保持合力和力矩。荷载契约：首两层面载12、顶层6kN/m²按X梁单向分配；未指定组合时仅算题定基本荷载，指定组合逐组执行，不能用软件默认包络替换。",
      "engine.executionRequirement": "原生混凝土项目三层范围分别定义，保持顶层局部新增区域和逐层面载；建模/结果通道验证后再执行；执行后按原题完整输出：第三层(6,5,10.8)m节点Uz、右侧底柱轴力；附与数值一致的模型/结果图。本轮仅规划，不运行。",
      "engine.requiredEvidence": "计划保存输入PNG/DXF及图中构件/标签→计算节点/构件ID映射、PKPM原生工程及接口导入/回读差异、引擎版本与设置快照、实际运行日志、原始结果表/观测点索引、可视图所用数据。",
      "engine.adapterGap": "当前PKPM重复同一平面/拓扑，不能表达仅左侧一跨的第三层及停柱；须提供逐层模型和有效楼面分配，核对指定顶点位移与底柱轴力读取。",
      "engine.truthPlan": "由独立审阅的PKPM原生工程形成同版本、同参数的参考结果；核对实际楼层/构件属性、题定荷载合力及力矩平衡，并保存第三层(6,5,10.8)m节点Uz、右侧底柱轴力的原始索引。原生人工参考模型不代表当前自动接口已接通。"
    },
