    {
      "factId": "SRC-SPORT-2023-F1",
      "statement": "三层钢框架训练馆，建筑总高约23.4m；大跨楼盖跨度约38m，钢桁架总高约2.3m，楼板厚120mm。",
      "locator": "原文第1页 §1.1、图1.1-2"
    },
    {
      "factId": "SRC-SPORT-2023-F2",
      "statement": "原作者仅取单层大跨区域计算竖向振动：弦杆梁单元、腹杆斜杆，混凝土楼板平面内外刚度参与。",
      "locator": "原文第2–3页 §1.2"
    },
    {
      "factId": "SRC-SPORT-2023-F3",
      "statement": "原文舒适度模型阻尼0.06，场地人群荷载0.12kN/m²；它们不是一般承载力荷载参数。",
      "locator": "原文第3页 §1.2"
    }
  ],
  "subproblemProposals": [
    {
      "subproblemId": "SRC-SPORT-2023-P1",
      "description": "38m×2.3m单榀楼盖桁架：显式节间、等效节点重力，计算静力挠度/轴力。",
      "maxTaskVariants": 2
    },
    {
      "subproblemId": "SRC-SPORT-2023-P2",
      "description": "弦杆连续梁与双向腹杆混合的平面楼盖桁架：保持原文梁/斜杆差异，题设连接及受荷节点。",
      "maxTaskVariants": 2
    },
    {
      "subproblemId": "SRC-SPORT-2023-P3",
      "description": "相邻两榀桁架与横梁形成裸空间楼盖片：榀距/横梁参数为作者设定，给节点质量后仅做线性模态。",
      "maxTaskVariants": 2
    }
  ],
  "maxCases": 6,
  "authoredAssumptions": [
    "题面必须给定E、G、密度及A/Iy/Iz/J，不能由钢号或混凝土强度等级猜测；未逐项核实的截面为出题者设定。",
    "题面必须明确节点坐标、连接、约束及荷载/质量的归属；截取子结构的边界属于出题者理想化。",
    "线性动力题必须显式给定节点质量、阻尼和激励；原工程周期/舒适度/验算结论不能作为新模型真值。",
    "原文含楼板刚度；裸杆系删板后的周期不可与原文直接对比。榀距未在已读页面明确，必须标为题设。",
    "3层总高23.4m不能当成每层高；2.3m为桁架高度。"
  ],
  "excludedEffects": [
    "材料或几何非线性、屈曲、承载力及规范合规判断",
