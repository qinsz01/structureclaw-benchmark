{
  "schemaVersion": 1,
  "evaluationProfile": "engineering-v2.3",
  "id": "MM-089",
  "modelId": "M-MM-089",
  "family": "multimodal_reverse_engineering",
  "language": "中文",
  "locale": "zh",
  "plannedEngine": "PKPM",
  "sourcePlan": {
    "sourceRequirements": {
      "task.inputForm": "新PNG独占本题几何/连通/支座和构件或区域标签；荷载表给标签对应的力值/工况/组合，属性表给完整材料/截面；无另附完整节点坐标表绕过读图。所有新附件待制作、盲审与验证。",
      "task.scenario": "几何：X网格0、4、8、12m，Y网格0、5、10m，两层各3.6m，完整3×2跨梁柱网；边界：两根内柱底仅约束三向平移、释放旋转，其余底柱六自由度固定；荷载：各梁向下8kN/m，顶层远角Fx=20、Fy=10kN；属性：钢M1，角/边/内柱C1/C2/C3，Y梁B1、外排X梁B2、中央排X梁B3，无刚性楼板。（本栏是编题规格，实际用户输入按图/表分工呈现。）",
      "task.modelingFocus": "柱位置、支座类型和六种截面组同时由平面与表格规定。",
      "task.expectedOutput": "顶层远角Ux/Uy、两内柱底轴力；附与数值一致的模型/结果图。",
      "task.gradingFocus": "模型核对：2×2跨改为3×2跨并采用内柱铰基及中央排梁单独截面组。；数值/表述核对：顶层远角Ux/Uy、两内柱底轴力，位置、方向、单位须一致。",
      "task.prerequisite": "基础工具；本题新增几何/属性与真值均待独立核验；材料截面代号须在本题附录定值。",
      "model.topologyKey": "X网格0、4、8、12m，Y网格0、5、10m，两层各3.6m，完整3×2跨梁柱网",
      "model.boundaryKey": "两根内柱底仅约束三向平移、释放旋转，其余底柱六自由度固定",
      "model.loadKey": "各梁向下8kN/m，顶层远角Fx=20、Fy=10kN",
      "model.propertyKey": "钢M1，角/边/内柱C1/C2/C3，Y梁B1、外排X梁B2、中央排X梁B3，无刚性楼板。",
      "engine.analysisContract": "一阶线弹性；自重OFF并保存配置；按附录实际E/A/I/J，不套默认刚度折减；无默认刚性楼板。原生工程须显式关闭自重、自动组合/地震及影响该契约的默认设置，导出配置核对。采用题定右手全局Z向上，核对构件局部轴与结果分量。题给线载/点力/力矩按原位映射；如作等效节点加载，须保留原始分布荷载并采用与单元插值一致的等效荷载，核验跨内响应及合力/力矩，不用统一楼面载替代。荷载契约：各梁向下8kN/m，顶层远角Fx=20、Fy=10kN；未指定组合时仅算题定基本荷载，指定组合逐组执行，不能用软件默认包络替换。",
      "engine.executionRequirement": "原生项目保持六组截面与两内柱铰基，梁线载/角点侧力须原位录入；验证各组属性和轴力输出通道；执行后按原题完整输出：顶层远角Ux/Uy、两内柱底轴力；附与数值一致的模型/结果图。本轮仅规划，不运行。",
      "engine.requiredEvidence": "计划保存输入PNG/DXF及图中构件/标签→计算节点/构件ID映射、PKPM原生工程及接口导入/回读差异、引擎版本与设置快照、实际运行日志、原始结果表/观测点索引、可视图所用数据。",
      "engine.adapterGap": "当前PKPM主要接DL/LL楼面荷载，本题逐梁线载与角点Fx/Fy需要新映射；内柱三平移约束/转角释放、六组截面的原生字段与接口回读尚待验证，不得替换成统一固定柱脚或单组属性。",
      "engine.truthPlan": "由独立审阅的PKPM原生工程形成同版本、同参数的参考结果；核对实际楼层/构件属性、题定荷载合力及力矩平衡，并保存顶层远角Ux/Uy、两内柱底轴力的原始索引。原生人工参考模型不代表当前自动接口已接通。"
    },
