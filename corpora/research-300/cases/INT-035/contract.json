{
  "schemaVersion": 1,
  "evaluationProfile": "engineering-v2.3",
  "id": "INT-035",
  "modelId": "M-INT-035",
  "family": "interactive_robustness",
  "language": "中文",
  "locale": "zh",
  "plannedEngine": "OpenSees",
  "sourcePlan": {
    "task.inputForm": "文本2轮＋完整属性附件（仅暂缺项除外）",
    "task.scenario": "T1所用独立模型为M-INT-035（K形中点承受直接荷载的桁架）。T1给M-INT-035完整几何荷载，但一处K腹杆交点是否与竖杆相连未说明；T2明确共用中点节点连接。",
    "task.modelingFocus": "中间连接节点与局部荷载范围；荷载位置的独立状态保持",
    "task.expectedOutput": "x=6m竖杆中点的Ux/Uz，左支承反力及附表指定首根下弦/底边杆轴力；所有值附位置、方向、单位、工况及当前轮次；澄清前不编造数值。",
    "task.gradingFocus": "所有关联杆在同一中点连接；不当成跨越或只画点；左半区加载不变；中点9kN必须作用于真正共节点，不移到上弦。",
    "task.prerequisite": "机构与连通性需独立验证；逐轮状态与目标/非目标差异评测待实现",
    "model.topologyKey": "桁架；跨度18m、高3m、6节间",
    "model.boundaryKey": "左下节点铰，右下节点水平自由竖向滚支",
    "model.loadKey": "跨度18m、高3m、6节间，竖杆中点与K腹杆明确连接，仅左半上弦加载；除左半上弦荷载外，x=6m竖杆中点另施加向下9kN点力；左半上弦x=0/3/6/9m节点各向下8kN，其他上弦无此载。",
    "model.propertyKey": "各构件组完整A/Iy/Iz/J/G及E、nu记录；按本题附表逐字段给单位，不用模型默认值",
    "engine.analysisContract": "一阶线弹性静力；自重关闭；不自动施加刚性楼板/刚域、默认附加载或自动规范组合；严格保留题定约束、材料/截面完整属性、局部轴、荷载坐标与长度基准；单位逐字段明确。 各轮只执行明确修改，未被修改的字段保持；澄清内容按该轮生效。",
    "engine.executionRequirement": "计划使用OpenSees完成每个可计算轮次；模型/荷载/材料/约束改变后以当前状态新算；只改查询位置、单位或报告时可复用可追溯结果，若需新网格则重算；缺项未解决时不给虚构数值。",
    "engine.requiredEvidence": "逐轮输入与澄清记录、模型状态快照及前后字段差异；变更目标与未变字段核对；原始求解输入/工程、软件版本/设置、运行ID和成功日志、原始结果到节点/构件/工况的映射；结果绑定当前模型状态。核对目标：x=6m竖杆中点的Ux/Uz，左支承反力及附表指定首根下弦/底边杆轴力。",
    "engine.adapterGap": "未逐题验收；前置检查项：机构与连通性需独立验证，并核对拓扑缺项澄清后的模型更新和结果定位；不把一般OpenSees支持等同于当前StructureClaw已实现。",
    "engine.truthPlan": "各可计算轮次独立建立并复核OpenSees参考模型，勿复用被测建模/转换路径生成标答；状态改变后独立新算，纯查询沿用有效状态；用解析解（适用时）、整体平衡、刚度/单位/符号检查复核，复杂题再用独立实现或同假设第二求解器核验。"
  },
