{
  "schemaVersion": 1,
  "evaluationProfile": "engineering-v2.3",
  "id": "MM-061",
  "modelId": "M-MM-061",
  "family": "multimodal_reverse_engineering",
  "language": "中文",
  "locale": "zh",
  "plannedEngine": "OpenSees",
  "sourcePlan": {
    "sourceRequirements": {
      "task.inputForm": "新工程PNG的总图/局部详图给本题几何、连接、支承和荷载位置；图中构件索引关联完整属性表，正文不重述拓扑。所有新附件待制作、盲审与验证。",
      "task.scenario": "几何：两层框架，跨长4.5、7.5m，层高3.6、4.2m；边界：左柱脚铰、中柱脚固定、右柱脚仅竖向滚支；荷载：所有楼层梁向下10kN/m，顶层右节点Fx=20kN；属性：钢材M1、柱C1、梁B1。（本栏是编题规格，实际用户输入按图/表分工呈现。）",
      "task.modelingFocus": "三柱脚的不同图符不能用统一约束替代，右柱水平位移应可发生。",
      "task.expectedOutput": "顶层右节点Ux、右柱脚Ux及中柱底弯矩；附与数值一致的模型/结果图。",
      "task.gradingFocus": "模型核对：全固定柱脚改为铰/固/滚混合约束，侧向和重力传力均变化。；数值/表述核对：顶层右节点Ux、右柱脚Ux及中柱底弯矩，位置、方向、单位须一致。",
      "task.prerequisite": "基础工具；本题新增几何/属性与真值均待独立核验；材料截面代号须在本题附录定值。",
      "model.topologyKey": "两层框架，跨长4.5、7.5m，层高3.6、4.2m",
      "model.boundaryKey": "左柱脚铰、中柱脚固定、右柱脚仅竖向滚支",
      "model.loadKey": "所有楼层梁向下10kN/m，顶层右节点Fx=20kN",
      "model.propertyKey": "钢材M1、柱C1、梁B1。",
      "engine.analysisContract": "一阶线弹性；自重OFF并保存配置；按附录实际E/A/I/J，不套默认刚度折减；无默认刚性楼板。全局Z向上，核对XZ到求解器平面的映射及Ry符号。题给线载/点力/力矩按原位映射；如作等效节点加载，须保留原始分布荷载并采用与单元插值一致的等效荷载，核验跨内响应及合力/力矩，不用统一楼面载替代。荷载契约：所有楼层梁向下10kN/m，顶层右节点Fx=20kN；未指定组合时仅算题定基本荷载，指定组合逐组执行，不能用软件默认包络替换。",
      "engine.executionRequirement": "三个柱脚分别铰/固/竖滚，右柱脚Ux保持自由且输出可追溯；执行后按原题完整输出：顶层右节点Ux、右柱脚Ux及中柱底弯矩；附与数值一致的模型/结果图。本轮仅规划，不运行。",
      "engine.requiredEvidence": "计划保存输入PNG/DXF及图中构件/标签→计算节点/构件ID映射、可复现OpenSees输入模型、引擎版本与设置快照、实际运行日志、原始结果表/观测点索引、可视图所用数据。",
      "engine.adapterGap": "尚未确认本题可通过；接口/求解/读回预检重点：三个柱脚分别铰/固/竖滚，右柱脚Ux保持自由且输出可追溯。特殊单元、轴向、边界及组合均不因OpenSees原生支持而视作已接通。",
      "engine.truthPlan": "独立建立并复核OpenSees参考模型，固定版本/求解设置及观测位置；以独立模型审阅、整体平衡及构件端力/节点结果一致性校核。不把展示层插值或图像读数直接当数值真值。"
    },
