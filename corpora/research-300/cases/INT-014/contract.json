{
  "schemaVersion": 1,
  "evaluationProfile": "engineering-v2.3",
  "id": "INT-014",
  "modelId": "M-INT-014",
  "family": "interactive_robustness",
  "language": "英文",
  "locale": "en",
  "plannedEngine": "OpenSees",
  "sourcePlan": {
    "task.inputForm": "文本3轮＋完整属性附件（仅暂缺项除外）",
    "task.scenario": "T1所用独立模型为M-INT-014（材料分段梁带端部力矩）。T1给M-INT-014但x=4～10m同时引用M1和M2；T2确认该段M2且0～4m为M1；T3把x=6m的25kN改35kN。",
    "task.modelingFocus": "材料、分段、点载和加载区间需联合映射；荷载类型的独立状态保持",
    "task.expectedOutput": "x=5m的Uz及右支座Rz；所有值附位置、方向、单位、工况及当前轮次；澄清前不编造数值。",
    "task.gradingFocus": "材料分区只在4m换；均布区仍2～8m；只替换点力大小，不累加；右端-8kN·m力矩始终保持。",
    "task.prerequisite": "基础工具；节点力矩输入需验证；逐轮状态与目标/非目标差异评测待实现",
    "model.topologyKey": "梁；跨度10m",
    "model.boundaryKey": "x=0铰、x=10m滚支",
    "model.loadKey": "跨度10m，x=4m处分材料组，x=2至8m向下9kN/m，x=6m处25kN；右端节点另施加全局Y负向8kN·m，主均布区和x=6m点力保持",
    "model.propertyKey": "各构件组完整A/Iy/Iz/J/G及E、nu记录；按本题附表逐字段给单位，不用模型默认值",
    "engine.analysisContract": "一阶线弹性静力；自重关闭；不自动施加刚性楼板/刚域、默认附加载或自动规范组合；严格保留题定约束、材料/截面完整属性、局部轴、荷载坐标与长度基准；单位逐字段明确。 各轮只执行明确修改，未被修改的字段保持；澄清内容按该轮生效。",
    "engine.executionRequirement": "计划使用OpenSees完成每个可计算轮次；模型/荷载/材料/约束改变后以当前状态新算；只改查询位置、单位或报告时可复用可追溯结果，若需新网格则重算；缺项未解决时不给虚构数值。",
    "engine.requiredEvidence": "逐轮输入与澄清记录、模型状态快照及前后字段差异；变更目标与未变字段核对；原始求解输入/工程、软件版本/设置、运行ID和成功日志、原始结果到节点/构件/工况的映射；结果绑定当前模型状态。核对目标：x=5m的Uz及右支座Rz。",
    "engine.adapterGap": "未逐题验收；前置检查项：基础工具；节点力矩输入需验证，并核对冲突解决加复合更新后的模型更新和结果定位；不把一般OpenSees支持等同于当前StructureClaw已实现。",
    "engine.truthPlan": "各可计算轮次独立建立并复核OpenSees参考模型，勿复用被测建模/转换路径生成标答；状态改变后独立新算，纯查询沿用有效状态；用解析解（适用时）、整体平衡、刚度/单位/符号检查复核，复杂题再用独立实现或同假设第二求解器核验。"
  },
