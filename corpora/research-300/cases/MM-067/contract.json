{
  "schemaVersion": 1,
  "evaluationProfile": "engineering-v2.3",
  "id": "MM-067",
  "modelId": "M-MM-067",
  "family": "multimodal_reverse_engineering",
  "language": "中文",
  "locale": "zh",
  "plannedEngine": "OpenSees",
  "sourcePlan": {
    "sourceRequirements": {
      "task.inputForm": "新结构DXF的实体、尺寸及连接符号给本题几何/拓扑/支座；荷载标注或区域标签关联载荷表；完整属性另附，源单位与坐标映射显式给定。所有新附件待制作、盲审与验证。",
      "task.scenario": "几何：两层总高7.2m、两跨各5m；底层只有x=0、10m两柱，z=3.6m为10m连续转换梁；上层在x=0、5、10m设三柱并与顶梁连接；边界：底两柱脚固定，转换梁中点与上中柱刚接；荷载：两层实际梁均向下10kN/m；属性：M1、柱C1、普通梁B1、转换梁B2。（本栏是编题规格，实际用户输入按图/表分工呈现。）",
      "task.modelingFocus": "中柱只出现在上层，不能把它向下延伸成不存在的基础柱。",
      "task.expectedOutput": "转换梁中点Uz、上层中柱轴力；附与数值一致的模型/结果图。",
      "task.gradingFocus": "模型核对：缺上层中柱改为缺下层中柱，形成上柱通过转换梁传力的拓扑。；数值/表述核对：转换梁中点Uz、上层中柱轴力，位置、方向、单位须一致。",
      "task.prerequisite": "机构与连通性需独立验证；本题新增几何/属性与真值均待独立核验；材料截面代号须在本题附录定值。",
      "model.topologyKey": "两层总高7.2m、两跨各5m；底层只有x=0、10m两柱，z=3.6m为10m连续转换梁；上层在x=0、5、10m设三柱并与顶梁连接",
      "model.boundaryKey": "底两柱脚固定，转换梁中点与上中柱刚接",
      "model.loadKey": "两层实际梁均向下10kN/m",
      "model.propertyKey": "M1、柱C1、普通梁B1、转换梁B2。",
      "engine.analysisContract": "一阶线弹性；自重OFF并保存配置；按附录实际E/A/I/J，不套默认刚度折减；无默认刚性楼板。全局Z向上，核对XZ到求解器平面的映射及Ry符号。题给线载/点力/力矩按原位映射；如作等效节点加载，须保留原始分布荷载并采用与单元插值一致的等效荷载，核验跨内响应及合力/力矩，不用统一楼面载替代。荷载契约：两层实际梁均向下10kN/m；未指定组合时仅算题定基本荷载，指定组合逐组执行，不能用软件默认包络替换。",
      "engine.executionRequirement": "转换梁中点接上层中柱而不向下延伸，先查连通与机构；执行后按原题完整输出：转换梁中点Uz、上层中柱轴力；附与数值一致的模型/结果图。本轮仅规划，不运行。",
      "engine.requiredEvidence": "计划保存输入PNG/DXF及图中构件/标签→计算节点/构件ID映射、可复现OpenSees输入模型、引擎版本与设置快照、实际运行日志、原始结果表/观测点索引、可视图所用数据。",
      "engine.adapterGap": "尚未确认本题可通过；接口/求解/读回预检重点：转换梁中点接上层中柱而不向下延伸，先查连通与机构。特殊单元、轴向、边界及组合均不因OpenSees原生支持而视作已接通。",
      "engine.truthPlan": "独立建立并复核OpenSees参考模型，固定版本/求解设置及观测位置；以独立模型审阅、整体平衡及构件端力/节点结果一致性校核。不把展示层插值或图像读数直接当数值真值。"
    },
