  "plannedEngine": "OpenSees",
  "sourcePlan": {
    "task.inputForm": "完整文字任务 + 随题分析属性表（待编制）",
    "task.scenario": "跨度20m、高3m、5节间，上下弦和腹杆分别给A1/A2/A3，分节点加载；完整属性按公共契约随题给出。 上弦A1、下弦A2、腹杆A3逐项给值；四个内部上弦节点按8/12/16/10kN加载。",
    "task.modelingFocus": "构件组属性与拓扑荷载联合映射",
    "task.expectedOutput": "受载点位移、各组代表杆及全杆轴力、支反力，附组别索引。",
    "task.gradingFocus": "构件组属性与拓扑荷载联合映射；指定位置/分量对照数值真值，输出文字与结构化结果保持符号、单位和工况一致。",
    "task.prerequisite": "基础工具；完整题面、参数/单位契约与真值待验证",
    "model.topologyKey": "平行弦桁架；五节间；完整节点杆表",
    "model.boundaryKey": "左下铰右下X向自由滚支",
    "model.loadKey": "四个内部上弦节点不等竖载",
    "model.propertyKey": "上弦A1下弦A2腹杆A3",
    "engine.analysisContract": "保留题定几何、材料截面、边界和荷载；采用一阶线弹性静力、自重关闭。按明示全局/局部轴、字段单位及工况/组合计算；不新增刚性楼板、未声明刚臂或规范默认组合；结果位置/分量与原题一致。 采用仅轴力杆件，交叉是否连接按端点表；不把铰接杆改为刚接梁。",
    "engine.executionRequirement": "拟要求真实 OpenSees 求解，保存输入与原始结果的对应关系；解析式/独立矩阵解用于校核，不能替代规定引擎执行证据。",
    "engine.requiredEvidence": "拟保存（尚未生成）：OpenSees 版本、可运行模型/脚本、节点构件和荷载表、实际计算日志、原始结果与工况索引、平衡/独立解校核记录。",
    "engine.adapterGap": "逐杆 EA 及材料/截面组映射须验证。 当前无据认定接口不支持；需实际能力测试后确定，不将未验证能力记为模型失败。",
    "engine.truthPlan": "拟建立独立审定的 OpenSees 模型及同版本/同设置参考结果；独立杆系刚度法使用逐杆EA；单位荷载法抽查位移并核查全节点平衡。 参考值尚未生成。 所有题定输出均须覆盖，校核实现不复用被测转换链路。"
  },
  "modelStates": [
    "model-state-1.json"
  ],
  "attachments": [
    "geometry.json",
    "properties.json",
    "loads.json",
    "output-requests.json"
  ],
  "turns": [
    {
      "id": "t1",
      "instruction": "按附件节点、杆件与截面指派表建立跨度20 m、高3 m、五个4 m节间的平行弦桁架。上弦TC1至TC5统一用A1=0.012 m²，下弦BC1至BC5用A2=0.010 m²，全部竖杆V0至V5与斜杆D1至D5用A3=0.006 m²。B0铰支，B5为X向自由滚支。内部上弦T1、T2、T3、T4依次向下8、12、16、10 kN。所有杆件仅传轴力并可受拉压，用OpenSees进行一阶线弹性静力分析，自重关闭。输出LC1下四个受载点ux、uz、全部21根杆轴力N及两支座Fx、Fz；另标出三组代表杆TC3、BC3、D3的轴力与组别。附完整组别索引，明确每根杆的截面组、A值与材料。位移用m，力用kN，N受拉为正。\n\n属性附表将每个给定面积A补齐为边长sqrt(A)的实心正方形截面，Iy=Iz=A²/12，J=0.14083333333333334 A²。这些截面参数为明确编制的附录数据；全部构件仍为仅轴力桁架杆，弯曲和扭转常数不参与本题计算，轴向刚度仍为EA。\n\n完整输入见附件。全局XYZ为右手系，Z向上；平面结构位于XZ面。表列节点均为实际连通节点。构件局部x由i端指向j端；二维局部y为全局+Y，局部z=x×y；三维局部y=归一化(reference×x)，局部z=x×y，参考向量逐杆给出。N拉为正；截面N/T/M2/M3在i端取节点抵抗力的负值，在j端取正值；V2/V3在i端取正值、j端取负值。节点位移和支反力按全局分量，转角服从右手定则。线载按构件实际长度计，斜杆亦然。一阶线弹性，自重、刚性楼板、刚域、二阶和施工阶段关闭；仅使用题定工况及组合。逐项完成output-requests.json中所有请求，保留位置、截面侧别、正负号、分量、单位、工况/组合。跨内内力恢复须计入荷载项。实际运行OpenSees，保留版本、可运行输入、当前模型哈希、运行ID、实际求解日志及原始结果/工况对应关系。正文和结构化结果均须给出题定结果，并独立检查平衡。附件不提供数值答案或原生执行证据。",
      "state": 1,
      "expectation": "analyze",
      "attachments": [
        "geometry.json",
        "properties.json",
        "loads.json",
        "output-requests.json"
      ],
      "unresolvedFields": [],
      "expectedQuestions": []
    }
  ],
