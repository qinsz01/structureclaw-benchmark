  "turns": [
    {
      "id": "t1",
      "instruction": "Required solver: OpenSees.\nBuild and analyze the attached two-story, two-bay steel frame in OpenSees. Both bays are 6 m and both stories are 3.6 m high; all three bases are fixed. On both stories, exterior columns use C1, the middle column uses C2, left-bay beams use B1 and right-bay beams use B2. In case D, every beam carries 8 kN/m downward and the upper-right joint carries 25 kN in +X. Report N/V3/M2 at both ends of c0-1, c1-1, b0-1 and b1-1 as the four section-group representatives; Δux and Δuz (upper minus lower) for both stories along every column line; all base Fx/Fz/My; and the complete member/section assignment table. Use the explicit appendix properties and axes for first-order linear elastic static analysis with self-weight disabled.\n\nUse all public appendices. Report the complete requested numerical table and the required summaries.",
      "state": 1,
      "expectation": "analyze",
      "attachments": [
        "input-data.json",
        "output-requests.json",
        "analysis-conventions.txt",
        "output-scope.json",
        "appendix-decisions.txt"
      ],
      "unresolvedFields": [],
      "expectedQuestions": []
    }
  ],
