  "family": "standard_workflow",
  "language": "英文",
  "locale": "en",
  "plannedEngine": "OpenSees",
  "sourcePlan": {
    "task.inputForm": "完整文字任务 + 随题分析属性表（待编制）",
    "task.scenario": "两层两跨6m，边柱中柱两类截面，左梁右梁两类截面，侧载与竖载；完整属性按公共契约随题给出。 层高各3.6m，边柱C1中柱C2，左梁B1右梁B2；所有梁8kN/m，顶层右节点X向25kN。",
    "task.modelingFocus": "成员组和属性表对应关系",
    "task.expectedOutput": "每组代表构件端力、各柱线层间位移差及柱脚反力，附成员/截面对照。",
    "task.gradingFocus": "成员组和属性表对应关系；指定位置/分量对照数值真值，输出文字与结构化结果保持符号、单位和工况一致。",
    "task.prerequisite": "基础工具；完整题面、参数/单位契约与真值待验证",
    "model.topologyKey": "平面两层两等跨钢框架",
    "model.boundaryKey": "全部柱脚固定",
    "model.loadKey": "各梁均布竖载加顶右侧力",
    "model.propertyKey": "边柱/中柱/左梁/右梁四截面组",
    "engine.analysisContract": "保留题定几何、材料截面、边界和荷载；采用一阶线弹性静力、自重关闭。按明示全局/局部轴、字段单位及工况/组合计算；不新增刚性楼板、未声明刚臂或规范默认组合；结果位置/分量与原题一致。",
    "engine.executionRequirement": "拟要求真实 OpenSees 求解，保存输入与原始结果的对应关系；解析式/独立矩阵解用于校核，不能替代规定引擎执行证据。",
    "engine.requiredEvidence": "拟保存（尚未生成）：OpenSees 版本、可运行模型/脚本、节点构件和荷载表、实际计算日志、原始结果与工况索引、平衡/独立解校核记录。",
    "engine.adapterGap": "边柱/中柱与左梁/右梁多组属性交叉映射须验收。 当前无据认定接口不支持；需实际能力测试后确定，不将未验证能力记为模型失败。",
    "engine.truthPlan": "拟建立独立审定的 OpenSees 模型及同版本/同设置参考结果；独立逐成员EA/EI组装；分组审计、节点平衡与整体平衡复核。 参考值尚未生成。 所有题定输出均须覆盖，校核实现不复用被测转换链路。"
  },
