{
  "schemaVersion": 1,
  "evaluationProfile": "engineering-v2.3",
  "id": "INT-041",
  "modelId": "M-INT-041",
  "family": "interactive_robustness",
  "language": "中文",
  "locale": "zh",
  "plannedEngine": "OpenSees",
  "sourcePlan": {
    "task.inputForm": "文本2轮＋完整属性附件（仅暂缺项除外）",
    "task.scenario": "T1所用独立模型为M-INT-041（一根斜杆加强的偏心方锥）。T1给M-INT-041但把顶点一项20kN标为水平未说X或Y；T2确认全局X正向，另一项全局Z负向30kN。",
    "task.modelingFocus": "偏心空间几何和三向力分量；截面分组的独立状态保持",
    "task.expectedOutput": "顶点(2,3,3)m的Ux/Uz/Uy，左支承反力及附表指定首根下弦/底边杆轴力；所有值附位置、方向、单位、工况及当前轮次；澄清前不编造数值。",
    "task.gradingFocus": "保持偏心顶点和四底固定；不能把20kN平均分给X/Y；杆系按表；偏心顶点及指定斜杆加强保持，双向荷载按全局分量。",
    "task.prerequisite": "空间桁架及独立真值需验证；逐轮状态与目标/非目标差异评测待实现",
    "model.topologyKey": "桁架；底面6m×6m",
    "model.boundaryKey": "四底点XYZ固定，顶点自由",
    "model.loadKey": "底面6m×6m，顶点偏离中心，高3m，底边杆加四斜杆，四底节点固定，顶点双向荷载；顶点Fx=20kN、Fz=-30kN；各底点三平移约束。",
    "model.propertyKey": "底四角(0,0,0)/(6,0,0)/(6,6,0)/(0,6,0)m，顶点(2,3,3)m；顶点至底角(6,6,0)m的斜杆面积2A，其余底边及斜杆A",
    "engine.analysisContract": "一阶线弹性静力；自重关闭；不自动施加刚性楼板/刚域、默认附加载或自动规范组合；严格保留题定约束、材料/截面完整属性、局部轴、荷载坐标与长度基准；单位逐字段明确。 保留三维六自由度/轴力单元各自约束和题定局部轴；各轮只执行明确修改，未被修改的字段保持；澄清内容按该轮生效。",
    "engine.executionRequirement": "计划使用OpenSees完成每个可计算轮次；模型/荷载/材料/约束改变后以当前状态新算；只改查询位置、单位或报告时可复用可追溯结果，若需新网格则重算；缺项未解决时不给虚构数值。",
    "engine.requiredEvidence": "逐轮输入与澄清记录、模型状态快照及前后字段差异；变更目标与未变字段核对；原始求解输入/工程、软件版本/设置、运行ID和成功日志、原始结果到节点/构件/工况的映射；结果绑定当前模型状态。核对目标：顶点(2,3,3)m的Ux/Uz/Uy，左支承反力及附表指定首根下弦/底边杆轴力。",
    "engine.adapterGap": "未逐题验收；前置检查项：空间桁架及独立真值需验证，并核对空间分量澄清后的模型更新和结果定位；不把一般OpenSees支持等同于当前StructureClaw已实现。",
    "engine.truthPlan": "各可计算轮次独立建立并复核OpenSees参考模型，勿复用被测建模/转换路径生成标答；状态改变后独立新算，纯查询沿用有效状态；用解析解（适用时）、整体平衡、刚度/单位/符号检查复核，复杂题再用独立实现或同假设第二求解器核验。"
  },
