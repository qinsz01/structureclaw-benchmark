{
  "schemaVersion": 1,
  "evaluationProfile": "engineering-v2.3",
  "id": "MM-051",
  "modelId": "M-MM-051",
  "family": "multimodal_reverse_engineering",
  "language": "中文",
  "locale": "zh",
  "plannedEngine": "OpenSees",
  "sourcePlan": {
    "sourceRequirements": {
      "task.inputForm": "新PNG独占本题几何/连通/支座和构件或区域标签；荷载表给标签对应的力值/工况/组合，属性表给完整材料/截面；无另附完整节点坐标表绕过读图。所有新附件待制作、盲审与验证。",
      "task.scenario": "几何：18m跨、6m檐高、7.5m屋脊高双坡门架；右坡越过右柱继续同坡度外伸2m至x=20m；边界：两柱脚固定，屋脊刚接；荷载：D全屋面按实际长度向下6kN/m，W仅右侧2m外伸段向上10kN/m；组合D、D+W；属性：柱C1、屋面B1，材料M1。（本栏是编题规格，实际用户输入按图/表分工呈现。）",
      "task.modelingFocus": "风区仅覆盖越过柱顶的外伸段，和整个右坡不同。",
      "task.expectedOutput": "右自由檐端Uz、右柱脚反力的两组合值；附与数值一致的模型/结果图。",
      "task.gradingFocus": "模型核对：新增右檐外伸梁，将上拔工况改为外伸段局部风吸。；数值/表述核对：右自由檐端Uz、右柱脚反力的两组合值，位置、方向、单位须一致。",
      "task.prerequisite": "斜杆荷载与多组合需验证；本题新增几何/属性与真值均待独立核验；材料截面代号须在本题附录定值。斜杆全局荷载和局部轴适配待验证。",
      "model.topologyKey": "18m跨、6m檐高、7.5m屋脊高双坡门架；右坡越过右柱继续同坡度外伸2m至x=20m",
      "model.boundaryKey": "两柱脚固定，屋脊刚接",
      "model.loadKey": "D全屋面按实际长度向下6kN/m，W仅右侧2m外伸段向上10kN/m；组合D、D+W",
      "model.propertyKey": "柱C1、屋面B1，材料M1。",
      "engine.analysisContract": "一阶线弹性；自重OFF并保存配置；按附录实际E/A/I/J，不套默认刚度折减；无默认刚性楼板。全局Z向上，核对XZ到求解器平面的映射及Ry符号。题给线载/点力/力矩按原位映射；如作等效节点加载，须保留原始分布荷载并采用与单元插值一致的等效荷载，核验跨内响应及合力/力矩，不用统一楼面载替代。荷载契约：D全屋面按实际长度向下6kN/m，W仅右侧2m外伸段向上10kN/m；组合D、D+W；未指定组合时仅算题定基本荷载，指定组合逐组执行，不能用软件默认包络替换。",
      "engine.executionRequirement": "右柱外2m仍为真实坡梁；W只作用外伸段，D及D+W分别执行；执行后按原题完整输出：右自由檐端Uz、右柱脚反力的两组合值；附与数值一致的模型/结果图。本轮仅规划，不运行。",
      "engine.requiredEvidence": "计划保存输入PNG/DXF及图中构件/标签→计算节点/构件ID映射、可复现OpenSees输入模型、引擎版本与设置快照、实际运行日志、原始结果表/观测点索引、可视图所用数据。",
      "engine.adapterGap": "尚未确认本题可通过；接口/求解/读回预检重点：右柱外2m仍为真实坡梁；W只作用外伸段，D及D+W分别执行。特殊单元、轴向、边界及组合均不因OpenSees原生支持而视作已接通。",
      "engine.truthPlan": "独立建立并复核OpenSees参考模型，固定版本/求解设置及观测位置；以独立模型审阅、整体平衡及构件端力/节点结果一致性校核。不把展示层插值或图像读数直接当数值真值。"
    },
