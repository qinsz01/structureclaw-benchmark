  "plannedEngine": "OpenSees",
  "sourcePlan": {
    "task.inputForm": "完整文字任务 + 随题分析属性表（待编制）",
    "task.scenario": "给源坐标Y向上与到全局Z向上的明确映射，非等跨两层，荷载向量按源轴给定；完整属性按公共契约随题给出。 源Y向上，明示映射全局(X,Y,Z)=(源X,-源Z,源Y)；源水平跨6+4m与5m，两层3/4m，载荷作用于源坐标(10,7,5)m顶角，力向量源(20,-30,10)kN。",
    "task.modelingFocus": "几何、约束和荷载必须一致变换",
    "task.expectedOutput": "指定顶角的源/全局位移分量、全局支反力与代表杆端力；附变换后的坐标和载荷表。",
    "task.gradingFocus": "几何、约束和荷载必须一致变换；指定位置/分量对照数值真值，输出文字与结构化结果保持符号、单位和工况一致。",
    "task.prerequisite": "坐标转换协议需验证；完整题面、参数/单位契约与真值待验证",
    "model.topologyKey": "空间两层X两不等跨Y一跨；源Y向上坐标",
    "model.boundaryKey": "柱脚全固定；约束方向同坐标正交变换",
    "model.loadKey": "源坐标(10,7,5)m顶角施加源力向量(20,-30,10)kN并变换到全局",
    "model.propertyKey": "单钢材料；截面局部轴随坐标变换",
    "engine.analysisContract": "保留题定几何、材料截面、边界和荷载；采用一阶线弹性静力、自重关闭。按明示全局/局部轴、字段单位及工况/组合计算；不新增刚性楼板、未声明刚臂或规范默认组合；结果位置/分量与原题一致。",
    "engine.executionRequirement": "拟要求真实 OpenSees 求解，保存输入与原始结果的对应关系；解析式/独立矩阵解用于校核，不能替代规定引擎执行证据。",
    "engine.requiredEvidence": "拟保存（尚未生成）：OpenSees 版本、可运行模型/脚本、节点构件和荷载表、实际计算日志、原始结果与工况索引、平衡/独立解校核记录。",
    "engine.adapterGap": "源到全局右手正交变换须同时作用于坐标、约束、力与结果，不能仅旋转几何。 当前无据认定接口不支持；需实际能力测试后确定，不将未验证能力记为模型失败。",
    "engine.truthPlan": "拟建立独立审定的 OpenSees 模型及同版本/同设置参考结果；以两套坐标独立建立同物理框架；比对经正交变换后的位移/反力和空间平衡。 参考值尚未生成。 所有题定输出均须覆盖，校核实现不复用被测转换链路。"
  },
