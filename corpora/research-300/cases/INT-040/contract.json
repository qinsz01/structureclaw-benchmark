{
  "schemaVersion": 1,
  "evaluationProfile": "engineering-v2.3",
  "id": "INT-040",
  "modelId": "M-INT-040",
  "family": "interactive_robustness",
  "language": "英文",
  "locale": "en",
  "plannedEngine": "OpenSees",
  "sourcePlan": {
    "task.inputForm": "文本2轮＋完整属性附件（仅暂缺项除外）",
    "task.scenario": "T1给独立模型M-INT-040：A的XYZ固定，B的Z固定但Y约束字段空缺，C的Z固定，未列方向自由；不声明总约束数；T2确认B的Y固定，补齐后分析。",
    "task.modelingFocus": "空间杆连接与消除刚体运动约束；截面分组的独立状态保持",
    "task.expectedOutput": "顶点D的Ux/Uz/Uy，左支承反力及附表指定首根下弦/底边杆轴力；所有值附位置、方向、单位、工况及当前轮次；澄清前不编造数值。",
    "task.gradingFocus": "共六项独立平移约束，不自动全固定三底点；T1只补问B的Y约束；独立核验无刚体运动，顶点力保持；AD加强杆保持；约束仍按指定六项而非全底面固定；若已有信息可唯一推得缺项，接受说明依据后直接完成，否则再澄清。",
    "task.prerequisite": "空间桁架及独立真值需验证；逐轮状态与目标/非目标差异评测待实现",
    "model.topologyKey": "桁架；四节点六杆",
    "model.boundaryKey": "A约束XYZ、B约束YZ、C约束Z，三转动不属桁架自由度",
    "model.loadKey": "四节点六杆，底面边长4m、顶高3m，支承采用明确六个独立约束，顶点竖向力",
    "model.propertyKey": "底面A=(0,0,0)、B=(4,0,0)、C=(2,2√3,0)m，顶点D=(2,2√3/3,3)m；AD面积1.5A，其余五杆A；顶点向下20kN",
    "engine.analysisContract": "一阶线弹性静力；自重关闭；不自动施加刚性楼板/刚域、默认附加载或自动规范组合；严格保留题定约束、材料/截面完整属性、局部轴、荷载坐标与长度基准；单位逐字段明确。 保留三维六自由度/轴力单元各自约束和题定局部轴；各轮只执行明确修改，未被修改的字段保持；澄清内容按该轮生效。",
    "engine.executionRequirement": "计划使用OpenSees完成每个可计算轮次；模型/荷载/材料/约束改变后以当前状态新算；只改查询位置、单位或报告时可复用可追溯结果，若需新网格则重算；缺项未解决时不给虚构数值。",
    "engine.requiredEvidence": "逐轮输入与澄清记录、模型状态快照及前后字段差异；变更目标与未变字段核对；原始求解输入/工程、软件版本/设置、运行ID和成功日志、原始结果到节点/构件/工况的映射；结果绑定当前模型状态。核对目标：顶点D的Ux/Uz/Uy，左支承反力及附表指定首根下弦/底边杆轴力。",
    "engine.adapterGap": "未逐题验收；前置检查项：空间桁架及独立真值需验证，并核对空间边界缺项澄清后的模型更新和结果定位；不把一般OpenSees支持等同于当前StructureClaw已实现。",
    "engine.truthPlan": "各可计算轮次独立建立并复核OpenSees参考模型，勿复用被测建模/转换路径生成标答；状态改变后独立新算，纯查询沿用有效状态；用解析解（适用时）、整体平衡、刚度/单位/符号检查复核，复杂题再用独立实现或同假设第二求解器核验。"
  },
