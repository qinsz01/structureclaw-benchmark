  "plannedEngine": "OpenSees",
  "sourcePlan": {
    "task.inputForm": "完整文字任务 + 随题分析属性表（待编制）",
    "task.scenario": "节间2、3、4、3m，高2.2m，显式节点表，上弦不等节点荷载；完整属性按公共契约随题给出。 下弦x=0/2/5/9/12m；内部上弦在x=2/5/9m分别向下10/18/12kN。",
    "task.modelingFocus": "不等节间坐标累加和载荷对应",
    "task.expectedOutput": "三个受载点位移、各弦杆/斜杆轴力及支反力。",
    "task.gradingFocus": "不等节间坐标累加和载荷对应；指定位置/分量对照数值真值，输出文字与结构化结果保持符号、单位和工况一致。",
    "task.prerequisite": "基础工具；完整题面、参数/单位契约与真值待验证",
    "model.topologyKey": "平行弦桁架；四个不等节间；给定连接表",
    "model.boundaryKey": "左下铰右下X向自由滚支",
    "model.loadKey": "三个内部上弦节点不等竖载",
    "model.propertyKey": "单材料单面积；全部轴力杆",
    "engine.analysisContract": "保留题定几何、材料截面、边界和荷载；采用一阶线弹性静力、自重关闭。按明示全局/局部轴、字段单位及工况/组合计算；不新增刚性楼板、未声明刚臂或规范默认组合；结果位置/分量与原题一致。 采用仅轴力杆件，交叉是否连接按端点表；不把铰接杆改为刚接梁。",
    "engine.executionRequirement": "拟要求真实 OpenSees 求解，保存输入与原始结果的对应关系；解析式/独立矩阵解用于校核，不能替代规定引擎执行证据。",
    "engine.requiredEvidence": "拟保存（尚未生成）：OpenSees 版本、可运行模型/脚本、节点构件和荷载表、实际计算日志、原始结果与工况索引、平衡/独立解校核记录。",
    "engine.adapterGap": "逐题核验不等节间坐标累加和载荷对应；输入、结果分量/位置及数值标答尚未完成验收。 当前无据认定接口不支持；需实际能力测试后确定，不将未验证能力记为模型失败。",
    "engine.truthPlan": "拟建立独立审定的 OpenSees 模型及同版本/同设置参考结果；独立桁架矩阵解；荷载合力及作用点力矩校验，节点平衡复核。 参考值尚未生成。 所有题定输出均须覆盖，校核实现不复用被测转换链路。"
  },
