  "sourcePlan": {
    "task.inputForm": "完整文字任务 + 随题分析属性表（待编制）",
    "task.scenario": "三层单跨6m，D各层不同，W+与W-独立，题定三组组合；完整属性按公共契约随题给出。 三层均3.3m，D各层12/10/8kN/m；W+右侧各层X向10/15/20kN，W-相反；C0=D、C±=D+W±。",
    "task.modelingFocus": "正反向工况不能被绝对值化",
    "task.expectedOutput": "三组合各柱线侧移/层间位移差、柱脚反力及底层柱端弯矩。",
    "task.gradingFocus": "正反向工况不能被绝对值化；指定位置/分量对照数值真值，输出文字与结构化结果保持符号、单位和工况一致。",
    "task.prerequisite": "多组合执行契约需验证；完整题面、参数/单位契约与真值待验证",
    "model.topologyKey": "平面三层单跨混凝土框架",
    "model.boundaryKey": "全部柱脚固定",
    "model.loadKey": "D分层不同；W+与W-逐层侧力；三组合",
    "model.propertyKey": "混凝土材料；梁柱分组截面",
    "engine.analysisContract": "保留题定几何、材料截面、边界和荷载；采用一阶线弹性静力、自重关闭。按明示全局/局部轴、字段单位及工况/组合计算；不新增刚性楼板、未声明刚臂或规范默认组合；结果位置/分量与原题一致。",
    "engine.executionRequirement": "拟要求真实 OpenSees 求解，保存输入与原始结果的对应关系；解析式/独立矩阵解用于校核，不能替代规定引擎执行证据。",
    "engine.requiredEvidence": "拟保存（尚未生成）：OpenSees 版本、可运行模型/脚本、节点构件和荷载表、实际计算日志、原始结果与工况索引、平衡/独立解校核记录。",
    "engine.adapterGap": "W+、W- 与 C± 保留正负号，组合及控制结果索引须验证。 当前无据认定接口不支持；需实际能力测试后确定，不将未验证能力记为模型失败。",
    "engine.truthPlan": "拟建立独立审定的 OpenSees 模型及同版本/同设置参考结果；独立D/W解并叠加；核验C+与C-平均为D、差值为2W的线性关系。 参考值尚未生成。 所有题定输出均须覆盖，校核实现不复用被测转换链路。"
