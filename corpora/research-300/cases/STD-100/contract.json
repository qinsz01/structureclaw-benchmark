  "plannedEngine": "OpenSees",
  "sourcePlan": {
    "task.inputForm": "完整文字任务 + 随题分析属性表（待编制）",
    "task.scenario": "柱高5m，柱顶沿X向刚接1m短梁，短梁端向下200kN及Y向10kN；完整属性按公共契约随题给出。 柱顶(0,0,5)m与臂端(1,0,5)m真实刚接，柱和短梁各给A/I/J；臂端受(0,10,-200)kN。",
    "task.modelingFocus": "真实偏心几何与空间荷载，不用未声明刚臂简化",
    "task.expectedOutput": "臂端三向位移/转角、柱顶转角、柱底六分量反力和梁柱端力。",
    "task.gradingFocus": "真实偏心几何与空间荷载，不用未声明刚臂简化；指定位置/分量对照数值真值，输出文字与结构化结果保持符号、单位和工况一致。",
    "task.prerequisite": "空间梁柱连接需验证；完整题面、参数/单位契约与真值待验证；扭转刚度J及六分量端力输出需验证",
    "model.topologyKey": "空间柱顶刚接X向短臂；真实偏心几何",
    "model.boundaryKey": "柱底六自由度固定；短臂端自由",
    "model.loadKey": "短臂端竖向力加Y向侧力；产生空间弯扭",
    "model.propertyKey": "柱与短梁各给A/I/J；有限扭转刚度",
    "engine.analysisContract": "保留题定几何、材料截面、边界和荷载；采用一阶线弹性静力、自重关闭。按明示全局/局部轴、字段单位及工况/组合计算；不新增刚性楼板、未声明刚臂或规范默认组合；结果位置/分量与原题一致。",
    "engine.executionRequirement": "拟要求真实 OpenSees 求解，保存输入与原始结果的对应关系；解析式/独立矩阵解用于校核，不能替代规定引擎执行证据。",
    "engine.requiredEvidence": "拟保存（尚未生成）：OpenSees 版本、可运行模型/脚本、节点构件和荷载表、实际计算日志、原始结果与工况索引、平衡/独立解校核记录。",
    "engine.adapterGap": "真实短臂连接、扭转刚度 J、六分量内力与转角读取须验证，不以未声明刚臂替换。 当前无据认定接口不支持；需实际能力测试后确定，不将未验证能力记为模型失败。",
    "engine.truthPlan": "拟建立独立审定的 OpenSees 模型及同版本/同设置参考结果；独立三维框架含扭转刚度解；臂端力关于柱底的力矩平衡手算复核，变形另做独立能量法抽查。 参考值尚未生成。 所有题定输出均须覆盖，校核实现不复用被测转换链路。"
  },
