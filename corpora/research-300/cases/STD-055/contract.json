  "sourcePlan": {
    "task.inputForm": "完整文字任务 + 随题分析属性表（待编制）",
    "task.scenario": "两层各3.6m、跨6m，面载10kN/m²按6m受荷宽度折算，仅施加线载；完整属性按公共契约随题给出。 明确每层只施加60kN/m梁线载；各层左右梁柱节点分别报告，不能合成虚构刚性楼层位移。",
    "task.modelingFocus": "面载不能与折算线载重复",
    "task.expectedOutput": "每层左右节点X/Z位移、左右柱列层间位移差及柱脚反力。",
    "task.gradingFocus": "面载不能与折算线载重复；指定位置/分量对照数值真值，输出文字与结构化结果保持符号、单位和工况一致。",
    "task.prerequisite": "基础工具；完整题面、参数/单位契约与真值待验证",
    "model.topologyKey": "平面两层单跨等层高钢框架",
    "model.boundaryKey": "全部柱脚固定；楼层不加刚性约束",
    "model.loadKey": "两层同值梁线载；已按受荷宽度折算",
    "model.propertyKey": "单钢材料；梁柱分组截面",
    "engine.analysisContract": "保留题定几何、材料截面、边界和荷载；采用一阶线弹性静力、自重关闭。按明示全局/局部轴、字段单位及工况/组合计算；不新增刚性楼板、未声明刚臂或规范默认组合；结果位置/分量与原题一致。",
    "engine.executionRequirement": "拟要求真实 OpenSees 求解，保存输入与原始结果的对应关系；解析式/独立矩阵解用于校核，不能替代规定引擎执行证据。",
    "engine.requiredEvidence": "拟保存（尚未生成）：OpenSees 版本、可运行模型/脚本、节点构件和荷载表、实际计算日志、原始结果与工况索引、平衡/独立解校核记录。",
    "engine.adapterGap": "只施加折算后的梁线载；逐柱列位移不得替换为刚性楼层平均。 当前无据认定接口不支持；需实际能力测试后确定，不将未验证能力记为模型失败。",
    "engine.truthPlan": "拟建立独立审定的 OpenSees 模型及同版本/同设置参考结果；独立二维框架刚度解；楼层总荷载和平衡核对，逐列计算相邻层位移差。 参考值尚未生成。 所有题定输出均须覆盖，校核实现不复用被测转换链路。"
  },
