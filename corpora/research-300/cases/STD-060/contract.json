  "sourcePlan": {
    "task.inputForm": "完整文字任务 + 随题分析属性表（待编制）",
    "task.scenario": "两层各3.6m，跨度5.4、6m，D=10、L=8kN/m，组合1.2D+1.4L；完整属性按公共契约随题给出。 将旧DXF转为文字尺寸/成员表；保留D和L，不先把10+8合成单工况再放大。",
    "task.modelingFocus": "不等跨及恒活载分离",
    "task.expectedOutput": "D、L和1.2D+1.4L下各层节点位移、柱脚反力与代表梁端弯矩。",
    "task.gradingFocus": "不等跨及恒活载分离；指定位置/分量对照数值真值，输出文字与结构化结果保持符号、单位和工况一致。",
    "task.prerequisite": "多工况/多组合执行及结果索引需验证；完整题面、参数/单位契约与真值待验证",
    "model.topologyKey": "平面两层两不等跨钢框架",
    "model.boundaryKey": "全部柱脚固定",
    "model.loadKey": "D/L分别全梁线载；1.2D+1.4L组合",
    "model.propertyKey": "单钢材料；梁柱分组截面",
    "engine.analysisContract": "保留题定几何、材料截面、边界和荷载；采用一阶线弹性静力、自重关闭。按明示全局/局部轴、字段单位及工况/组合计算；不新增刚性楼板、未声明刚臂或规范默认组合；结果位置/分量与原题一致。",
    "engine.executionRequirement": "拟要求真实 OpenSees 求解，保存输入与原始结果的对应关系；解析式/独立矩阵解用于校核，不能替代规定引擎执行证据。",
    "engine.requiredEvidence": "拟保存（尚未生成）：OpenSees 版本、可运行模型/脚本、节点构件和荷载表、实际计算日志、原始结果与工况索引、平衡/独立解校核记录。",
    "engine.adapterGap": "D、L、1.2D+1.4L 的独立保存及结果索引须验证。 当前无据认定接口不支持；需实际能力测试后确定，不将未验证能力记为模型失败。",
    "engine.truthPlan": "拟建立独立审定的 OpenSees 模型及同版本/同设置参考结果；独立框架解与线性叠加；核对组合总荷载，不接受对总18kN/m统一乘系数。 参考值尚未生成。 所有题定输出均须覆盖，校核实现不复用被测转换链路。"
  },
