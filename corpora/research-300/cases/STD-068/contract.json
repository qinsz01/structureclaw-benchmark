  "plannedEngine": "OpenSees",
  "sourcePlan": {
    "task.inputForm": "完整文字任务 + 随题分析属性表（待编制）",
    "task.scenario": "单跨6m钢框架，柱底z=-1.5m固定，两个上部楼层z=2.1m和5.7m；另在z=0设全跨刚接地面连系梁，连系梁无外载。仅两个上部楼层梁各向下10kN/m，所有节点/截面按表。",
    "task.modelingFocus": "负绝对标高合法，地面连系梁接入柱线且无新增地基约束，加载只在上部两层",
    "task.expectedOutput": "地面与两个上部楼层梁柱节点位移、各实际柱段位移差、连系梁端力及柱脚反力。",
    "task.gradingFocus": "负绝对标高合法，地面连系梁接入柱线且无新增地基约束，加载只在上部两层；指定位置/分量对照数值真值，输出文字与结构化结果保持符号、单位和工况一致。",
    "task.prerequisite": "基础工具；完整题面、参数/单位契约与真值待验证",
    "model.topologyKey": "负标高基底单跨框架；地面连系梁加两上部楼层梁",
    "model.boundaryKey": "两个负标高柱脚固定；地面节点无额外支座",
    "model.loadKey": "上部两层梁同值竖载；地面连系梁无外载",
    "model.propertyKey": "单钢材料；连系梁与楼层梁截面明列",
    "engine.analysisContract": "保留题定几何、材料截面、边界和荷载；采用一阶线弹性静力、自重关闭。按明示全局/局部轴、字段单位及工况/组合计算；不新增刚性楼板、未声明刚臂或规范默认组合；结果位置/分量与原题一致。",
    "engine.executionRequirement": "拟要求真实 OpenSees 求解，保存输入与原始结果的对应关系；解析式/独立矩阵解用于校核，不能替代规定引擎执行证据。",
    "engine.requiredEvidence": "拟保存（尚未生成）：OpenSees 版本、可运行模型/脚本、节点构件和荷载表、实际计算日志、原始结果与工况索引、平衡/独立解校核记录。",
    "engine.adapterGap": "负坐标合法，地面连系梁不产生额外地基约束；分层标高须验收。 当前无据认定接口不支持；需实际能力测试后确定，不将未验证能力记为模型失败。",
    "engine.truthPlan": "拟建立独立审定的 OpenSees 模型及同版本/同设置参考结果；独立二维框架解；地面节点平衡与总载核验，再整体平移作坐标不变性辅助校验，新真值待建立。 所有题定输出均须覆盖，校核实现不复用被测转换链路。"
  },
