{
  "schemaVersion": 1,
  "evaluationProfile": "engineering-v2.3",
  "id": "MM-075",
  "modelId": "M-MM-075",
  "family": "multimodal_reverse_engineering",
  "language": "中文",
  "locale": "zh",
  "plannedEngine": "OpenSees",
  "sourcePlan": {
    "sourceRequirements": {
      "task.inputForm": "新建筑DXF通过明确结构层提供本题几何/连接；围护/设备为干扰层；工程附录明确支座、荷载、属性和坐标映射，不把墙线默认成杆件或支座。所有新附件待制作、盲审与验证。",
      "task.scenario": "几何：两层各3.6m、柱线x=0、5、10、15m；四柱线均到顶，首层梁三跨齐全，顶层仅左右外跨设梁，中央跨无梁；边界：四底柱脚固定；荷载：首层梁向下10kN/m，顶层两外梁向下8kN/m；属性：C30、柱500×500mm、梁300×600mm。（本栏是编题规格，实际用户输入按图/表分工呈现。）",
      "task.modelingFocus": "上层两翼之间的轴线不是梁，但两侧柱仍存在。",
      "task.expectedOutput": "顶层两外跨中点Uz、内侧两底柱反力；附与数值一致的模型/结果图。",
      "task.gradingFocus": "模型核对：上层单侧退台改为中间缺梁、左右双翼保留，拓扑不同。；数值/表述核对：顶层两外跨中点Uz、内侧两底柱反力，位置、方向、单位须一致。",
      "task.prerequisite": "基础工具；本题新增几何/属性与真值均待独立核验；材料截面代号须在本题附录定值。",
      "model.topologyKey": "两层各3.6m、柱线x=0、5、10、15m；四柱线均到顶，首层梁三跨齐全，顶层仅左右外跨设梁，中央跨无梁",
      "model.boundaryKey": "四底柱脚固定",
      "model.loadKey": "首层梁向下10kN/m，顶层两外梁向下8kN/m",
      "model.propertyKey": "C30、柱500×500mm、梁300×600mm。",
      "engine.analysisContract": "一阶线弹性；自重OFF并保存配置；按附录实际E/A/I/J，不套默认刚度折减；无默认刚性楼板。全局Z向上，核对XZ到求解器平面的映射及Ry符号。题给线载/点力/力矩按原位映射；如作等效节点加载，须保留原始分布荷载并采用与单元插值一致的等效荷载，核验跨内响应及合力/力矩，不用统一楼面载替代。荷载契约：首层梁向下10kN/m，顶层两外梁向下8kN/m；未指定组合时仅算题定基本荷载，指定组合逐组执行，不能用软件默认包络替换。",
      "engine.executionRequirement": "顶层中央无梁而四柱完整，不能用退台删柱替代缺梁；执行后按原题完整输出：顶层两外跨中点Uz、内侧两底柱反力；附与数值一致的模型/结果图。本轮仅规划，不运行。",
      "engine.requiredEvidence": "计划保存输入PNG/DXF及图中构件/标签→计算节点/构件ID映射、可复现OpenSees输入模型、引擎版本与设置快照、实际运行日志、原始结果表/观测点索引、可视图所用数据。",
      "engine.adapterGap": "尚未确认本题可通过；接口/求解/读回预检重点：顶层中央无梁而四柱完整，不能用退台删柱替代缺梁。特殊单元、轴向、边界及组合均不因OpenSees原生支持而视作已接通。",
      "engine.truthPlan": "独立建立并复核OpenSees参考模型，固定版本/求解设置及观测位置；以独立模型审阅、整体平衡及构件端力/节点结果一致性校核。不把展示层插值或图像读数直接当数值真值。"
    },
