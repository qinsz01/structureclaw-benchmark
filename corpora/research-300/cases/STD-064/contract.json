  "turns": [
    {
      "id": "t1",
      "instruction": "Required solver: OpenSees.\nAnalyze the attached two-story single-bay steel frame in OpenSees. Each story is 3.6 m high and the main span is 6 m. A 1.5 m overhang extends rightward from the beam-column joint on each floor, with a rigid root and a free tip. Both column bases are fixed. In case D, each main-span beam carries 10 kN/m downward and each overhang carries 5 kN/m downward. Report the vertical displacement uz of both free tips, M2 at both overhang roots, ux/uz/ry at each left and right floor column top, and Fx/Fz/My at both bases. Use the attached properties and axes with first-order linear elastic static analysis and self-weight disabled.\n\nUse all public appendices. Report the complete requested numerical table and the required summaries.",
      "state": 1,
      "expectation": "analyze",
      "attachments": [
        "input-data.json",
        "output-requests.json",
        "analysis-conventions.txt",
        "output-scope.json",
        "appendix-decisions.txt"
      ],
      "unresolvedFields": [],
      "expectedQuestions": []
    }
  ],
