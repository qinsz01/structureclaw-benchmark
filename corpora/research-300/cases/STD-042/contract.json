  "plannedEngine": "OpenSees",
  "sourcePlan": {
    "task.inputForm": "完整文字任务 + 随题分析属性表（待编制）",
    "task.scenario": "底面三角形边长4m，两层各3m，弦杆横杆斜杆按表连接，底节点固定，顶层侧力；完整属性按公共契约随题给出。 两层三角柱所有节点和斜杆端点列表完整；顶层三个节点各X向10kN，底节点固定。",
    "task.modelingFocus": "跨层空间连接与杆件组",
    "task.expectedOutput": "顶层节点三向位移、跨层弦杆/腹杆轴力、底部反力合计与分配。",
    "task.gradingFocus": "跨层空间连接与杆件组；指定位置/分量对照数值真值，输出文字与结构化结果保持符号、单位和工况一致。",
    "task.prerequisite": "空间桁架及独立真值需验证；完整题面、参数/单位契约与真值待验证",
    "model.topologyKey": "两层三角柱空间桁架；弦杆横杆斜杆按表",
    "model.boundaryKey": "三个底节点平移固定",
    "model.loadKey": "三个顶层节点同向侧力",
    "model.propertyKey": "明确空间杆组；三维轴力杆",
    "engine.analysisContract": "保留题定几何、材料截面、边界和荷载；采用一阶线弹性静力、自重关闭。按明示全局/局部轴、字段单位及工况/组合计算；不新增刚性楼板、未声明刚臂或规范默认组合；结果位置/分量与原题一致。 采用仅轴力杆件，交叉是否连接按端点表；不把铰接杆改为刚接梁。",
    "engine.executionRequirement": "拟要求真实 OpenSees 求解，保存输入与原始结果的对应关系；解析式/独立矩阵解用于校核，不能替代规定引擎执行证据。",
    "engine.requiredEvidence": "拟保存（尚未生成）：OpenSees 版本、可运行模型/脚本、节点构件和荷载表、实际计算日志、原始结果与工况索引、平衡/独立解校核记录。",
    "engine.adapterGap": "空间多层 truss 连接、约束后刚度秩和跨层端点需验证。 当前无据认定接口不支持；需实际能力测试后确定，不将未验证能力记为模型失败。",
    "engine.truthPlan": "拟建立独立审定的 OpenSees 模型及同版本/同设置参考结果；先验秩检查与连接图审计；独立三维杆系解及每节点/整体平衡。 参考值尚未生成。 所有题定输出均须覆盖，校核实现不复用被测转换链路。"
  },
