  "sourcePlan": {
    "task.inputForm": "完整文字任务 + 随题分析属性表（待编制）",
    "task.scenario": "两层，跨度5、7m，左右梁受荷宽度4、6m，楼面10kN/m²；完整属性按公共契约随题给出。 两层均3.6m；左梁线载40kN/m、右梁60kN/m，只施加转换后的线载。",
    "task.modelingFocus": "每跨独立折算且不可重复加面载",
    "task.expectedOutput": "左右梁跨中位移、各柱顶位移及三柱脚反力。",
    "task.gradingFocus": "每跨独立折算且不可重复加面载；指定位置/分量对照数值真值，输出文字与结构化结果保持符号、单位和工况一致。",
    "task.prerequisite": "基础工具；完整题面、参数/单位契约与真值待验证",
    "model.topologyKey": "平面两层两不等跨混凝土框架",
    "model.boundaryKey": "全部柱脚固定",
    "model.loadKey": "同面载按左右不同受荷宽度分别折算",
    "model.propertyKey": "混凝土材料；梁柱分组截面",
    "engine.analysisContract": "保留题定几何、材料截面、边界和荷载；采用一阶线弹性静力、自重关闭。按明示全局/局部轴、字段单位及工况/组合计算；不新增刚性楼板、未声明刚臂或规范默认组合；结果位置/分量与原题一致。",
    "engine.executionRequirement": "拟要求真实 OpenSees 求解，保存输入与原始结果的对应关系；解析式/独立矩阵解用于校核，不能替代规定引擎执行证据。",
    "engine.requiredEvidence": "拟保存（尚未生成）：OpenSees 版本、可运行模型/脚本、节点构件和荷载表、实际计算日志、原始结果与工况索引、平衡/独立解校核记录。",
    "engine.adapterGap": "左右梁受荷宽度分别折算且只加载一次。 当前无据认定接口不支持；需实际能力测试后确定，不将未验证能力记为模型失败。",
    "engine.truthPlan": "拟建立独立审定的 OpenSees 模型及同版本/同设置参考结果；独立框架解；逐跨面积载荷与梁线载总力等价，整体合力矩复核。 参考值尚未生成。 所有题定输出均须覆盖，校核实现不复用被测转换链路。"
  },
