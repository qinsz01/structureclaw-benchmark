  "language": "英文",
  "locale": "en",
  "plannedEngine": "OpenSees",
  "sourcePlan": {
    "sourceRequirements": {
      "task.inputForm": "新框架立面PNG给2D几何与连接；柱截面朝向详图给左右柱强弱轴及中柱方截面，构件标签关联完整局部轴/惯性矩属性表；附录给约束和荷载，不直接给完整节点坐标答案。所有新附件待制作、盲审与验证。",
      "task.scenario": "几何：两层各3.6m，两跨7、4m，三柱线完整；边界：三柱脚固定；荷载：所有梁向下12kN/m，顶层右节点Fx=25kN；属性：C30；左柱矩形400×700mm强轴在XZ面，右柱同矩形旋转90度，中柱500×500mm，梁300×600mm，完整局部轴和惯性矩表另附。（本栏是编题规格，实际用户输入按图/表分工呈现。）",
      "task.modelingFocus": "截面详图需映射到左/中/右柱，朝向不能由尺寸顺序猜测。",
      "task.expectedOutput": "顶层右节点Ux、左右底柱弯矩；附与数值一致的模型/结果图。",
      "task.gradingFocus": "模型核对：两柱单跨改三柱两跨，并增加方中柱与不同边柱朝向。；数值/表述核对：顶层右节点Ux、左右底柱弯矩，位置、方向、单位须一致。",
      "task.prerequisite": "局部轴输入与适配需验证；本题新增几何/属性与真值均待独立核验；材料截面代号须在本题附录定值。",
      "model.topologyKey": "两层各3.6m，两跨7、4m，三柱线完整",
      "model.boundaryKey": "三柱脚固定",
      "model.loadKey": "所有梁向下12kN/m，顶层右节点Fx=25kN",
      "model.propertyKey": "C30；左柱矩形400×700mm强轴在XZ面，右柱同矩形旋转90度，中柱500×500mm，梁300×600mm，完整局部轴和惯性矩表另附。",
      "engine.analysisContract": "一阶线弹性；自重OFF并保存配置；按附录实际E/A/I/J，不套默认刚度折减；无默认刚性楼板。全局Z向上，核对XZ到求解器平面的映射及Ry符号。题给线载/点力/力矩按原位映射；如作等效节点加载，须保留原始分布荷载并采用与单元插值一致的等效荷载，核验跨内响应及合力/力矩，不用统一楼面载替代。荷载契约：所有梁向下12kN/m，顶层右节点Fx=25kN；未指定组合时仅算题定基本荷载，指定组合逐组执行，不能用软件默认包络替换。",
      "engine.executionRequirement": "验证矩形柱局部轴与强弱轴惯性矩映射，平面弯矩符号统一；执行后按原题完整输出：顶层右节点Ux、左右底柱弯矩；附与数值一致的模型/结果图。本轮仅规划，不运行。",
      "engine.requiredEvidence": "计划保存输入PNG/DXF及图中构件/标签→计算节点/构件ID映射、可复现OpenSees输入模型、引擎版本与设置快照、实际运行日志、原始结果表/观测点索引、可视图所用数据。",
      "engine.adapterGap": "尚未确认本题可通过；接口/求解/读回预检重点：验证矩形柱局部轴与强弱轴惯性矩映射，平面弯矩符号统一。特殊单元、轴向、边界及组合均不因OpenSees原生支持而视作已接通。",
      "engine.truthPlan": "独立建立并复核OpenSees参考模型，固定版本/求解设置及观测位置；以独立模型审阅、整体平衡及构件端力/节点结果一致性校核。不把展示层插值或图像读数直接当数值真值。"
    },
