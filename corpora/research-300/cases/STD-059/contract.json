  "sourcePlan": {
    "task.inputForm": "完整文字任务 + 随题分析属性表（待编制）",
    "task.scenario": "单层单跨钢框架，跨6m、屋面高4.5m，两柱脚固定；新增z=2.25m水平连系梁与两柱刚接，连系梁无外载。屋面8kN/m²按6m宽度折成48kN/m，材料/截面按公共契约给出。",
    "task.modelingFocus": "中高连系梁使两柱分段并连通；无载连系梁仍参与刚度，屋面面载仅折算一次",
    "task.expectedOutput": "屋面及连系梁两端X/Z位移、屋面跨中位移、连系梁端力与柱脚反力。",
    "task.gradingFocus": "中高连系梁使两柱分段并连通；无载连系梁仍参与刚度，屋面面载仅折算一次；指定位置/分量对照数值真值，输出文字与结构化结果保持符号、单位和工况一致。",
    "task.prerequisite": "基础工具；完整题面、参数/单位契约与真值待验证",
    "model.topologyKey": "单层单跨钢框架；柱中高增加全跨刚接连系梁",
    "model.boundaryKey": "两柱脚固定；中高连系梁两端刚接",
    "model.loadKey": "屋面面载一次折算线载；中高连系梁无外载",
    "model.propertyKey": "单钢材料；屋面梁/连系梁与柱属性明确",
    "engine.analysisContract": "保留题定几何、材料截面、边界和荷载；采用一阶线弹性静力、自重关闭。按明示全局/局部轴、字段单位及工况/组合计算；不新增刚性楼板、未声明刚臂或规范默认组合；结果位置/分量与原题一致。",
    "engine.executionRequirement": "拟要求真实 OpenSees 求解，保存输入与原始结果的对应关系；解析式/独立矩阵解用于校核，不能替代规定引擎执行证据。",
    "engine.requiredEvidence": "拟保存（尚未生成）：OpenSees 版本、可运行模型/脚本、节点构件和荷载表、实际计算日志、原始结果与工况索引、平衡/独立解校核记录。",
    "engine.adapterGap": "无载中高连系梁仍参与刚度，柱需在真实接点分段；输出须验收。 当前无据认定接口不支持；需实际能力测试后确定，不将未验证能力记为模型失败。",
    "engine.truthPlan": "拟建立独立审定的 OpenSees 模型及同版本/同设置参考结果；独立二维框架矩阵解；连系梁节点平衡及屋面总载288kN复核，新拓扑下建立参考值。 所有题定输出均须覆盖，校核实现不复用被测转换链路。"
