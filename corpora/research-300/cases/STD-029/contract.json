  "sourcePlan": {
    "task.inputForm": "完整文字任务 + 随题分析属性表（待编制）",
    "task.scenario": "跨度12m、高3m，旧题6节点10杆，三个上弦节点各20kN；完整属性按公共契约随题给出。 保留三个上弦节点到跨中下弦的连杆，以及两侧上弦节点间的水平杆。",
    "task.modelingFocus": "保留特殊水平连杆与连接节点",
    "task.expectedOutput": "三受载上弦节点位移、水平连杆与其余杆轴力、支反力。",
    "task.gradingFocus": "保留特殊水平连杆与连接节点；指定位置/分量对照数值真值，输出文字与结构化结果保持符号、单位和工况一致。",
    "task.prerequisite": "基础工具；完整题面、参数/单位契约与真值待验证",
    "model.topologyKey": "三角外形六节点十杆桁架；附上弦水平连杆",
    "model.boundaryKey": "左下铰右下X向自由滚支",
    "model.loadKey": "三个上弦节点同值竖载",
    "model.propertyKey": "单材料单面积；全部轴力杆",
    "engine.analysisContract": "保留题定几何、材料截面、边界和荷载；采用一阶线弹性静力、自重关闭。按明示全局/局部轴、字段单位及工况/组合计算；不新增刚性楼板、未声明刚臂或规范默认组合；结果位置/分量与原题一致。 采用仅轴力杆件，交叉是否连接按端点表；不把铰接杆改为刚接梁。",
    "engine.executionRequirement": "拟要求真实 OpenSees 求解，保存输入与原始结果的对应关系；解析式/独立矩阵解用于校核，不能替代规定引擎执行证据。",
    "engine.requiredEvidence": "拟保存（尚未生成）：OpenSees 版本、可运行模型/脚本、节点构件和荷载表、实际计算日志、原始结果与工况索引、平衡/独立解校核记录。",
    "engine.adapterGap": "逐题核验保留特殊水平连杆与连接节点；输入、结果分量/位置及数值标答尚未完成验收。 当前无据认定接口不支持；需实际能力测试后确定，不将未验证能力记为模型失败。",
    "engine.truthPlan": "拟建立独立审定的 OpenSees 模型及同版本/同设置参考结果；独立桁架刚度法；核对附加水平杆存在性与全节点平衡。 参考值尚未生成。 所有题定输出均须覆盖，校核实现不复用被测转换链路。"
  },
