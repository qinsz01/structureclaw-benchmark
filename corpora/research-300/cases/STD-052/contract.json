  "sourcePlan": {
    "task.inputForm": "完整文字任务 + 随题分析属性表（待编制）",
    "task.scenario": "跨度22m、高7m，屋面梁分三段给定常截面，不采用连续变截面单元；完整属性按公共契约随题给出。 水平屋面在x=5m、17m分界，三段分别给B1/B2/B3，向下6kN/m。",
    "task.modelingFocus": "分段属性与几何连续性",
    "task.expectedOutput": "屋面跨中及分界位移、分界两侧端力、柱脚反力；附截面分段表。",
    "task.gradingFocus": "分段属性与几何连续性；指定位置/分量对照数值真值，输出文字与结构化结果保持符号、单位和工况一致。",
    "task.prerequisite": "基础工具；完整题面、参数/单位契约与真值待验证",
    "model.topologyKey": "单层单跨平屋面门架；屋面三段连续",
