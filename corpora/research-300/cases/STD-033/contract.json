  "plannedEngine": "OpenSees",
  "sourcePlan": {
    "task.inputForm": "完整文字任务 + 随题分析属性表（待编制）",
    "task.scenario": "跨度15m、高2.5m、5节间，12节点21杆，内部下弦节点各10kN；完整属性按公共契约随题给出。 将旧DXF内容转成节点/杆件文字表，保留12节点21杆和平行弦外形。",
    "task.modelingFocus": "三角腹杆不等于三角外轮廓",
    "task.expectedOutput": "四个内部下弦节点位移、全部杆轴力和支反力。",
    "task.gradingFocus": "三角腹杆不等于三角外轮廓；指定位置/分量对照数值真值，输出文字与结构化结果保持符号、单位和工况一致。",
    "task.prerequisite": "基础工具；完整题面、参数/单位契约与真值待验证",
    "model.topologyKey": "平行弦三角腹杆桁架；五节间；十二节点二十一杆",
    "model.boundaryKey": "左下铰右下X向自由滚支",
    "model.loadKey": "四个内部下弦节点同值竖载",
    "model.propertyKey": "单材料单面积；全部轴力杆",
    "engine.analysisContract": "保留题定几何、材料截面、边界和荷载；采用一阶线弹性静力、自重关闭。按明示全局/局部轴、字段单位及工况/组合计算；不新增刚性楼板、未声明刚臂或规范默认组合；结果位置/分量与原题一致。 采用仅轴力杆件，交叉是否连接按端点表；不把铰接杆改为刚接梁。",
    "engine.executionRequirement": "拟要求真实 OpenSees 求解，保存输入与原始结果的对应关系；解析式/独立矩阵解用于校核，不能替代规定引擎执行证据。",
    "engine.requiredEvidence": "拟保存（尚未生成）：OpenSees 版本、可运行模型/脚本、节点构件和荷载表、实际计算日志、原始结果与工况索引、平衡/独立解校核记录。",
    "engine.adapterGap": "逐题核验三角腹杆不等于三角外轮廓；输入、结果分量/位置及数值标答尚未完成验收。 当前无据认定接口不支持；需实际能力测试后确定，不将未验证能力记为模型失败。",
    "engine.truthPlan": "拟建立独立审定的 OpenSees 模型及同版本/同设置参考结果；沿用旧模型作几何种子，文字移植后独立组装桁架矩阵并复核节点平衡。 参考值尚未生成。 所有题定输出均须覆盖，校核实现不复用被测转换链路。"
  },
  "modelStates": [
    "model-state-1.json"
  ],
  "attachments": [
    "geometry.json",
    "properties.json",
    "loads.json",
    "output-requests.json"
  ],
  "turns": [
    {
      "id": "t1",
      "instruction": "按附件文字节点表和杆件端点表建立跨度15 m、高2.5 m、五个3 m节间的平行弦三角腹杆桁架。该表从原DXF的STRUCT线转录，共12节点21根杆；外轮廓为平行弦，不能据‘三角腹杆’改变外形。B0铰支，B5为X向自由滚支；只在内部下弦B1、B2、B3、B4各施加向下10 kN。用OpenSees进行仅轴力弹性杆的一阶静力分析，杆件可受拉压，自重关闭。输出LC1下四个受载下弦节点的ux、uz、全部21根杆轴力N以及两支座Fx、Fz。位移用m，力用kN，N受拉为正。\n\n属性附表将每个给定面积A补齐为边长sqrt(A)的实心正方形截面，Iy=Iz=A²/12，J=0.14083333333333334 A²。这些截面参数为明确编制的附录数据；全部构件仍为仅轴力桁架杆，弯曲和扭转常数不参与本题计算，轴向刚度仍为EA。\n\n完整输入见附件。全局XYZ为右手系，Z向上；平面结构位于XZ面。表列节点均为实际连通节点。构件局部x由i端指向j端；二维局部y为全局+Y，局部z=x×y；三维局部y=归一化(reference×x)，局部z=x×y，参考向量逐杆给出。N拉为正；截面N/T/M2/M3在i端取节点抵抗力的负值，在j端取正值；V2/V3在i端取正值、j端取负值。节点位移和支反力按全局分量，转角服从右手定则。线载按构件实际长度计，斜杆亦然。一阶线弹性，自重、刚性楼板、刚域、二阶和施工阶段关闭；仅使用题定工况及组合。逐项完成output-requests.json中所有请求，保留位置、截面侧别、正负号、分量、单位、工况/组合。跨内内力恢复须计入荷载项。实际运行OpenSees，保留版本、可运行输入、当前模型哈希、运行ID、实际求解日志及原始结果/工况对应关系。正文和结构化结果均须给出题定结果，并独立检查平衡。附件不提供数值答案或原生执行证据。",
      "state": 1,
      "expectation": "analyze",
      "attachments": [
        "geometry.json",
        "properties.json",
        "loads.json",
        "output-requests.json"
      ],
      "unresolvedFields": [],
      "expectedQuestions": []
    }
  ],
