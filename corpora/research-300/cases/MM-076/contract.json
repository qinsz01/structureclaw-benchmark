  "plannedEngine": "OpenSees",
  "sourcePlan": {
    "sourceRequirements": {
      "task.inputForm": "新PNG独占本题几何/连通/支座和构件或区域标签；荷载表给标签对应的力值/工况/组合，属性表给完整材料/截面；无另附完整节点坐标表绕过读图。所有新附件待制作、盲审与验证。",
      "task.scenario": "几何：两层各3.6m、两跨5、7m；边界：左右柱脚固定，中柱脚铰，梁柱刚接；荷载：楼面10kN/m²，首层左右受荷宽度4、6m，顶层左右宽度6、4m，仅折算后施加线载；属性：C30、柱500×500mm、梁300×600mm。（本栏是编题规格，实际用户输入按图/表分工呈现。）",
      "task.modelingFocus": "受荷宽度按楼层和跨双重索引，中柱基础铰符号不能遗漏。",
      "task.expectedOutput": "两层左梁中点Uz、中柱底反力；附与数值一致的模型/结果图。",
      "task.gradingFocus": "模型核对：统一固定基础改为中柱铰基，并形成上下层互换受荷宽度。；数值/表述核对：两层左梁中点Uz、中柱底反力，位置、方向、单位须一致。",
      "task.prerequisite": "基础工具；本题新增几何/属性与真值均待独立核验；材料截面代号须在本题附录定值。",
      "model.topologyKey": "两层各3.6m、两跨5、7m",
      "model.boundaryKey": "左右柱脚固定，中柱脚铰，梁柱刚接",
      "model.loadKey": "楼面10kN/m²，首层左右受荷宽度4、6m，顶层左右宽度6、4m，仅折算后施加线载",
      "model.propertyKey": "C30、柱500×500mm、梁300×600mm。",
      "engine.analysisContract": "一阶线弹性；自重OFF并保存配置；按附录实际E/A/I/J，不套默认刚度折减；无默认刚性楼板。全局Z向上，核对XZ到求解器平面的映射及Ry符号。逐层/跨受荷宽度各自折算面载，原面载与线载不能重复；等效节点载须保持合力和力矩。荷载契约：楼面10kN/m²，首层左右受荷宽度4、6m，顶层左右宽度6、4m，仅折算后施加线载；未指定组合时仅算题定基本荷载，指定组合逐组执行，不能用软件默认包络替换。",
      "engine.executionRequirement": "面载按逐层/逐跨受荷宽度只折算一次，中柱脚转角释放；执行后按原题完整输出：两层左梁中点Uz、中柱底反力；附与数值一致的模型/结果图。本轮仅规划，不运行。",
      "engine.requiredEvidence": "计划保存输入PNG/DXF及图中构件/标签→计算节点/构件ID映射、可复现OpenSees输入模型、引擎版本与设置快照、实际运行日志、原始结果表/观测点索引、可视图所用数据。",
      "engine.adapterGap": "尚未确认本题可通过；接口/求解/读回预检重点：面载按逐层/逐跨受荷宽度只折算一次，中柱脚转角释放。特殊单元、轴向、边界及组合均不因OpenSees原生支持而视作已接通。",
      "engine.truthPlan": "独立建立并复核OpenSees参考模型，固定版本/求解设置及观测位置；以独立模型审阅、整体平衡及构件端力/节点结果一致性校核。不把展示层插值或图像读数直接当数值真值。"
    },
