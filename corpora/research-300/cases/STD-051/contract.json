  "sourcePlan": {
    "task.inputForm": "完整文字任务 + 随题分析属性表（待编制）",
    "task.scenario": "跨度18m、檐高6m、脊高7.5m，D全屋面向下，W只右坡向上，题定组合；完整属性按公共契约随题给出。 D两坡各向下6kN/m，W仅右坡向上8kN/m，按坡长；C0=D、C1=D+W。",
    "task.modelingFocus": "坡梁方向、局部风区与组合",
    "task.expectedOutput": "两组合屋脊位移、柱脚反力/弯矩、右坡端力，保留符号及组合标签。",
    "task.gradingFocus": "坡梁方向、局部风区与组合；指定位置/分量对照数值真值，输出文字与结构化结果保持符号、单位和工况一致。",
    "task.prerequisite": "斜杆荷载与多组合需验证；完整题面、参数/单位契约与真值待验证",
    "model.topologyKey": "单层单跨对称双坡门架",
    "model.boundaryKey": "两个柱脚固定",
    "model.loadKey": "D两坡向下；W仅右坡向上；两组合",
    "model.propertyKey": "梁柱角色截面；单材料",
    "engine.analysisContract": "保留题定几何、材料截面、边界和荷载；采用一阶线弹性静力、自重关闭。按明示全局/局部轴、字段单位及工况/组合计算；不新增刚性楼板、未声明刚臂或规范默认组合；结果位置/分量与原题一致。",
    "engine.executionRequirement": "拟要求真实 OpenSees 求解，保存输入与原始结果的对应关系；解析式/独立矩阵解用于校核，不能替代规定引擎执行证据。",
    "engine.requiredEvidence": "拟保存（尚未生成）：OpenSees 版本、可运行模型/脚本、节点构件和荷载表、实际计算日志、原始结果与工况索引、平衡/独立解校核记录。",
    "engine.adapterGap": "两坡加载范围、有符号向上荷载与 D/D+W 组合须验证。 当前无据认定接口不支持；需实际能力测试后确定，不将未验证能力记为模型失败。",
    "engine.truthPlan": "拟建立独立审定的 OpenSees 模型及同版本/同设置参考结果；逐工况独立框架解与线性叠加；按全局方向复核各坡荷载合力/力矩。 参考值尚未生成。 所有题定输出均须覆盖，校核实现不复用被测转换链路。"
  },
