{
  "schemaVersion": 1,
  "evaluationProfile": "engineering-v2.3",
  "id": "INT-025",
  "modelId": "M-INT-025",
  "family": "interactive_robustness",
  "language": "中文",
  "locale": "zh",
  "plannedEngine": "OpenSees",
  "sourcePlan": {
    "task.inputForm": "文本2轮＋完整属性附件（仅暂缺项除外）",
    "task.scenario": "T1所用独立模型为M-INT-025（端力矩加右跨均布载梁）。T1给M-INT-025，右端绕全局Y的数值20但单位漏写；T2确认20kN·m，正向按右手规则。",
    "task.modelingFocus": "节点力矩与集中力量纲不同；荷载分布的独立状态保持",
    "task.expectedOutput": "右跨中点x=7.5m的Uz及右支座Rz；所有值附位置、方向、单位、工况及当前轮次；澄清前不编造数值。",
    "task.gradingFocus": "仅补力矩单位；不转成20kN或均布载；左右跨仍5m+5m；6kN/m只在右跨，不能因单位补齐变为全跨加载；若已有信息可唯一推得缺项，接受说明依据后直接完成，否则再澄清。",
    "task.prerequisite": "节点力矩输入需验证；逐轮状态与目标/非目标差异评测待实现",
    "model.topologyKey": "连续梁；两跨5、5m",
    "model.boundaryKey": "x=0铰、x=5/10m滚支",
    "model.loadKey": "两跨5、5m，仅右跨6kN/m，在右端施加全局Y轴20kN·m，符号明确；全跨6kN/m改为仅右跨x=5～10m施加，左跨无均布载，右端20kN·m保留",
    "model.propertyKey": "各构件组完整A/Iy/Iz/J/G及E、nu记录；按本题附表逐字段给单位，不用模型默认值",
    "engine.analysisContract": "一阶线弹性静力；自重关闭；不自动施加刚性楼板/刚域、默认附加载或自动规范组合；严格保留题定约束、材料/截面完整属性、局部轴、荷载坐标与长度基准；单位逐字段明确。 各轮只执行明确修改，未被修改的字段保持；澄清内容按该轮生效。",
    "engine.executionRequirement": "计划使用OpenSees完成每个可计算轮次；模型/荷载/材料/约束改变后以当前状态新算；只改查询位置、单位或报告时可复用可追溯结果，若需新网格则重算；缺项未解决时不给虚构数值。",
    "engine.requiredEvidence": "逐轮输入与澄清记录、模型状态快照及前后字段差异；变更目标与未变字段核对；原始求解输入/工程、软件版本/设置、运行ID和成功日志、原始结果到节点/构件/工况的映射；结果绑定当前模型状态。核对目标：右跨中点x=7.5m的Uz及右支座Rz。",
    "engine.adapterGap": "未逐题验收；前置检查项：节点力矩输入需验证，并核对量纲澄清后计算后的模型更新和结果定位；不把一般OpenSees支持等同于当前StructureClaw已实现。",
    "engine.truthPlan": "各可计算轮次独立建立并复核OpenSees参考模型，勿复用被测建模/转换路径生成标答；状态改变后独立新算，纯查询沿用有效状态；用解析解（适用时）、整体平衡、刚度/单位/符号检查复核，复杂题再用独立实现或同假设第二求解器核验。"
  },
