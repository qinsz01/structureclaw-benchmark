{
  "schemaVersion": 1,
  "evaluationProfile": "engineering-v2.3",
  "id": "MM-070",
  "modelId": "M-MM-070",
  "family": "multimodal_reverse_engineering",
  "language": "英文",
  "locale": "en",
  "plannedEngine": "OpenSees",
  "sourcePlan": {
    "sourceRequirements": {
      "task.inputForm": "新PNG独占本题几何/连通/支座和构件或区域标签；荷载表给标签对应的力值/工况/组合，属性表给完整材料/截面；无另附完整节点坐标表绕过读图。所有新附件待制作、盲审与验证。",
      "task.scenario": "几何：三层标高3.3、6.6、9.9m；右柱始终x=6m；左柱底至首层x=0m，第二层斜接到x=1m，第三层保持x=1m；各层左右柱顶间设梁；边界：两底柱脚固定；荷载：各梁按实际长度向下60kN/m；属性：C35、柱500×500mm、梁300×600mm。（本栏是编题规格，实际用户输入按图/表分工呈现。）",
      "task.modelingFocus": "左柱在第二层倾斜且上两层跨度变小，不能按竖直柱阵列。",
      "task.expectedOutput": "斜柱上端Ux/Uz、左底柱弯矩；附与数值一致的模型/结果图。",
      "task.gradingFocus": "模型核对：普通直柱单跨框架改为中层斜柱与上层缩跨。；数值/表述核对：斜柱上端Ux/Uz、左底柱弯矩，位置、方向、单位须一致。",
      "task.prerequisite": "基础工具；本题新增几何/属性与真值均待独立核验；材料截面代号须在本题附录定值。斜杆全局荷载和局部轴适配待验证。",
      "model.topologyKey": "三层标高3.3、6.6、9.9m；右柱始终x=6m；左柱底至首层x=0m，第二层斜接到x=1m，第三层保持x=1m；各层左右柱顶间设梁",
      "model.boundaryKey": "两底柱脚固定",
      "model.loadKey": "各梁按实际长度向下60kN/m",
      "model.propertyKey": "C35、柱500×500mm、梁300×600mm。",
      "engine.analysisContract": "一阶线弹性；自重OFF并保存配置；按附录实际E/A/I/J，不套默认刚度折减；无默认刚性楼板。全局Z向上，核对XZ到求解器平面的映射及Ry符号。题给线载/点力/力矩按原位映射；如作等效节点加载，须保留原始分布荷载并采用与单元插值一致的等效荷载，核验跨内响应及合力/力矩，不用统一楼面载替代。荷载契约：各梁按实际长度向下60kN/m；未指定组合时仅算题定基本荷载，指定组合逐组执行，不能用软件默认包络替换。",
      "engine.executionRequirement": "中层斜柱真实建模，不能用水平刚臂或竖柱替换；核对局部轴；执行后按原题完整输出：斜柱上端Ux/Uz、左底柱弯矩；附与数值一致的模型/结果图。本轮仅规划，不运行。",
      "engine.requiredEvidence": "计划保存输入PNG/DXF及图中构件/标签→计算节点/构件ID映射、可复现OpenSees输入模型、引擎版本与设置快照、实际运行日志、原始结果表/观测点索引、可视图所用数据。",
      "engine.adapterGap": "尚未确认本题可通过；接口/求解/读回预检重点：中层斜柱真实建模，不能用水平刚臂或竖柱替换；核对局部轴。特殊单元、轴向、边界及组合均不因OpenSees原生支持而视作已接通。",
      "engine.truthPlan": "独立建立并复核OpenSees参考模型，固定版本/求解设置及观测位置；以独立模型审阅、整体平衡及构件端力/节点结果一致性校核。不把展示层插值或图像读数直接当数值真值。"
    },
