{
  "schemaVersion": 1,
  "evaluationProfile": "engineering-v2.3",
  "id": "MM-079",
  "modelId": "M-MM-079",
  "family": "multimodal_reverse_engineering",
  "language": "中文",
  "locale": "zh",
  "plannedEngine": "YJK",
  "sourcePlan": {
    "sourceRequirements": {
      "task.inputForm": "新平面及正交立面/局部截面PNG共同给本题空间几何、连接与朝向；附录给明确约束、荷载向量、完整属性和视图轴约定，不直接给完整节点坐标答案。所有新附件待制作、盲审与验证。面载仅传给X梁，受荷宽度为实际相邻楼面Y向半跨之和；Y梁不重复加载，无默认刚性楼板。",
      "task.scenario": "几何：下层平面四角(0,0)、(6,0)、(0,5)、(6,5)m且z=3.6m；上层四点沿X平移1m、z=7.2m，对应上下节点由斜柱连接；下层柱从原平面z=0起，各层四边设梁；边界：四底柱脚六自由度固定；荷载：两层面载均10kN/m²，按X梁单向受荷；属性：钢M1、柱C1、X梁B1、Y梁B2，无刚性楼板。（本栏是编题规格，实际用户输入按图/表分工呈现。）",
      "task.modelingFocus": "上层平面不是下层原位复制，多视图需共同确定斜柱端点。",
      "task.expectedOutput": "顶层(7,5,7.2)m节点Ux/Uz、前右柱底弯矩；附与数值一致的模型/结果图。",
      "task.gradingFocus": "模型核对：规则直柱空间框架改为上层整体平移、层间柱倾斜。；数值/表述核对：顶层(7,5,7.2)m节点Ux/Uz、前右柱底弯矩，位置、方向、单位须一致。",
      "task.prerequisite": "基础工具；本题新增几何/属性与真值均待独立核验；材料截面代号须在本题附录定值。斜杆全局荷载和局部轴适配待验证。按实际保留矩形楼面逐层分配面载，关闭自重与默认刚性楼板。",
      "model.topologyKey": "下层平面四角(0,0)、(6,0)、(0,5)、(6,5)m且z=3.6m；上层四点沿X平移1m、z=7.2m，对应上下节点由斜柱连接；下层柱从原平面z=0起，各层四边设梁",
      "model.boundaryKey": "四底柱脚六自由度固定",
      "model.loadKey": "两层面载均10kN/m²，按X梁单向受荷",
      "model.propertyKey": "钢M1、柱C1、X梁B1、Y梁B2，无刚性楼板。",
      "engine.analysisContract": "一阶线弹性；自重OFF并保存配置；按附录实际E/A/I/J，不套默认刚度折减；无默认刚性楼板。原生工程须显式关闭自重、自动组合/地震及影响该契约的默认设置，导出配置核对。采用题定右手全局Z向上，核对构件局部轴与结果分量。面载仅传给实际X梁，受荷宽度为相邻实际楼面Y向半跨之和，Y梁不重复加载；等效线/节点载须同时保持合力和力矩。荷载契约：两层面载均10kN/m²，按X梁单向受荷；未指定组合时仅算题定基本荷载，指定组合逐组执行，不能用软件默认包络替换。",
      "engine.executionRequirement": "原生项目逐层输入平移后的节点和斜柱，确认两种梁截面及单向受荷；适配/回读通过后才纳入自动运行；执行后按原题完整输出：顶层(7,5,7.2)m节点Ux/Uz、前右柱底弯矩；附与数值一致的模型/结果图。本轮仅规划，不运行。",
      "engine.requiredEvidence": "计划保存输入PNG/DXF及图中构件/标签→计算节点/构件ID映射、YJK原生工程及接口导入/回读差异、引擎版本与设置快照、实际运行日志、原始结果表/观测点索引、可视图所用数据。",
      "engine.adapterGap": "现有YJK接口按完整规则柱网及相邻水平梁/竖柱生成，不能忠实表达上层平移斜柱；单一梁截面参数还不能承载X梁B1/Y梁B2。原生项目的精确属性与单向受荷配置亦须验证。",
      "engine.truthPlan": "由独立审阅的YJK原生工程形成同版本、同参数的参考结果；核对实际楼层/构件属性、题定荷载合力及力矩平衡，并保存顶层(7,5,7.2)m节点Ux/Uz、前右柱底弯矩的原始索引。原生人工参考模型不代表当前自动接口已接通。"
    },
