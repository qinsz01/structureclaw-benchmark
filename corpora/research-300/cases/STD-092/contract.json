  "sourcePlan": {
    "task.inputForm": "完整文字任务 + 随题分析属性表（待编制）",
    "task.scenario": "单层2乘1跨，屋面一侧高6m另一侧8m，坡梁按实际长度竖向加载；完整属性按公共契约随题给出。 X跨6+6m、Y跨5m，Y=0侧高6m、Y=5侧高8m；各屋面梁按实际长度向下5kN/m。",
    "task.modelingFocus": "三维斜梁连接与荷载投影",
    "task.expectedOutput": "四角及坡面中线节点三向位移、斜梁端力、所有柱脚反力。",
    "task.gradingFocus": "三维斜梁连接与荷载投影；指定位置/分量对照数值真值，输出文字与结构化结果保持符号、单位和工况一致。",
    "task.prerequisite": "斜杆荷载与局部轴需验证；完整题面、参数/单位契约与真值待验证",
    "model.topologyKey": "空间单层X两跨Y一跨；单坡斜屋面",
    "model.boundaryKey": "全部柱脚六自由度固定",
    "model.loadKey": "每根屋面梁按真实杆长全局竖向线载",
    "model.propertyKey": "单钢材料；梁柱分组截面及局部轴",
    "engine.analysisContract": "保留题定几何、材料截面、边界和荷载；采用一阶线弹性静力、自重关闭。按明示全局/局部轴、字段单位及工况/组合计算；不新增刚性楼板、未声明刚臂或规范默认组合；结果位置/分量与原题一致。",
    "engine.executionRequirement": "拟要求真实 OpenSees 求解，保存输入与原始结果的对应关系；解析式/独立矩阵解用于校核，不能替代规定引擎执行证据。",
    "engine.requiredEvidence": "拟保存（尚未生成）：OpenSees 版本、可运行模型/脚本、节点构件和荷载表、实际计算日志、原始结果与工况索引、平衡/独立解校核记录。",
    "engine.adapterGap": "空间坡梁实际长度线载、全局方向及三维端力转换须验证。 当前无据认定接口不支持；需实际能力测试后确定，不将未验证能力记为模型失败。",
    "engine.truthPlan": "拟建立独立审定的 OpenSees 模型及同版本/同设置参考结果；独立三维坐标变换解；按真实长度逐梁算总载并核验空间力矩。 参考值尚未生成。 所有题定输出均须覆盖，校核实现不复用被测转换链路。"
