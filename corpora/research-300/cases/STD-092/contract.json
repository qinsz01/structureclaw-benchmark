  "turns": [
    {
      "id": "t1",
      "instruction": "Required solver: OpenSees.\nBuild a single-story spatial steel frame with X bays 6+6 m and one Y bay 5 m. The roof edge at Y=0 is at Z=6 m; the edge at Y=5 is at Z=8 m. Fix all six column bases in all six degrees of freedom. Roof beams follow the actual single-slope surface: four horizontal X beams of length 6 m and three sloping Y beams of length sqrt(29) m. Use Q355 steel (E=206000 MPa, nu=0.3, G=206000/2.6 MPa, density=7850 kg/m^3), solid rectangular columns C1=400x500 mm, X beams BX=300x600 mm and sloping Y beams BY=250x500 mm. D applies global downward 5 kN/m per actual member length to every roof beam. Each sloping beam has a connected, unreleased midpoint node at Y=2.5, Z=7 m; its two halves have the same section and load intensity, without added mass. Use OpenSees for first-order linear elastic Euler-Bernoulli analysis, self weight off. Report ux/uy/uz at the four roof corners, both edge nodes on X=6 and all three slope midline nodes at Y=2.5 (nine nodes in total), all six local end-force components at both physical ends of each of the three sloping beams, and all six reaction components at every base.\n\nUse all public appendices. Report the complete requested numerical table and the required summaries.",
      "state": 1,
      "expectation": "analyze",
      "attachments": [
        "input-data.json",
        "output-requests.json",
        "analysis-conventions.txt"
      ],
      "unresolvedFields": [],
      "expectedQuestions": []
    }
  ],
