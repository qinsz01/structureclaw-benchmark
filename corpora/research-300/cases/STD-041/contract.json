  "plannedEngine": "OpenSees",
  "sourcePlan": {
    "task.inputForm": "完整文字任务 + 随题分析属性表（待编制）",
    "task.scenario": "底面6m×6m，顶点偏离中心，高3m，底边杆加四斜杆，四底节点固定，顶点双向荷载；完整属性按公共契约随题给出。 顶点坐标(2,3,3)m，底角(0/6,0/6,0)m固定；顶点受X向15kN和Z向-40kN。",
    "task.modelingFocus": "偏心空间几何和三向力分量",
    "task.expectedOutput": "顶点三向位移、四斜杆与底边杆轴力、四支座反力。",
    "task.gradingFocus": "偏心空间几何和三向力分量；指定位置/分量对照数值真值，输出文字与结构化结果保持符号、单位和工况一致。",
    "task.prerequisite": "空间桁架及独立真值需验证；完整题面、参数/单位契约与真值待验证",
    "model.topologyKey": "偏心方锥空间杆系；四条底边与四条斜杆",
    "model.boundaryKey": "四底节点平移固定",
    "model.loadKey": "偏心顶点X向与Z向双分量力",
    "model.propertyKey": "单材料单面积；三维轴力杆",
    "engine.analysisContract": "保留题定几何、材料截面、边界和荷载；采用一阶线弹性静力、自重关闭。按明示全局/局部轴、字段单位及工况/组合计算；不新增刚性楼板、未声明刚臂或规范默认组合；结果位置/分量与原题一致。 采用仅轴力杆件，交叉是否连接按端点表；不把铰接杆改为刚接梁。",
    "engine.executionRequirement": "拟要求真实 OpenSees 求解，保存输入与原始结果的对应关系；解析式/独立矩阵解用于校核，不能替代规定引擎执行证据。",
    "engine.requiredEvidence": "拟保存（尚未生成）：OpenSees 版本、可运行模型/脚本、节点构件和荷载表、实际计算日志、原始结果与工况索引、平衡/独立解校核记录。",
    "engine.adapterGap": "三维 truss、偏心顶点力分解及固定底边零应变须验证。 当前无据认定接口不支持；需实际能力测试后确定，不将未验证能力记为模型失败。",
    "engine.truthPlan": "拟建立独立审定的 OpenSees 模型及同版本/同设置参考结果；独立三维杆系刚度法；检查三向平衡和顶点受力，固定底边杆零应变作辅助检查。 参考值尚未生成。 所有题定输出均须覆盖，校核实现不复用被测转换链路。"
  },
  "modelStates": [
    "model-state-1.json"
  ],
