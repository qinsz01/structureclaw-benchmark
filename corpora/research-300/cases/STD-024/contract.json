{
  "schemaVersion": 1,
  "evaluationProfile": "engineering-v2.3",
  "id": "STD-024",
  "modelId": "M-STD-024",
  "family": "standard_workflow",
  "language": "英文",
  "locale": "en",
  "plannedEngine": "OpenSees",
  "sourcePlan": {
    "task.inputForm": "完整文字任务 + 随题分析属性表（待编制）",
    "task.scenario": "三跨5、5、5m，D全跨向下8kN/m，W仅中跨向上6kN/m，显式符号约定；完整属性按公共契约随题给出。 定义向上为正Z；C0=D、C1=D+W，滚支为双向约束，允许计算负反力。",
    "task.modelingFocus": "相反方向荷载及组合不能误删为非法",
    "task.expectedOutput": "两个组合的支反力、各跨中位移及中支座弯矩，保留结果符号。",
    "task.gradingFocus": "相反方向荷载及组合不能误删为非法；指定位置/分量对照数值真值，输出文字与结构化结果保持符号、单位和工况一致。",
    "task.prerequisite": "多组合执行契约需验证；完整题面、参数/单位契约与真值待验证",
    "model.topologyKey": "等长三跨连续梁",
    "model.boundaryKey": "左铰其余三支座双向竖向滚支",
    "model.loadKey": "D全跨向下；W中跨向上；两个组合",
    "model.propertyKey": "均匀单材料单截面",
    "engine.analysisContract": "保留题定几何、材料截面、边界和荷载；采用一阶线弹性静力、自重关闭。按明示全局/局部轴、字段单位及工况/组合计算；不新增刚性楼板、未声明刚臂或规范默认组合；结果位置/分量与原题一致。 荷载与观测位置可合理分段，但不改变支承/连续条件；跨内响应须含荷载项。",
    "engine.executionRequirement": "拟要求真实 OpenSees 求解，保存输入与原始结果的对应关系；解析式/独立矩阵解用于校核，不能替代规定引擎执行证据。",
    "engine.requiredEvidence": "拟保存（尚未生成）：OpenSees 版本、可运行模型/脚本、节点构件和荷载表、实际计算日志、原始结果与工况索引、平衡/独立解校核记录。",
    "engine.adapterGap": "向上工况、负反力和双向支座定义以及有符号组合输出须验证。 当前无据认定接口不支持；需实际能力测试后确定，不将未验证能力记为模型失败。",
    "engine.truthPlan": "拟建立独立审定的 OpenSees 模型及同版本/同设置参考结果；按有符号工况线性叠加；静力平衡与反向载荷响应一致性核验。 参考值尚未生成。 所有题定输出均须覆盖，校核实现不复用被测转换链路。"
  },
