{
  "schemaVersion": 1,
  "evaluationProfile": "engineering-v2.3",
  "id": "INT-037",
  "modelId": "M-INT-037",
  "family": "interactive_robustness",
  "language": "中文",
  "locale": "zh",
  "plannedEngine": "OpenSees",
  "sourcePlan": {
    "task.inputForm": "文本2轮＋完整属性附件（仅暂缺项除外）",
    "task.scenario": "T1采用独立模型M-INT-037：节间1/3/4长2/4/3m，第二节间空缺；同时隐藏总跨及第二节间以后累计X坐标；连接/荷载用节点标签，附加X向4kN在第二节间右端上弦U2；T2补第二节间3m并恢复坐标表。",
    "task.modelingFocus": "不等节间坐标累加和载荷对应；荷载分量的独立状态保持",
    "task.expectedOutput": "x=5m上弦的Ux/Uz，左支承反力及附表指定首根下弦/底边杆轴力；所有值附位置、方向、单位、工况及当前轮次；澄清前不编造数值。",
    "task.gradingFocus": "T2累计X=0/2/5/9/12m，U2位于x=5m；各节点荷载及拓扑不变；T1不泄漏可反推长度的总跨/坐标；若其他给定信息已唯一确定长度，允许说明依据直接恢复。",
    "task.prerequisite": "基础工具；逐轮状态与目标/非目标差异评测待实现；缺项输入需检查总跨/累计坐标/荷载位置是否泄漏答案",
    "model.topologyKey": "桁架；节间2、3、4、3m",
    "model.boundaryKey": "左下节点铰，右下节点水平自由竖向滚支",
    "model.loadKey": "节间2、3、4、3m，高2.2m，显式节点表，上弦不等节点荷载；x=5m上弦节点另施加X正向4kN，其余原不等竖向节点力保持；x=2/5/9m上弦分别向下8/12/10kN。",
    "model.propertyKey": "各构件组完整A/Iy/Iz/J/G及E、nu记录；按本题附表逐字段给单位，不用模型默认值",
    "engine.analysisContract": "一阶线弹性静力；自重关闭；不自动施加刚性楼板/刚域、默认附加载或自动规范组合；严格保留题定约束、材料/截面完整属性、局部轴、荷载坐标与长度基准；单位逐字段明确。 各轮只执行明确修改，未被修改的字段保持；澄清内容按该轮生效。",
    "engine.executionRequirement": "计划使用OpenSees完成每个可计算轮次；模型/荷载/材料/约束改变后以当前状态新算；只改查询位置、单位或报告时可复用可追溯结果，若需新网格则重算；缺项未解决时不给虚构数值。",
    "engine.requiredEvidence": "逐轮输入与澄清记录、模型状态快照及前后字段差异；变更目标与未变字段核对；原始求解输入/工程、软件版本/设置、运行ID和成功日志、原始结果到节点/构件/工况的映射；结果绑定当前模型状态。核对目标：x=5m上弦的Ux/Uz，左支承反力及附表指定首根下弦/底边杆轴力。",
    "engine.adapterGap": "未逐题验收；前置检查项：基础工具，并核对局部几何补全后的模型更新和结果定位；不把一般OpenSees支持等同于当前StructureClaw已实现。",
    "engine.truthPlan": "各可计算轮次独立建立并复核OpenSees参考模型，勿复用被测建模/转换路径生成标答；状态改变后独立新算，纯查询沿用有效状态；用解析解（适用时）、整体平衡、刚度/单位/符号检查复核，复杂题再用独立实现或同假设第二求解器核验。"
  },
