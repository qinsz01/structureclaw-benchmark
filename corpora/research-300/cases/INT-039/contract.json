{
  "schemaVersion": 1,
  "evaluationProfile": "engineering-v2.3",
  "id": "INT-039",
  "modelId": "M-INT-039",
  "family": "interactive_robustness",
  "language": "中文",
  "locale": "zh",
  "plannedEngine": "OpenSees",
  "sourcePlan": {
    "task.inputForm": "文本3轮＋完整属性附件（仅暂缺项除外）",
    "task.scenario": "T1所用独立模型为M-INT-039（上弦局部上拔的分组截面桁架）。T1给M-INT-039但A2同时标为上弦和下弦；T2确认上弦A1、下弦A2、腹杆A3；T3仅腹杆改A4。",
    "task.modelingFocus": "构件组属性与拓扑荷载联合映射；荷载工况的独立状态保持",
    "task.expectedOutput": "x=8m上弦的Ux/Uz，左支承反力及附表指定首根下弦/底边杆轴力；所有值附位置、方向、单位、工况及当前轮次；澄清前不编造数值。",
    "task.gradingFocus": "最终三组为A1/A2/A4；荷载与节点不变；完整实物面积记录同步；W只两处向上，截面组修订不影响其归属。",
    "task.prerequisite": "基础工具；多工况执行契约需验证；逐轮状态与目标/非目标差异评测待实现",
    "model.topologyKey": "桁架；跨度20m、高3m、5节间",
    "model.boundaryKey": "左下节点铰，右下节点水平自由竖向滚支",
    "model.loadKey": "跨度20m、高3m、5节间，上下弦和腹杆分别给A1/A2/A3，分节点加载；新增独立W工况，仅上弦x=8、12m各Z正向5kN；原竖载为D，分析组合D+W；D在x=4/8/12/16m上弦各向下10kN。",
    "model.propertyKey": "各构件组完整A/Iy/Iz/J/G及E、nu记录；按本题附表逐字段给单位，不用模型默认值",
    "engine.analysisContract": "一阶线弹性静力；自重关闭；不自动施加刚性楼板/刚域、默认附加载或自动规范组合；严格保留题定约束、材料/截面完整属性、局部轴、荷载坐标与长度基准；单位逐字段明确。 各轮只执行明确修改，未被修改的字段保持；澄清内容按该轮生效。",
    "engine.executionRequirement": "计划使用OpenSees完成每个可计算轮次；模型/荷载/材料/约束改变后以当前状态新算；只改查询位置、单位或报告时可复用可追溯结果，若需新网格则重算；缺项未解决时不给虚构数值。",
    "engine.requiredEvidence": "逐轮输入与澄清记录、模型状态快照及前后字段差异；变更目标与未变字段核对；原始求解输入/工程、软件版本/设置、运行ID和成功日志、原始结果到节点/构件/工况的映射；结果绑定当前模型状态。核对目标：x=8m上弦的Ux/Uz，左支承反力及附表指定首根下弦/底边杆轴力。",
    "engine.adapterGap": "未逐题验收；前置检查项：基础工具；多工况执行契约需验证，并核对分组属性澄清与更新后的模型更新和结果定位；不把一般OpenSees支持等同于当前StructureClaw已实现。",
    "engine.truthPlan": "各可计算轮次独立建立并复核OpenSees参考模型，勿复用被测建模/转换路径生成标答；状态改变后独立新算，纯查询沿用有效状态；用解析解（适用时）、整体平衡、刚度/单位/符号检查复核，复杂题再用独立实现或同假设第二求解器核验。"
  },
