  "sourcePlan": {
    "task.inputForm": "完整文字任务 + 随题分析属性表（待编制）",
    "task.scenario": "两层单跨7m，左右矩形柱强弱轴安排不同，完整惯性矩与局部轴显式提供；完整属性按公共契约随题给出。 两层均3.6m，各梁10kN/m，顶层右节点X向20kN；左右柱局部轴和惯性矩明列。",
    "task.modelingFocus": "矩形尺寸次序与实际弯曲刚度",
    "task.expectedOutput": "左右柱顶X位移、逐列层间位移差、柱端弯矩及柱脚反力。",
    "task.gradingFocus": "矩形尺寸次序与实际弯曲刚度；指定位置/分量对照数值真值，输出文字与结构化结果保持符号、单位和工况一致。",
    "task.prerequisite": "局部轴输入与适配需验证；完整题面、参数/单位契约与真值待验证",
    "model.topologyKey": "平面两层单跨矩形柱混凝土框架",
    "model.boundaryKey": "全部柱脚固定",
    "model.loadKey": "两层梁线载加顶右节点侧力",
    "model.propertyKey": "左右柱局部轴不同；强弱轴惯性矩明确",
    "engine.analysisContract": "保留题定几何、材料截面、边界和荷载；采用一阶线弹性静力、自重关闭。按明示全局/局部轴、字段单位及工况/组合计算；不新增刚性楼板、未声明刚臂或规范默认组合；结果位置/分量与原题一致。",
    "engine.executionRequirement": "拟要求真实 OpenSees 求解，保存输入与原始结果的对应关系；解析式/独立矩阵解用于校核，不能替代规定引擎执行证据。",
    "engine.requiredEvidence": "拟保存（尚未生成）：OpenSees 版本、可运行模型/脚本、节点构件和荷载表、实际计算日志、原始结果与工况索引、平衡/独立解校核记录。",
    "engine.adapterGap": "矩形柱局部轴与强弱惯性矩输入/转换须验证。 当前无据认定接口不支持；需实际能力测试后确定，不将未验证能力记为模型失败。",
    "engine.truthPlan": "拟建立独立审定的 OpenSees 模型及同版本/同设置参考结果；独立局部到全局刚度变换；将截面转90°的映射关系作辅助校验。 参考值尚未生成。 所有题定输出均须覆盖，校核实现不复用被测转换链路。"
