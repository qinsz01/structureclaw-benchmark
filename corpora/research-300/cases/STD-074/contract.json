  "turns": [
    {
      "id": "t1",
      "instruction": "Required solver: OpenSees.\nBuild a two-story, single-bay planar concrete frame: span 7 m, story heights 3.6 m and 3.6 m, both bases fixed. Each beam carries 10 kN/m downward and the top-right node n1-2 carries 20 kN in global +X, all in case D. The explicit appendix supplies C30 (E=30000 MPa, nu=0.2, G=12500 MPa, density=2500 kg/m^3), 300x600 mm beams and identical 350x500 mm rectangular columns CR. The left columns have roll 0 degrees; the right columns have roll 90 degrees. Use column-orientations.txt to preserve the different strong/weak bending directions and exact local axes. Run first-order linear elastic Euler-Bernoulli analysis in OpenSees, self weight off. Report ux at both column tops on each story, the four signed ux(upper)-ux(lower) story displacement differences, local M2 and M3 at both ends of all four columns, and Fx/Fz/My at both bases.\n\nUse all public appendices. Report the complete requested numerical table and the required summaries.",
      "state": 1,
      "expectation": "analyze",
      "attachments": [
        "input-data.json",
        "output-requests.json",
        "analysis-conventions.txt",
        "column-orientations.txt"
      ],
