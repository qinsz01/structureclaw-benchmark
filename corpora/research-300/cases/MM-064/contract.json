  "id": "MM-064",
  "modelId": "M-MM-064",
  "family": "multimodal_reverse_engineering",
  "language": "英文",
  "locale": "en",
  "plannedEngine": "OpenSees",
  "sourcePlan": {
    "sourceRequirements": {
      "task.inputForm": "新结构DXF的实体、尺寸及连接符号给本题几何/拓扑/支座；荷载标注或区域标签关联载荷表；完整属性另附，源单位与坐标映射显式给定。所有新附件待制作、盲审与验证。",
      "task.scenario": "几何：两层单跨6m、层高3.6m；第一层梁向右外伸1.5m，第二层梁向左外伸2m；边界：两柱脚固定、梁柱及悬段刚接；荷载：主跨梁均向下10kN/m，下层右悬段6、上层左悬段12kN/m；属性：M1、柱C1、主梁B1、悬段B2。（本栏是编题规格，实际用户输入按图/表分工呈现。）",
      "task.modelingFocus": "上下楼层的悬挑方向相反，不能把第一层复制到第二层。",
      "task.expectedOutput": "两个悬挑自由端Uz、上层左根部弯矩；附与数值一致的模型/结果图。",
      "task.gradingFocus": "模型核对：原同侧双层外挑改为上下层交错方向外挑。；数值/表述核对：两个悬挑自由端Uz、上层左根部弯矩，位置、方向、单位须一致。",
      "task.prerequisite": "基础工具；本题新增几何/属性与真值均待独立核验；材料截面代号须在本题附录定值。",
      "model.topologyKey": "两层单跨6m、层高3.6m；第一层梁向右外伸1.5m，第二层梁向左外伸2m",
      "model.boundaryKey": "两柱脚固定、梁柱及悬段刚接",
      "model.loadKey": "主跨梁均向下10kN/m，下层右悬段6、上层左悬段12kN/m",
      "model.propertyKey": "M1、柱C1、主梁B1、悬段B2。",
      "engine.analysisContract": "一阶线弹性；自重OFF并保存配置；按附录实际E/A/I/J，不套默认刚度折减；无默认刚性楼板。全局Z向上，核对XZ到求解器平面的映射及Ry符号。题给线载/点力/力矩按原位映射；如作等效节点加载，须保留原始分布荷载并采用与单元插值一致的等效荷载，核验跨内响应及合力/力矩，不用统一楼面载替代。荷载契约：主跨梁均向下10kN/m，下层右悬段6、上层左悬段12kN/m；未指定组合时仅算题定基本荷载，指定组合逐组执行，不能用软件默认包络替换。",
      "engine.executionRequirement": "上下层外挑方向相反，加载与截面按实际悬段位置而非复制层处理；执行后按原题完整输出：两个悬挑自由端Uz、上层左根部弯矩；附与数值一致的模型/结果图。本轮仅规划，不运行。",
      "engine.requiredEvidence": "计划保存输入PNG/DXF及图中构件/标签→计算节点/构件ID映射、可复现OpenSees输入模型、引擎版本与设置快照、实际运行日志、原始结果表/观测点索引、可视图所用数据。",
      "engine.adapterGap": "尚未确认本题可通过；接口/求解/读回预检重点：上下层外挑方向相反，加载与截面按实际悬段位置而非复制层处理。特殊单元、轴向、边界及组合均不因OpenSees原生支持而视作已接通。",
      "engine.truthPlan": "独立建立并复核OpenSees参考模型，固定版本/求解设置及观测位置；以独立模型审阅、整体平衡及构件端力/节点结果一致性校核。不把展示层插值或图像读数直接当数值真值。"
    },
