{
  "schemaVersion": 1,
  "evaluationProfile": "engineering-v2.3",
  "id": "INT-022",
  "modelId": "M-INT-022",
  "family": "interactive_robustness",
  "language": "英文",
  "locale": "en",
  "plannedEngine": "OpenSees",
  "sourcePlan": {
    "task.inputForm": "文本2轮＋完整属性附件（仅暂缺项除外）",
    "task.scenario": "T1所用独立模型为M-INT-022（仅外伸段加载的连续梁）。T1建立M-INT-022；T2将右外伸长度2m改3m，10kN仍作用于新自由端。",
    "task.modelingFocus": "连续跨、外伸段与端力同时定位；荷载分布的独立状态保持",
    "task.expectedOutput": "当前自由端Uz（初始x=12，更新后13m）及x=10m支座Rz；所有值附位置、方向、单位、工况及当前轮次；澄清前不编造数值。",
    "task.gradingFocus": "支座0、5、10m不变；端点到13m、端力跟随；8kN/m仅新外伸段延至新端；外伸变长后8kN/m只沿新外伸段作用，支承跨保持无均布载。",
    "task.prerequisite": "基础工具；逐轮状态与目标/非目标差异评测待实现",
    "model.topologyKey": "连续梁；支座x=0、5、10m",
    "model.boundaryKey": "x=0铰、x=5/10m滚支、初始自由端x=12m",
    "model.loadKey": "支座x=0、5、10m，梁到x=12m，仅外伸段8kN/m，外伸端10kN；均布载8kN/m仅作用x=10m至自由端，两支承跨无均布载；自由端10kN保留",
    "model.propertyKey": "各构件组完整A/Iy/Iz/J/G及E、nu记录；按本题附表逐字段给单位，不用模型默认值",
    "engine.analysisContract": "一阶线弹性静力；自重关闭；不自动施加刚性楼板/刚域、默认附加载或自动规范组合；严格保留题定约束、材料/截面完整属性、局部轴、荷载坐标与长度基准；单位逐字段明确。 各轮只执行明确修改，未被修改的字段保持；澄清内容按该轮生效。",
    "engine.executionRequirement": "计划使用OpenSees完成每个可计算轮次；模型/荷载/材料/约束改变后以当前状态新算；只改查询位置、单位或报告时可复用可追溯结果，若需新网格则重算；缺项未解决时不给虚构数值。",
    "engine.requiredEvidence": "逐轮输入与澄清记录、模型状态快照及前后字段差异；变更目标与未变字段核对；原始求解输入/工程、软件版本/设置、运行ID和成功日志、原始结果到节点/构件/工况的映射；结果绑定当前模型状态。核对目标：当前自由端Uz（初始x=12，更新后13m）及x=10m支座Rz。",
    "engine.adapterGap": "未逐题验收；前置检查项：基础工具，并核对几何与端载联动后的模型更新和结果定位；不把一般OpenSees支持等同于当前StructureClaw已实现。",
    "engine.truthPlan": "各可计算轮次独立建立并复核OpenSees参考模型，勿复用被测建模/转换路径生成标答；状态改变后独立新算，纯查询沿用有效状态；用解析解（适用时）、整体平衡、刚度/单位/符号检查复核，复杂题再用独立实现或同假设第二求解器核验。"
  },
