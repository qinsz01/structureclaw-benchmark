  "sourcePlan": {
    "task.inputForm": "完整文字任务 + 随题分析属性表（待编制）",
    "task.scenario": "跨度24m、高12m，屋面36kN/m，右柱顶向下98kN及X向10kN；完整属性按公共契约随题给出。 屋面36kN/m已经折算；吊车在右柱顶施加两分量，原1.5kN/m²只作来源说明。",
    "task.modelingFocus": "吊车等效荷载方向与屋面分项",
    "task.expectedOutput": "左右柱顶位移、屋面跨中位移、柱脚反力及右柱端弯矩。",
    "task.gradingFocus": "吊车等效荷载方向与屋面分项；指定位置/分量对照数值真值，输出文字与结构化结果保持符号、单位和工况一致。",
    "task.prerequisite": "基础工具；完整题面、参数/单位契约与真值待验证",
    "model.topologyKey": "平面单层单跨重型厂房框架",
    "model.boundaryKey": "全部柱脚固定",
    "model.loadKey": "屋面折算线载加右柱顶竖向/水平设备力",
    "model.propertyKey": "单钢材料；梁柱分组截面",
    "engine.analysisContract": "保留题定几何、材料截面、边界和荷载；采用一阶线弹性静力、自重关闭。按明示全局/局部轴、字段单位及工况/组合计算；不新增刚性楼板、未声明刚臂或规范默认组合；结果位置/分量与原题一致。",
    "engine.executionRequirement": "拟要求真实 OpenSees 求解，保存输入与原始结果的对应关系；解析式/独立矩阵解用于校核，不能替代规定引擎执行证据。",
    "engine.requiredEvidence": "拟保存（尚未生成）：OpenSees 版本、可运行模型/脚本、节点构件和荷载表、实际计算日志、原始结果与工况索引、平衡/独立解校核记录。",
    "engine.adapterGap": "屋面线载与吊车集中力分别入模，不得重复施加来源面载。 当前无据认定接口不支持；需实际能力测试后确定，不将未验证能力记为模型失败。",
    "engine.truthPlan": "拟建立独立审定的 OpenSees 模型及同版本/同设置参考结果；独立框架解；按36kN/m及98/10kN分别复核合力和总力矩。 参考值尚未生成。 所有题定输出均须覆盖，校核实现不复用被测转换链路。"
  },
