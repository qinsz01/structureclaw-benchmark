{
  "schemaVersion": 1,
  "evaluationProfile": "engineering-v2.3",
  "id": "INT-011",
  "modelId": "M-INT-011",
  "family": "interactive_robustness",
  "language": "中文",
  "locale": "zh",
  "plannedEngine": "OpenSees",
  "sourcePlan": {
    "task.inputForm": "文本2轮＋完整属性附件（仅暂缺项除外）",
    "task.scenario": "T1所用独立模型为M-INT-011（端部加粗的撑杆梁）。T1给M-INT-011但右端只写有支承；T2确认仅约束竖向、水平与转角释放。",
    "task.modelingFocus": "固支加滚支不能误作普通简支；截面分组的独立状态保持",
    "task.expectedOutput": "x=3.5m的Uz与右支座Rz；所有值附位置、方向、单位、工况及当前轮次；澄清前不编造数值。",
    "task.gradingFocus": "追问右支承约束而不改左固支；最终仍为超静定梁；点力位置x=5m不变；5～7m端部加强段不变。",
    "task.prerequisite": "基础工具；逐轮状态与目标/非目标差异评测待实现",
    "model.topologyKey": "梁；跨度7m",
    "model.boundaryKey": "x=0固定、x=7m竖向滚支",
    "model.loadKey": "跨度7m，左固支右竖向滚支，全跨10kN/m，x=5m处20kN",
    "model.propertyKey": "0～5m用B1、5～7m用B2；B2面积及两弯曲惯性矩均为B1的1.8倍",
    "engine.analysisContract": "一阶线弹性静力；自重关闭；不自动施加刚性楼板/刚域、默认附加载或自动规范组合；严格保留题定约束、材料/截面完整属性、局部轴、荷载坐标与长度基准；单位逐字段明确。 各轮只执行明确修改，未被修改的字段保持；澄清内容按该轮生效。",
    "engine.executionRequirement": "计划使用OpenSees完成每个可计算轮次；模型/荷载/材料/约束改变后以当前状态新算；只改查询位置、单位或报告时可复用可追溯结果，若需新网格则重算；缺项未解决时不给虚构数值。",
    "engine.requiredEvidence": "逐轮输入与澄清记录、模型状态快照及前后字段差异；变更目标与未变字段核对；原始求解输入/工程、软件版本/设置、运行ID和成功日志、原始结果到节点/构件/工况的映射；结果绑定当前模型状态。核对目标：x=3.5m的Uz与右支座Rz。",
    "engine.adapterGap": "未逐题验收；前置检查项：基础工具，并核对边界澄清后的模型更新和结果定位；不把一般OpenSees支持等同于当前StructureClaw已实现。",
    "engine.truthPlan": "各可计算轮次独立建立并复核OpenSees参考模型，勿复用被测建模/转换路径生成标答；状态改变后独立新算，纯查询沿用有效状态；用解析解（适用时）、整体平衡、刚度/单位/符号检查复核，复杂题再用独立实现或同假设第二求解器核验。"
  },
