{
  "schemaVersion": 1,
  "evaluationProfile": "engineering-v2.3",
  "id": "INT-017",
  "modelId": "M-INT-017",
  "family": "interactive_robustness",
  "language": "中文",
  "locale": "zh",
  "plannedEngine": "OpenSees",
  "sourcePlan": {
    "task.inputForm": "文本2轮＋完整属性附件（仅暂缺项除外）",
    "task.scenario": "T1所用独立模型为M-INT-017（首跨无载的三跨连续梁）。T1给M-INT-017但第三跨数值录入为-4m；T2确认录入笔误，第三跨为4m。",
    "task.modelingFocus": "三跨连通和四支座约束；荷载分布的独立状态保持",
    "task.expectedOutput": "中跨中点x=6.5m的Uz及x=4m支座Rz；所有值附位置、方向、单位、工况及当前轮次；澄清前不编造数值。",
    "task.gradingFocus": "首轮指出第三跨问题；不先分析；最终0、4、9、13m四支座，15kN/m仅中末两跨；首跨保持无均布载，后两跨15kN/m。",
    "task.prerequisite": "基础工具；逐轮状态与目标/非目标差异评测待实现",
    "model.topologyKey": "连续梁；支座x=0、4、9、13m",
    "model.boundaryKey": "x=0铰、x=4/9/13m滚支",
    "model.loadKey": "支座x=0、4、9、13m，中跨及末跨15kN/m、首跨无均布载，左铰其余滚支；15kN/m仅施加中跨和末跨，首跨0～4m不施加均布载",
    "model.propertyKey": "各构件组完整A/Iy/Iz/J/G及E、nu记录；按本题附表逐字段给单位，不用模型默认值",
    "engine.analysisContract": "一阶线弹性静力；自重关闭；不自动施加刚性楼板/刚域、默认附加载或自动规范组合；严格保留题定约束、材料/截面完整属性、局部轴、荷载坐标与长度基准；单位逐字段明确。 各轮只执行明确修改，未被修改的字段保持；澄清内容按该轮生效。",
    "engine.executionRequirement": "计划使用OpenSees完成每个可计算轮次；模型/荷载/材料/约束改变后以当前状态新算；只改查询位置、单位或报告时可复用可追溯结果，若需新网格则重算；缺项未解决时不给虚构数值。",
    "engine.requiredEvidence": "逐轮输入与澄清记录、模型状态快照及前后字段差异；变更目标与未变字段核对；原始求解输入/工程、软件版本/设置、运行ID和成功日志、原始结果到节点/构件/工况的映射；结果绑定当前模型状态。核对目标：中跨中点x=6.5m的Uz及x=4m支座Rz。",
    "engine.adapterGap": "未逐题验收；前置检查项：基础工具，并核对无效值修正后完成后的模型更新和结果定位；不把一般OpenSees支持等同于当前StructureClaw已实现。",
    "engine.truthPlan": "各可计算轮次独立建立并复核OpenSees参考模型，勿复用被测建模/转换路径生成标答；状态改变后独立新算，纯查询沿用有效状态；用解析解（适用时）、整体平衡、刚度/单位/符号检查复核，复杂题再用独立实现或同假设第二求解器核验。"
  },
