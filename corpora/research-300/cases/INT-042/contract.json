{
  "schemaVersion": 1,
  "evaluationProfile": "engineering-v2.3",
  "id": "INT-042",
  "modelId": "M-INT-042",
  "family": "interactive_robustness",
  "language": "英文",
  "locale": "en",
  "plannedEngine": "OpenSees",
  "sourcePlan": {
    "task.inputForm": "文本3轮＋完整属性附件（仅暂缺项除外）",
    "task.scenario": "T1所用独立模型为M-INT-042（分层弦杆不同面积的空间三角柱）。T1建立M-INT-042；T2按拟提供且编题前须核验的连接表B替换顶层两根斜杆；T3撤销此项替换恢复表A。",
    "task.modelingFocus": "跨层空间连接与杆件组；截面分组的独立状态保持",
    "task.expectedOutput": "顶层(0,0,6)m节点的Ux/Uz/Uy，左支承反力及附表指定首根下弦/底边杆轴力；所有值附位置、方向、单位、工况及当前轮次；澄清前不编造数值。",
    "task.gradingFocus": "每轮仅指定斜杆变化；最终杆件集合回到M-INT-042；侧载层位与所有弦杆不变；下层竖弦加强不随上层斜杆替换或撤销改变。",
    "task.prerequisite": "空间桁架及独立真值需验证；逐轮状态与目标/非目标差异评测待实现",
    "model.topologyKey": "桁架；底面三角形边长4m",
    "model.boundaryKey": "三底点XYZ固定，其他节点自由",
    "model.loadKey": "底面三角形边长4m，两层各3m，弦杆横杆斜杆按表连接，底节点固定，顶层侧力；顶层三节点各X正向10kN，底层三点三平移约束。",
    "model.propertyKey": "三角形底点(0,0)/(4,0)/(2,2√3)m，各层z=0、3、6m；0～3m竖弦杆2A，上层竖弦杆A，横杆斜杆A",
    "engine.analysisContract": "一阶线弹性静力；自重关闭；不自动施加刚性楼板/刚域、默认附加载或自动规范组合；严格保留题定约束、材料/截面完整属性、局部轴、荷载坐标与长度基准；单位逐字段明确。 保留三维六自由度/轴力单元各自约束和题定局部轴；各轮只执行明确修改，未被修改的字段保持；澄清内容按该轮生效。",
    "engine.executionRequirement": "计划使用OpenSees完成每个可计算轮次；模型/荷载/材料/约束改变后以当前状态新算；只改查询位置、单位或报告时可复用可追溯结果，若需新网格则重算；缺项未解决时不给虚构数值。",
    "engine.requiredEvidence": "逐轮输入与澄清记录、模型状态快照及前后字段差异；变更目标与未变字段核对；原始求解输入/工程、软件版本/设置、运行ID和成功日志、原始结果到节点/构件/工况的映射；结果绑定当前模型状态。核对目标：顶层(0,0,6)m节点的Ux/Uz/Uy，左支承反力及附表指定首根下弦/底边杆轴力。",
    "engine.adapterGap": "未逐题验收；前置检查项：空间桁架及独立真值需验证，并核对空间拓扑修改与撤销后的模型更新和结果定位；不把一般OpenSees支持等同于当前StructureClaw已实现。",
    "engine.truthPlan": "各可计算轮次独立建立并复核OpenSees参考模型，勿复用被测建模/转换路径生成标答；状态改变后独立新算，纯查询沿用有效状态；用解析解（适用时）、整体平衡、刚度/单位/符号检查复核，复杂题再用独立实现或同假设第二求解器核验。"
  },
