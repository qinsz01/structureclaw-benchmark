  "sourcePlan": {
    "task.inputForm": "完整文字任务 + 随题分析属性表（待编制）",
    "task.scenario": "三层各3.3m、单跨6m，柱500×500、梁300×600mm，梁线载60kN/m；完整属性按公共契约随题给出。 各梁60kN/m，柱500×500和梁300×600mm按不同截面组；不进行配筋或承载力推断。",
    "task.modelingFocus": "层数与面载折算只施加一次",
    "task.expectedOutput": "三层左右节点位移、逐柱列层间位移差及柱脚反力/弯矩。",
    "task.gradingFocus": "层数与面载折算只施加一次；指定位置/分量对照数值真值，输出文字与结构化结果保持符号、单位和工况一致。",
    "task.prerequisite": "基础工具；完整题面、参数/单位契约与真值待验证",
    "model.topologyKey": "平面三层单跨混凝土框架",
    "model.boundaryKey": "全部柱脚固定",
    "model.loadKey": "三层同值梁线载；面载已折算",
    "model.propertyKey": "C35材料；混凝土梁柱分组截面",
    "engine.analysisContract": "保留题定几何、材料截面、边界和荷载；采用一阶线弹性静力、自重关闭。按明示全局/局部轴、字段单位及工况/组合计算；不新增刚性楼板、未声明刚臂或规范默认组合；结果位置/分量与原题一致。",
    "engine.executionRequirement": "拟要求真实 OpenSees 求解，保存输入与原始结果的对应关系；解析式/独立矩阵解用于校核，不能替代规定引擎执行证据。",
    "engine.requiredEvidence": "拟保存（尚未生成）：OpenSees 版本、可运行模型/脚本、节点构件和荷载表、实际计算日志、原始结果与工况索引、平衡/独立解校核记录。",
    "engine.adapterGap": "逐题核验层数与面载折算只施加一次；输入、结果分量/位置及数值标答尚未完成验收。 当前无据认定接口不支持；需实际能力测试后确定，不将未验证能力记为模型失败。",
    "engine.truthPlan": "拟建立独立审定的 OpenSees 模型及同版本/同设置参考结果；独立线弹性框架矩阵解；逐层位移与整体反力平衡核对。 参考值尚未生成。 所有题定输出均须覆盖，校核实现不复用被测转换链路。"
  },
