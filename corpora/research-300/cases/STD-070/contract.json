  "turns": [
    {
      "id": "t1",
      "instruction": "Required solver: OpenSees.\nAnalyze the attached three-story, single-bay C35 concrete frame in OpenSees. The span is 6 m and all three story heights are 3.3 m, giving floor elevations 3.3, 6.6 and 9.9 m. Both bases are fixed. Columns are 500x500 mm and beams are 300x600 mm. In case D, apply the already-converted downward line load of 60 kN/m once to each of the three beams. Report ux/uz/ry at all six floor joints, Δux/Δuz as upper-minus-lower displacement differences separately along each column line on each story, and Fx/Fz/My at both bases. Use the appendix elastic properties and axes, first-order linear elastic static analysis, and self-weight disabled. Do not infer reinforcement or load-carrying capacity.\n\nUse all public appendices. Report the complete requested numerical table and the required summaries.",
      "state": 1,
      "expectation": "analyze",
      "attachments": [
        "input-data.json",
        "output-requests.json",
        "analysis-conventions.txt",
        "output-scope.json",
        "appendix-decisions.txt"
      ],
      "unresolvedFields": [],
      "expectedQuestions": []
    }
  ],
