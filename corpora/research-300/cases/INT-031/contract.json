{
  "schemaVersion": 1,
  "evaluationProfile": "engineering-v2.3",
  "id": "INT-031",
  "modelId": "M-INT-031",
  "family": "interactive_robustness",
  "language": "中文",
  "locale": "zh",
  "plannedEngine": "OpenSees",
  "sourcePlan": {
    "task.inputForm": "文本2轮＋完整属性附件（仅暂缺项除外）",
    "task.scenario": "T1所用独立模型为M-INT-031（首末节间腹杆加强的平行弦屋架）。T1建立M-INT-031；T2将x=3、6、9、12m四个上弦节点力移到同x下弦节点，幅值不变，x=15m上弦力不动。",
    "task.modelingFocus": "上弦荷载及竖杆完整性；截面分组的独立状态保持",
    "task.expectedOutput": "x=9m上弦的Ux/Uz，左支承反力及附表指定首根下弦/底边杆轴力；所有值附位置、方向、单位、工况及当前轮次；澄清前不编造数值。",
    "task.gradingFocus": "四对同x节点正确迁移；移出节点力清零，x=15m原上弦力保持；不增加总力；拓扑与截面不变；两端节间腹杆加强保持；上弦载迁移不改变属性。",
    "task.prerequisite": "基础工具；逐轮状态与目标/非目标差异评测待实现",
    "model.topologyKey": "桁架；跨度18m、高3m、6节间",
    "model.boundaryKey": "左下节点铰，右下节点水平自由竖向滚支",
    "model.loadKey": "跨度18m、高3m、6节间，交替腹杆，上弦内部节点各12kN",
    "model.propertyKey": "首节间0～3m及末节间15～18m腹杆面积为中间腹杆的两倍，弦杆不变",
    "engine.analysisContract": "一阶线弹性静力；自重关闭；不自动施加刚性楼板/刚域、默认附加载或自动规范组合；严格保留题定约束、材料/截面完整属性、局部轴、荷载坐标与长度基准；单位逐字段明确。 各轮只执行明确修改，未被修改的字段保持；澄清内容按该轮生效。",
    "engine.executionRequirement": "计划使用OpenSees完成每个可计算轮次；模型/荷载/材料/约束改变后以当前状态新算；只改查询位置、单位或报告时可复用可追溯结果，若需新网格则重算；缺项未解决时不给虚构数值。",
    "engine.requiredEvidence": "逐轮输入与澄清记录、模型状态快照及前后字段差异；变更目标与未变字段核对；原始求解输入/工程、软件版本/设置、运行ID和成功日志、原始结果到节点/构件/工况的映射；结果绑定当前模型状态。核对目标：x=9m上弦的Ux/Uz，左支承反力及附表指定首根下弦/底边杆轴力。",
    "engine.adapterGap": "未逐题验收；前置检查项：基础工具，并核对荷载位置更新后的模型更新和结果定位；不把一般OpenSees支持等同于当前StructureClaw已实现。",
    "engine.truthPlan": "各可计算轮次独立建立并复核OpenSees参考模型，勿复用被测建模/转换路径生成标答；状态改变后独立新算，纯查询沿用有效状态；用解析解（适用时）、整体平衡、刚度/单位/符号检查复核，复杂题再用独立实现或同假设第二求解器核验。"
  },
