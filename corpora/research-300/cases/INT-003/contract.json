{
  "schemaVersion": 1,
  "evaluationProfile": "engineering-v2.3",
  "id": "INT-003",
  "modelId": "M-INT-003",
  "family": "interactive_robustness",
  "language": "中文",
  "locale": "zh",
  "plannedEngine": "OpenSees",
  "sourcePlan": {
    "task.inputForm": "文本2轮＋完整属性附件（仅暂缺项除外）",
    "task.scenario": "T1所用独立模型为M-INT-003（外伸段较柔的双截面梁）。T1建立M-INT-003并取x=3.25m和6.5m位移；T2将第一个观测点改为支承跨中x=2.5m，外伸端不变。",
    "task.modelingFocus": "全长中点与支承跨中不同；截面分组的独立状态保持",
    "task.expectedOutput": "按轮次x=3.25或2.5m及外伸端x=6.5m的Uz；所有值附位置、方向、单位、工况及当前轮次；澄清前不编造数值。",
    "task.gradingFocus": "不改结构荷载；x=2.5m与3.25m不得混用；需要加分析节点时保持连接；截面分界仍在x=5m，外伸段B2不变。",
    "task.prerequisite": "基础工具；逐轮状态与目标/非目标差异评测待实现",
    "model.topologyKey": "梁；支座x=0、5m",
    "model.boundaryKey": "x=0铰、x=5m滚支、右自由端x=6.5m",
    "model.loadKey": "支座x=0、5m，右端x=6.5m，全长向下15kN/m，观测x=3.25m和外伸端",
    "model.propertyKey": "0～5m用B1，5～6.5m外伸段用B2，B2的E/A不变、Iy和Iz均为B1的一半",
    "engine.analysisContract": "一阶线弹性静力；自重关闭；不自动施加刚性楼板/刚域、默认附加载或自动规范组合；严格保留题定约束、材料/截面完整属性、局部轴、荷载坐标与长度基准；单位逐字段明确。 各轮只执行明确修改，未被修改的字段保持；澄清内容按该轮生效。",
    "engine.executionRequirement": "计划使用OpenSees完成每个可计算轮次；模型/荷载/材料/约束改变后以当前状态新算；只改查询位置、单位或报告时可复用可追溯结果，若需新网格则重算；缺项未解决时不给虚构数值。",
    "engine.requiredEvidence": "逐轮输入与澄清记录、模型状态快照及前后字段差异；变更目标与未变字段核对；原始求解输入/工程、软件版本/设置、运行ID和成功日志、原始结果到节点/构件/工况的映射；结果绑定当前模型状态。核对目标：按轮次x=3.25或2.5m及外伸端x=6.5m的Uz。",
    "engine.adapterGap": "未逐题验收；前置检查项：基础工具，并核对结果定位修订后的模型更新和结果定位；不把一般OpenSees支持等同于当前StructureClaw已实现。",
    "engine.truthPlan": "各可计算轮次独立建立并复核OpenSees参考模型，勿复用被测建模/转换路径生成标答；状态改变后独立新算，纯查询沿用有效状态；用解析解（适用时）、整体平衡、刚度/单位/符号检查复核，复杂题再用独立实现或同假设第二求解器核验。"
  },
