{
  "id": "image-with-report",
  "description": "上传图片+分析+生成报告",
  "split": "auxiliary",
  "taskFamily": "multimodal_reverse_engineering",
  "inputModality": "image",
  "structureType": "beam",
  "benchmarkStructureType": "beam",
  "difficulty": "L2",
  "skillTarget": "beam",
  "evaluationFocus": [
    "routing",
    "modeling",
    "model_match",
    "analysis",
    "report",
    "semantic",
    "numerical_match"
  ],
  "category": "multimodal",
  "tags": [
    "multimodal",
    "beam",
    "image",
    "report",
    "zh"
  ],
  "message": "请根据附图及工程说明建立计算模型并进行静力分析。无法可靠识别的图片信息请明确询问，不要自行假设。 请基于完成的分析生成计算报告。",
  "locale": "zh",
  "maxRetries": 0,
  "attachments": [
    {
      "fileId": "bench-beam-report",
      "originalName": "drawing-008.png",
      "relPath": "fixtures/beam-sketch.png",
      "mimeType": "image/png"
    }
  ],
  "expect": {
    "skills": {
      "primary": "beam",
      "mayAlsoMatch": [
        "generic"
      ]
    },
    "assertions": [
      {
        "type": "structural_type",
        "expected": "beam"
      },
      {
        "type": "skill_match",
        "primary": "beam",
        "mayAlsoMatch": [
          "generic"
        ]
      },
      {
        "type": "has_model",
        "minNodes": 2,
        "minElements": 1
      },
      {
        "type": "model_matches",
        "groundTruthId": "beam-simple-6m",
        "tolerances": {
          "load": 0.05,
          "coordinate": 0.05
        }
      },
      {
        "type": "numerical_matches",
        "groundTruthId": "beam-simple-6m",
        "tolerances": {
          "load": 0.05,
          "coordinate": 0.05,
          "numeric": 0.01,
          "numericAbsolute": 1e-8
        }
      },
      {
        "type": "has_analysis"
      },
      {
        "type": "has_report"
      },
      {
        "type": "report_numerical_consistency"
      },
      {
        "type": "natural_language",
        "description": "报告Markdown必须忠实反映当前模型、荷载和分析工件，明确给出所要求的跨中竖向挠度，不得包含与当前工件不一致的数值或工程结论，也不得声称未经证据支持的结构安全或规范符合性。"
      }
    ]
  },
  "engineeringSpecification": "材料 steel：E=205000 MPa，ν=0.3，密度=7850 kg/m3。全部构件采用 B1（A=0.01 m2，Iy=0.0001 m4，Iz=0.0001 m4，J=0.0001 m4，G=79000 MPa）。采用SI单位和全局Z轴向上的坐标约定。仅使用图中标注的荷载工况与荷载值，不附加构件自重。分析荷载组合：ULS = 1 × LC1。请在跨中设置与两侧梁单元连接的分析节点，并在报告中给出跨中竖向挠度。",
  "inputContract": {
    "imageProvides": [
      "topology",
      "dimensions",
      "supports",
      "loads"
    ],
    "specificationProvides": [
      "materials",
      "sections",
      "analysis-settings"
    ],
    "completeness": "complete"
  }
}
