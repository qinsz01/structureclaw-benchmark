    {
      "message": "Use the engineering specification provided with this turn to build the calculation model and run static analysis.",
      "assertions": [
        {
          "type": "has_model",
          "minNodes": 3,
          "minElements": 3
        },
        {
          "type": "model_matches",
          "groundTruthId": "truss-triangle-12m-3m-20k",
          "tolerances": {
            "load": 0.05,
            "coordinate": 0.05
          }
        },
        {
          "type": "numerical_matches",
          "groundTruthId": "truss-triangle-12m-3m-20k",
          "tolerances": {
            "load": 0.05,
            "coordinate": 0.05,
            "numeric": 0.01,
            "numericAbsolute": 1e-8
          }
        },
        {
          "type": "has_analysis"
        }
      ],
      "engineeringSpecification": "Material steel: E=205000 MPa, nu=0.3, density=7850 kg/m3. All members use section T1 (A=0.01 m2). Use SI units and the global-z-up coordinate convention. Use only the load cases and load magnitudes annotated in the drawing; do not add member self-weight. Analyze load combination ULS = 1 x LC1."
    }
  ],
  "inputContract": {
    "imageProvides": [
