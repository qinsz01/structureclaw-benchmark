  "evaluationFocus": [
    "routing",
    "modeling",
    "model_match",
    "analysis",
    "report",
    "semantic",
    "numerical_match"
  ],
  "category": "static-analysis",
  "tags": [
    "beam",
    "static",
    "zh",
    "report"
  ],
  "message": "简支梁跨度8m，全跨施加竖向向下均布荷载18kN/m。请在跨中设置与两侧梁单元连接的分析节点，输出跨中竖向挠度，并进行静力分析和生成计算报告。",
  "locale": "zh",
  "maxRetries": 0,
  "expect": {
    "skills": {
      "primary": "beam",
      "mayAlsoMatch": [
        "generic"
      ]
    },
    "assertions": [
      {
        "type": "structural_type",
        "expected": "beam"
      },
      {
        "type": "skill_match",
        "primary": "beam",
        "mayAlsoMatch": [
          "generic"
        ]
      },
      {
        "type": "has_model",
        "minNodes": 2,
        "minElements": 1
      },
      {
        "type": "model_matches",
        "groundTruthId": "beam-simple-8m-udl18",
        "tolerances": {
          "load": 0.05,
          "coordinate": 0.05
        }
      },
      {
        "type": "numerical_matches",
        "groundTruthId": "beam-simple-8m-udl18",
        "tolerances": {
          "load": 0.05,
          "coordinate": 0.05,
          "numeric": 0.01,
          "numericAbsolute": 1e-8
        }
      },
      {
        "type": "has_analysis"
      },
      {
        "type": "has_report"
      },
      {
        "type": "report_numerical_consistency"
      },
      {
        "type": "natural_language",
        "description": "报告Markdown必须忠实反映当前模型、荷载和分析工件，明确给出所要求的跨中竖向挠度，不得包含与当前工件不一致的数值或工程结论，也不得声称未经证据支持的结构安全或规范符合性。"
      }
    ]
  },
  "engineeringSpecification": "所有模式均须严格使用以下完整分析属性；这些记录不是占位符，无需要求补充。结构分类只使用用户任务，参数提取须同时包含这些属性。不得显式创建构件自重荷载或重复施加折算荷载；分析后端可按自身配置在内部计入构件自重。几何、拓扑、支座和荷载位置仍由用户任务确定。\n单位制: SI\n坐标系: semantics=global-z-up, version=1, dimension=2d, plane=xz, dof_order=ux,uy,uz,rx,ry,rz\n材料: id=1, name=steel, E=205000, nu=0.3, rho=7850\n截面: id=1, name=B1, type=beam, properties(A=0.01, Iy=0.0001, Iz=0.0001, J=0.0001, G=79000)\n分析荷载组合: id=ULS, factors={LC1=1}"
}
